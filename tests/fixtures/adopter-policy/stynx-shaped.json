{
  "schemaVersion": "1.0.0",
  "policy_id": "stynx-operational-adoption",
  "policy_version": "1.0.0",
  "project": {
    "project_type": "platform-package",
    "repo": { "kind": "library" },
    "docs": {
      "builder": "docusaurus",
      "build_command": "pnpm --dir docs/site build"
    }
  },
  "domains": {
    "client": ["COVERAGE", "ERROR", "FLOW", "PRIVACY", "RBAC"]
  },
  "thresholds": {
    "coverage": { "lines": 80 },
    "freshness": { "default_max_age_hours": 24 }
  },
  "scorecard_na": { "schemaVersion": "1.0.0", "cells": [] },
  "glob_guards": {
    "schemaVersion": "1.0.0",
    "guards": [
      {
        "id": "STYNX_TEST_SURFACE",
        "pattern": "**/*.test.ts",
        "min_matches": 1,
        "description": "The adopter test surface must remain non-empty."
      }
    ]
  }
}
