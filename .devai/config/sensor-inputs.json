{
  "schemaVersion": "1.0.0",
  "inputs": {
    "test_security_coverage": {
      "testGlobs": ["packages/*/tests", "tests"]
    },
    "test_performance_coverage": {
      "testGlobs": ["packages/*/tests", "tests"]
    },
    "test_robustness_coverage": {
      "testGlobs": ["packages/*/tests", "tests"]
    },
    "test_idiomaticity": {
      "testGlobs": ["packages/*/tests", "tests"]
    },
    "spec_depth": {
      "adrDir": "law/adr",
      "invariantsDir": "law/invariants"
    },
    "test_coverage_depth": {
      "coveragePath": "scratch/coverage/local/coverage-final.json",
      "population": "local",
      "exclusions": [
        "packages/authority/tests/unit/authority-resource-boundaries.red.test.ts",
        "packages/skills/tests/recipes/adapters.test.ts",
        "tests/integration/authority-effect-postgres.db.test.ts",
        "tests/integration/runtime-probe-data.integration.test.ts"
      ]
    },
    "action_effect_inference": {
      "tsconfigPath": "tests/config/tsconfig.effects.json"
    },
    "type_check": {
      "argv": ["npx", "tsc", "--noEmit", "-p", "tsconfig.typecheck.json"]
    },
    "unit_test": {
      "argv": [
        "pnpm",
        "vitest",
        "run",
        "--config",
        "tests/config/local.config.ts",
        "tests/contract"
      ]
    },
    "integration_test": {
      "argv": [
        "pnpm",
        "vitest",
        "run",
        "--config",
        "tests/config/local.config.ts",
        "tests/integration"
      ]
    },
    "e2e_test": {
      "argv": ["pnpm", "vitest", "run", "--config", "tests/config/rc.e2e.config.ts"]
    },
    "perf_test": {
      "argv": [
        "pnpm",
        "vitest",
        "run",
        "--config",
        "tests/config/rc.performance.config.ts",
        "tests/regression"
      ]
    },
    "harness_idiomaticity": {
      "minWorkflowsForReusableCheck": 5
    },
    "plant_depth": {
      "excludeGlobs": ["packages/cli/src/generated/**"]
    }
  },
  "surfaces": {
    "http": false,
    "database": false,
    "rbac": false,
    "actions": true
  }
}
