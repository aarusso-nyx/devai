{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact source-file application manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "expected", "content_utf8", "content_sha256"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "absent"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sha256", "mode"],
          "properties": {
            "kind": {
              "const": "file"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 511
            }
          }
        }
      ]
    },
    "content_utf8": {
      "type": "string"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
