{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/release-intent.schema.json",
  "title": "Release verification intent",
  "description": "Candidate-bound, bounded release-verification input. It grants no publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release_unit",
    "current_version",
    "target_version",
    "support",
    "changed_paths",
    "changed_packages",
    "candidate",
    "base"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "release_unit": { "type": "string", "minLength": 1, "maxLength": 200 },
    "current_version": { "type": "string", "maxLength": 100 },
    "target_version": { "type": "string", "maxLength": 100 },
    "support": { "enum": ["preview", "current", "lts"] },
    "support_promotion": { "type": "boolean" },
    "change_kind": { "enum": ["documentation", "metadata", "behavioral"] },
    "channel": {
      "enum": ["alpha", "beta", "rc", "stable"],
      "description": "Optional prerelease channel derived from target_version under the lifecycle policy prerelease ladder (ADR-REL-0028): the rung named by the prerelease identifier, or stable when there is none. The kernel blocks when the declared channel disagrees with the version string."
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
      }
    },
    "changed_packages": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "risks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    },
    "owner_escalations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    },
    "candidate": { "$ref": "#/$defs/gitIdentity" },
    "base": { "$ref": "#/$defs/gitIdentity" }
  },
  "$defs": {
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "tree": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
      }
    }
  },
  "schema_version": "1.0.0",
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "release_unit": "@aarusso-nyx/devai",
      "current_version": "1.4.5",
      "target_version": "1.5.0",
      "support": "current",
      "support_promotion": false,
      "change_kind": "behavioral",
      "changed_paths": ["law/policy/release-lifecycle.json"],
      "changed_packages": ["@aarusso-nyx/devai"],
      "risks": ["release-integrity"],
      "owner_escalations": [],
      "candidate": {
        "commit": "5461ba500000000000000000000000000000aaaa",
        "tree": "2cad519aba8117a1850eee85d41eae452d51a141"
      },
      "base": {
        "commit": "37e75a5c27569d4cb3fdb4a3dc97a140da4d78de",
        "tree": "1111111111111111111111111111111111111111"
      }
    }
  ]
}
