{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/soft-gate-rubric.schema.json",
  "title": "Soft gate rubric",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "authority",
    "canonicalization",
    "aggregation",
    "dimensions",
    "score_levels"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "soft-gate-rubric"
    },
    "authority": {
      "const": "Architect"
    },
    "canonicalization": {
      "const": "DEVAI-CANONICAL-JSON-V1"
    },
    "aggregation": {
      "const": "all-dimensions"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_coherence", "plant_idiomaticity", "test_depth", "traceability_quality"],
      "properties": {
        "spec_coherence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "plant_idiomaticity": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test_depth": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "traceability_quality": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "score_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2", "3", "4"],
      "properties": {
        "0": {
          "type": "string",
          "minLength": 1
        },
        "1": {
          "type": "string",
          "minLength": 1
        },
        "2": {
          "type": "string",
          "minLength": 1
        },
        "3": {
          "type": "string",
          "minLength": 1
        },
        "4": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
