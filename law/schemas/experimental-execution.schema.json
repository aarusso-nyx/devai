{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/experimental-execution.schema.json",
  "title": "Experimental execution policy",
  "description": "Framework ceilings and fixed rules for opt-in experimental agent execution (ADR-MDL-0005). An adopter activation record chooses values within these ceilings; nothing here activates execution by itself.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "status",
    "authority",
    "decision",
    "activation",
    "disciplines",
    "runtimes",
    "attempts",
    "ceilings",
    "containment",
    "journal",
    "evidence"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/experimental-execution.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "experimental-execution"
    },
    "status": {
      "const": "active"
    },
    "authority": {
      "const": "Architect"
    },
    "decision": {
      "const": "ADR-MDL-0005"
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "schema",
        "authority",
        "max_validity_days",
        "action",
        "consent",
        "writer",
        "amended_by"
      ],
      "properties": {
        "record": {
          "const": ".devai/state/experimental/activation.json"
        },
        "schema": {
          "const": "law/schemas/experimental-activation.schema.json"
        },
        "authority": {
          "const": "Owner"
        },
        "max_validity_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "action": {
          "const": "round dispatch"
        },
        "consent": {
          "const": "explicit --write and --experimental for the resolved invocation"
        },
        "writer": {
          "const": "round dispatch activate"
        },
        "amended_by": {
          "const": "ADR-MDL-0006"
        }
      }
    },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["engineer", "inspector"]
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["claude-cli", "codex-cli"]
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_tier", "bumped_tier", "exhausted_status", "fallback"],
      "properties": {
        "default_tier": {
          "const": 3
        },
        "bumped_tier": {
          "const": 1
        },
        "exhausted_status": {
          "const": "experimental_blocked"
        },
        "fallback": {
          "const": "forbidden"
        }
      }
    },
    "ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts_per_task",
        "attempts_per_invocation",
        "attempt_wall_clock_minutes",
        "tokens_per_invocation"
      ],
      "properties": {
        "attempts_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "attempts_per_invocation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "attempt_wall_clock_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "tokens_per_invocation": {
          "const": "declared-by-activation-no-default"
        }
      }
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree", "provider_sandbox", "write_scope_check", "remote_effects"],
      "properties": {
        "worktree": {
          "const": "per-task-from-round-base"
        },
        "provider_sandbox": {
          "const": "requested-never-claimed-verified"
        },
        "write_scope_check": {
          "const": "article-6-paths-after-each-attempt"
        },
        "remote_effects": {
          "const": "forbidden"
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema", "events", "uncertain"],
      "properties": {
        "path": {
          "const": ".devai/state/round-runs/{round}/dispatch-journal.jsonl"
        },
        "schema": {
          "const": "law/schemas/dispatch-journal-event.schema.json"
        },
        "events": {
          "const": ["intent", "spawned", "exited", "evidence-written", "settled"]
        },
        "uncertain": {
          "const": "blocks-round-until-human-task-escalate"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "promoting", "usage", "missing_counter"],
      "properties": {
        "label": {
          "const": "experimental"
        },
        "promoting": {
          "const": false
        },
        "usage": {
          "const": "task-execution-evidence usage version 2"
        },
        "missing_counter": {
          "const": "missing-never-zero"
        }
      }
    }
  },
  "examples": [
    {
      "$schema": "../schemas/experimental-execution.schema.json",
      "schemaVersion": "1.0.0",
      "id": "experimental-execution",
      "status": "active",
      "authority": "Architect",
      "decision": "ADR-MDL-0005",
      "activation": {
        "record": ".devai/state/experimental/activation.json",
        "schema": "law/schemas/experimental-activation.schema.json",
        "authority": "Owner",
        "max_validity_days": 30,
        "action": "round dispatch",
        "consent": "explicit --write and --experimental for the resolved invocation",
        "writer": "round dispatch activate",
        "amended_by": "ADR-MDL-0006"
      },
      "disciplines": ["engineer", "inspector"],
      "runtimes": ["claude-cli", "codex-cli"],
      "attempts": {
        "default_tier": 3,
        "bumped_tier": 1,
        "exhausted_status": "experimental_blocked",
        "fallback": "forbidden"
      },
      "ceilings": {
        "attempts_per_task": 4,
        "attempts_per_invocation": 32,
        "attempt_wall_clock_minutes": 60,
        "tokens_per_invocation": "declared-by-activation-no-default"
      },
      "containment": {
        "worktree": "per-task-from-round-base",
        "provider_sandbox": "requested-never-claimed-verified",
        "write_scope_check": "article-6-paths-after-each-attempt",
        "remote_effects": "forbidden"
      },
      "journal": {
        "path": ".devai/state/round-runs/{round}/dispatch-journal.jsonl",
        "schema": "law/schemas/dispatch-journal-event.schema.json",
        "events": ["intent", "spawned", "exited", "evidence-written", "settled"],
        "uncertain": "blocks-round-until-human-task-escalate"
      },
      "evidence": {
        "label": "experimental",
        "promoting": false,
        "usage": "task-execution-evidence usage version 2",
        "missing_counter": "missing-never-zero"
      }
    }
  ]
}
