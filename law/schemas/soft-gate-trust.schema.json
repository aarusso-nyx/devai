{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/soft-gate-trust.schema.json",
  "title": "Independent soft gate trust selection",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "evidence_commit",
    "payload_sha256",
    "candidate",
    "producer_control",
    "working_agent",
    "custodian_id",
    "evaluator_identity",
    "public_key_spki_der_base64",
    "key_id",
    "algorithm",
    "canonicalization",
    "signature_domain",
    "selected_at",
    "expires_at"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "repository": {
      "const": "aarusso-nyx/devai"
    },
    "evidence_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "base_commit"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "producer_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "executable_sha256"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "working_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "session_id", "process_instance_id", "host", "model"],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "process_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "enum": ["claude", "codex"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "custodian_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "session_id", "process_instance_id", "host", "model"],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "process_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "enum": ["claude", "codex"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "public_key_spki_der_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 512,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "canonicalization": {
      "const": "DEVAI-CANONICAL-JSON-V1"
    },
    "signature_domain": {
      "const": "DEVAI-SOFT-GATE-EVIDENCE-V1"
    },
    "selected_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Independently controlled DEVAI_SOFT_GATE_TRUST_JSON snapshot, never accepted from candidate law/config/fixture. Round-trip canonical base64 DER SPKI must be an Ed25519 public key, key_id hashes decoded DER, signature exactly64raw bytes. Compare all candidate/control/agent/evaluator bindings and manifest identity; selected_at/created_at must not be future and expiration/freshness must hold. Custodian/evaluator independence is externally established, not a worker self-assertion. Preserve one frozen snapshot through opaque verified-byte consumption or fully reverify before use."
}
