{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/actions-list-output.schema.json",
  "title": "Actions List Output",
  "description": "The JSON output of `devai catalog actions`: the current v1.0rc command catalog.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "path", "status", "description", "authority", "profiles", "effects"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Canonical space-separated action path."
      },
      "path": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "status": {
        "enum": ["stable", "preview", "internal"]
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "description": "One-line description of what the action does."
      },
      "authority": {
        "description": "Authority subsystem responsible for the action.",
        "enum": [
          "mesh_controller",
          "specifier",
          "constructor",
          "sensor",
          "policy_firewall",
          "release_controller",
          "agent_runtime",
          "host_tooling"
        ]
      },
      "profiles": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": ["tier1", "tier2", "tier3"]
        }
      },
      "effects": {
        "enum": ["read", "harness-write", "local-write", "remote-write"]
      },
      "authority_contract_version": {
        "const": "1.0.0",
        "description": "Version of the action's authority contract."
      }
    }
  },
  "schema_version": "1.0.0",
  "examples": [
    [
      {
        "name": "doctor",
        "path": ["doctor"],
        "status": "stable",
        "description": "Run repository health checks.",
        "authority": "sensor",
        "profiles": ["tier1"],
        "effects": "read"
      }
    ]
  ]
}
