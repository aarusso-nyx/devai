    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "result_digest_sha256"],
      "description": "One required check. It passed or it failed; it has no third outcome and no absent result.",
      "properties": {
        "check_id": {
          "enum": [
            "candidate-tree-identity",
            "receipt-envelope-canonicality",
            "signer-trust",
            "policy-identity",
            "result-dag-integrity",
            "artifact-population",
            "artifact-digests",
            "artifact-safety"
          ]
        },
        "status": {
          "enum": ["pass", "fail"]
        },
        "result_digest_sha256": {
          "$ref": "#/$defs/result_digest"
        }
      }
    },
    "passed_check": {
      "properties": {
        "status": {
          "const": "pass"
        }
      }
    },
    "mutation_semantics_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "result_digest_sha256"],
      "description": "The mutation-semantics check. It is the only roster entry that may be typed not-applicable, and only for a reason the canonical mutation policy already permits. Silence is not one of its outcomes.",
      "properties": {
        "check_id": {
          "const": "mutation-semantics"
        },
        "status": {
          "enum": ["pass", "fail", "not-applicable"]
        },
        "result_digest_sha256": {
          "$ref": "#/$defs/result_digest"
        },
        "not_applicable_reason": {
          "enum": [
            "documentation-only-change",
            "metadata-only-change",
            "no-behavioral-surface-selected"
          ]
        },
        "not_applicable_permitted_by": {
          "const": "law/policy/mutation-assurance-v2.json#/not_required/permitted_reasons"
        },
        "mutation_report_id": {
          "type": "string",
          "pattern": "^MA2-[0-9a-f]{16}$"
        },
        "mutation_report_digest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not-applicable"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["not_applicable_reason", "not_applicable_permitted_by"],
            "not": {
              "required": ["mutation_report_id"]
            }
          },
          "else": {
            "required": ["mutation_report_id", "mutation_report_digest_sha256"],
            "not": {
              "required": ["not_applicable_reason"]
            }
          }
        }
      ]
    },
