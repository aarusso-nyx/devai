{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/soft-gate-score.schema.json",
  "title": "Scored soft gate reply",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verdict", "confidence", "rationale", "scores", "citations"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "verdict": {
      "enum": ["pass", "review", "fail", "unknown"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_coherence", "plant_idiomaticity", "test_depth", "traceability_quality"],
      "properties": {
        "spec_coherence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "plant_idiomaticity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "test_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "traceability_quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "citations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_coherence", "plant_idiomaticity", "test_depth", "traceability_quality"],
      "properties": {
        "spec_coherence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "location", "source_sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f])[^/]+(?:/[^/]+)*$"
              },
              "location": {
                "type": "string",
                "pattern": "^(?:L[1-9][0-9]*(?:-L[1-9][0-9]*)?|#[A-Za-z][A-Za-z0-9_-]*)$"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "plant_idiomaticity": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "location", "source_sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f])[^/]+(?:/[^/]+)*$"
              },
              "location": {
                "type": "string",
                "pattern": "^(?:L[1-9][0-9]*(?:-L[1-9][0-9]*)?|#[A-Za-z][A-Za-z0-9_-]*)$"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "test_depth": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "location", "source_sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f])[^/]+(?:/[^/]+)*$"
              },
              "location": {
                "type": "string",
                "pattern": "^(?:L[1-9][0-9]*(?:-L[1-9][0-9]*)?|#[A-Za-z][A-Za-z0-9_-]*)$"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "traceability_quality": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "location", "source_sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f])[^/]+(?:/[^/]+)*$"
              },
              "location": {
                "type": "string",
                "pattern": "^(?:L[1-9][0-9]*(?:-L[1-9][0-9]*)?|#[A-Za-z][A-Za-z0-9_-]*)$"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "description": "Separate fully required scored reply, not a widening of review-verdict. Each contained NFC source path and source-byte digest must resolve in the frozen context. Locations resolve to existing lines/anchors; line ranges must be increasing. PASS additionally requires verdict pass; review/fail block admission and unknown or invalid evidence is an evidence error even with four passing scores. Gate checks every dimension independently, actual host completion/isolation and all evidence bindings; confidence/rationale never substitute. Missing observations are an error, not score zero."
}
