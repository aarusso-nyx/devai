{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/experimental-activation.schema.json",
  "title": "Experimental execution activation",
  "description": "Owner-authored, expiring activation of experimental agent execution in one adopter repository (ADR-MDL-0005 D-1). It names the exact runtimes, models, efforts, disciplines, and budgets an invocation of `round dispatch --write --experimental` may use. Values never exceed law/policy/experimental-execution.json; the expiry is at most that policy's max_validity_days after issued_at, which the runtime checks.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "authority",
    "issued_at",
    "expires_at",
    "runtimes",
    "disciplines",
    "budgets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "experimental-activation"
    },
    "authority": {
      "const": "Owner"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime", "models", "efforts"],
        "properties": {
          "runtime": {
            "enum": ["claude-cli", "codex-cli"]
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "efforts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["engineer", "inspector"]
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts_per_task",
        "attempts_per_invocation",
        "attempt_wall_clock_minutes",
        "tokens_per_invocation"
      ],
      "properties": {
        "attempts_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "attempts_per_invocation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "attempt_wall_clock_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "tokens_per_invocation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "id": "experimental-activation",
      "authority": "Owner",
      "issued_at": "2026-10-04T12:00:00.000Z",
      "expires_at": "2026-10-18T12:00:00.000Z",
      "runtimes": [
        {
          "runtime": "claude-cli",
          "models": ["claude-opus-5-5"],
          "efforts": ["high"]
        },
        {
          "runtime": "codex-cli",
          "models": ["gpt-5.5-codex"],
          "efforts": ["high"]
        }
      ],
      "disciplines": ["engineer", "inspector"],
      "budgets": {
        "attempts_per_task": 4,
        "attempts_per_invocation": 8,
        "attempt_wall_clock_minutes": 30,
        "tokens_per_invocation": 2000000
      },
      "note": "Two-week trial on round R-0012 test-writing tasks."
    }
  ]
}
