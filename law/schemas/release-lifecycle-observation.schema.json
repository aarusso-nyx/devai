    {
      "schemaVersion": "1.0.0",
      "observation_kind": "release-lifecycle-observation",
      "observation_id": "RLO-a001454061bfbcdc",
      "repository": {
        "id": "aarusso-nyx/devai",
        "commit": "5461ba500000000000000000000000000000aaaa",
        "tree": "2cad519aba8117a1850eee85d41eae452d51a141"
      },
      "candidate": {
        "release_unit": "@aarusso-nyx/devai",
        "version": "1.5.0",
        "commit": "5461ba500000000000000000000000000000aaaa",
        "tree": "2cad519aba8117a1850eee85d41eae452d51a141"
      },
      "verification_kernel": {
        "kernel_id": "devai.kernel.release-lifecycle-observation.v1",
        "policy_source": "law/policy/release-lifecycle.json#/observation_kernel",
        "schema_validation_alone_derives_published": false
      },
      "head": {
        "state": "exported",
        "state_id": "RLS-89abcdef01234567",
        "record_digest_sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
      },
      "derived_states": [
        {
          "state": "offline_verified",
          "receipt_kind": "release-offline-verification-receipt",
          "receipt_id": "ROV-0eca1bdad698a5db",
          "receipt_digest_sha256": "0eca1bdad698a5db560528da47fa11bd5129f3e9ddb0fe1220bec789740b1e5c",
          "verified": true
        }
      ],
      "published": {
        "observed": false,
        "receipt": null,
        "verified_against": null
      },
      "next_action": "release evidence-publish",
      "next_outcome": "ready",
      "emitted_by": {
        "action_id": "release resume",
