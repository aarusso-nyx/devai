          "receipt_digest_sha256": "61d9347d6740ebc6a53dcbd2e5d803c6dea891dfc6d0b65c1cab51edf5ef313f",
          "trust_root_id": "devai-publication-receipt-root",
          "trust_store_digest_sha256": "e526c28a6fa8cbeb69058d562398b05061ca3469f200356558c4d152a60363a8",
          "key_id": "publication-receipt-2026-09",
          "signature_algorithm": "ed25519",
