{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/mutation-evidence-policy-v2.schema.json",
  "title": "Canonical mutation evidence policy v2",
  "description": "Closed policy for the sole forward mutation-v2 report-set protocol, its source-first activation gate, complete package input identity, eight raw Stryker statuses, pure composition, read-only v1 boundary, and mandatory semantic verifier.",
  "schema_version": "2.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "authority",
    "contractSchema",
    "sourceBaseline",
    "activation",
    "documents",
    "artifactModel",
    "inputIdentity",
    "dispositions",
    "statusModel",
    "scoreModel",
    "composition",
    "compatibility",
    "contentSafety",
    "offlineVerification",
    "semanticKernel"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "2.1.0" },
    "id": { "const": "mutation-evidence-v2" },
    "status": { "enum": ["frozen-pending-canonical-verifier", "active"] },
    "authority": { "const": "Architect" },
    "contractSchema": { "const": "law/schemas/mutation-report-set-v2.schema.json" },
    "sourceBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": { "const": "devai-verifier" },
        "commit": { "$ref": "#/$defs/git_object" },
        "tree": { "$ref": "#/$defs/git_object" }
      }
    },
    "activation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalVerifierCommit",
            "canonicalVerifierTree",
            "emissionPermitted",
            "verificationPermitted",
            "vendorBeforeActivation"
          ],
          "properties": {
            "canonicalVerifierCommit": { "type": "null" },
            "canonicalVerifierTree": { "type": "null" },
            "emissionPermitted": { "const": false },
            "verificationPermitted": { "const": false },
            "vendorBeforeActivation": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalVerifierCommit",
            "canonicalVerifierTree",
            "emissionPermitted",
            "verificationPermitted",
            "vendorBeforeActivation"
          ],
          "properties": {
            "canonicalVerifierCommit": { "$ref": "#/$defs/git_object" },
            "canonicalVerifierTree": { "$ref": "#/$defs/git_object" },
            "emissionPermitted": { "const": true },
            "verificationPermitted": { "const": true },
            "vendorBeforeActivation": { "const": true }
          }
        }
      ]
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputContract", "packageResult", "composition", "schemaVersion"],
      "properties": {
        "outputContract": { "const": "mutation-report-set-v2" },
        "packageResult": { "const": "mutation-package-result-v2" },
        "composition": { "const": "mutation-composed-report-set-v2" },
        "schemaVersion": { "const": "2.1.0" }
      }
    },
    "artifactModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritativeArtifacts",
        "canonicalization",
        "contentAddress",
        "storeLayout",
        "candidateSpecificPackageBytes",
        "compositionWritesExecutionArtifacts",
        "refinalizationMutationProcessCount",
        "refinalizationDeterministicAcross",
        "verbatimRunnerOutputPermitted"
      ],
      "properties": {
        "authoritativeArtifacts": {
          "const": ["normalized-stryker-report", "package-result"]
        },
        "canonicalization": { "const": "rfc8785-jcs-utf8" },
        "contentAddress": { "const": "sha256-of-canonical-artifact-bytes" },
        "storeLayout": {
          "const": ".devai/state/mutation/v2/store/sha256/<inputDigest>/{report.json,result.json}"
        },
        "candidateSpecificPackageBytes": { "const": false },
        "compositionWritesExecutionArtifacts": { "const": false },
        "refinalizationMutationProcessCount": { "const": 0 },
        "refinalizationDeterministicAcross": {
          "const": ["time", "cwd", "unrelated-environment", "ambient-host-state"]
        },
        "verbatimRunnerOutputPermitted": { "const": false }
      }
    },
    "inputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "bindings",
        "bindingFields",
        "rawEnvironmentOrToolchainValuesPermitted",
        "missingBehavior",
        "mismatchBehavior",
        "additionalBehavior"
      ],
      "properties": {
        "digest": {
          "const": "sha256-domain-devai-mutation-input-v2.1-nul-u64be-length-rfc8785-jcs-input-projection"
        },
        "bindings": {
          "const": [
            "source",
            "tests",
            "manifests",
            "mutationConfiguration",
            "runner",
            "roster",
            "thresholds",
            "sanitizer",
            "lockfile",
            "environment",
            "toolchain",
            "semanticRebind"
          ]
        },
        "bindingFields": {
          "const": ["canonicalization", "memberCount", "populationDigest", "selectionRuleDigest"]
        },
        "rawEnvironmentOrToolchainValuesPermitted": { "const": false },
        "missingBehavior": { "const": "deny-reuse" },
        "mismatchBehavior": { "const": "deny-reuse" },
        "additionalBehavior": { "const": "deny-reuse" }
      }
    },
    "dispositions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "provenanceCompatibility",
        "notRequired",
        "aggregatePreservesCounts"
      ],
      "properties": {
        "declared": { "const": ["executed", "reused", "not-required"] },
        "provenanceCompatibility": {
          "const": { "executed": "fresh", "reused": "reused", "not-required": null }
        },
        "notRequired": {
          "type": "object",
          "additionalProperties": false,
          "required": ["isPass", "artifactReferencePermitted", "permittedReasons"],
          "properties": {
            "isPass": { "const": false },
            "artifactReferencePermitted": { "const": false },
            "permittedReasons": {
              "const": [
                "no-mutatable-production-surface",
                "package-excluded-by-approved-release-profile"
              ]
            }
          }
        },
        "aggregatePreservesCounts": { "const": true }
      }
    },
    "statusModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawStatuses",
        "detectedScored",
        "undetectedScored",
        "preservedNonScored",
        "completionBlocking",
        "passBlocking",
        "compileErrorThresholdAdded",
        "ignoredRulesBoundBy"
      ],
      "properties": {
        "rawStatuses": {
          "const": [
            "CompileError",
            "Ignored",
            "Killed",
            "NoCoverage",
            "Pending",
            "RuntimeError",
            "Survived",
            "Timeout"
          ]
        },
        "detectedScored": { "const": ["Killed", "Timeout"] },
        "undetectedScored": { "const": ["Survived", "NoCoverage"] },
        "preservedNonScored": { "const": ["CompileError", "Ignored"] },
        "completionBlocking": { "const": ["Pending"] },
        "passBlocking": { "const": ["RuntimeError", "infrastructure-failure"] },
        "compileErrorThresholdAdded": { "const": false },
        "ignoredRulesBoundBy": { "const": "mutationConfiguration" }
      }
    },
    "scoreModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numericModel",
        "detected",
        "scored",
        "score",
        "reportedComparison",
        "thresholds",
        "passThreshold"
      ],
      "properties": {
        "numericModel": { "const": "ieee-754-binary64-round-to-nearest-ties-to-even" },
        "detected": { "const": "binary64-add(Killed,Timeout)" },
        "scored": { "const": "binary64-add(binary64-add(detected,Survived),NoCoverage)" },
        "score": {
          "const": "scored-binary64-equals-zero-question-100-colon-binary64-multiply(binary64-divide(detected,scored),100)"
        },
        "reportedComparison": { "const": "samevalue-and-not-negative-zero" },
        "thresholds": { "const": ["break", "high", "low"] },
        "passThreshold": { "const": "score-greater-than-or-equal-to-break" }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateSpecific",
        "exactRosterBijection",
        "packageOrder",
        "evidenceSetDigest",
        "aggregateCounts",
        "pureFinalizer"
      ],
      "properties": {
        "candidateSpecific": { "const": true },
        "exactRosterBijection": { "const": true },
        "packageOrder": { "const": "output-contract-order" },
        "evidenceSetDigest": {
          "const": "sha256-domain-devai-mutation-composition-v2.1-nul-u64be-length-rfc8785-jcs-complete-ordered-package-entry-array"
        },
        "aggregateCounts": {
          "const": [
            "packageCount",
            "executedPackageCount",
            "reusedPackageCount",
            "notRequiredPackageCount"
          ]
        },
        "pureFinalizer": { "const": true }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v1ReadOnly",
        "v1ReuseEligible",
        "v1ExportPermitted",
        "v1PublicationPermitted",
        "v1ReuseIntoV2",
        "v1TranslationIntoV2",
        "draftV2SchemaVersionAccepted",
        "dualWritePermitted",
        "assuranceV2WriterPermitted",
        "assuranceV2KernelPermitted"
      ],
      "properties": {
        "v1ReadOnly": { "const": true },
        "v1ReuseEligible": { "const": false },
        "v1ExportPermitted": { "const": false },
        "v1PublicationPermitted": { "const": false },
        "v1ReuseIntoV2": { "const": false },
        "v1TranslationIntoV2": { "const": false },
        "draftV2SchemaVersionAccepted": { "const": false },
        "dualWritePermitted": { "const": false },
        "assuranceV2WriterPermitted": { "const": false },
        "assuranceV2KernelPermitted": { "const": false }
      }
    },
    "contentSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reservedKindPrefix",
        "portablePathsRequired",
        "hostPathsForbidden",
        "symlinkEscapesForbidden",
        "noFollowScope",
        "credentialMaterialForbidden",
        "privateMaterialForbidden",
        "unknownFieldsForbidden",
        "unknownVersionsForbidden"
      ],
      "properties": {
        "reservedKindPrefix": { "const": "mutation-" },
        "portablePathsRequired": { "const": true },
        "hostPathsForbidden": { "const": true },
        "symlinkEscapesForbidden": { "const": true },
        "noFollowScope": { "const": "final-component-and-every-ancestor" },
        "credentialMaterialForbidden": { "const": true },
        "privateMaterialForbidden": { "const": true },
        "unknownFieldsForbidden": { "const": true },
        "unknownVersionsForbidden": { "const": true }
      }
    },
    "offlineVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalExpectationsRequired",
        "candidateDefaultsPermitted",
        "exactResultSetClosure",
        "trustStoreNoFollowRequired",
        "artifactNoFollowRequired",
        "nativePathInErrorPermitted"
      ],
      "properties": {
        "externalExpectationsRequired": {
          "const": [
            "repository",
            "candidateCommit",
            "candidateTree",
            "taskPolicyDigest",
            "signerId",
            "trustRootId",
            "trustStoreDigest",
            "keyId"
          ]
        },
        "candidateDefaultsPermitted": { "const": false },
        "exactResultSetClosure": {
          "const": "signed-receipt-results-equals-manifest-resultDigests-equals-supplied-result-files"
        },
        "trustStoreNoFollowRequired": { "const": true },
        "artifactNoFollowRequired": { "const": true },
        "nativePathInErrorPermitted": { "const": false }
      }
    },
    "semanticKernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mandatory", "schemaValidationEstablishesPass", "algorithm", "errors"],
      "properties": {
        "id": { "const": "devai.kernel.mutation-report-set-v2.v1" },
        "mandatory": { "const": true },
        "schemaValidationEstablishesPass": { "const": false },
        "algorithm": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 20 }
        },
        "errors": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
        }
      }
    }
  },
  "$defs": {
    "git_object": {
      "type": "string",
      "pattern": "^(?!0+$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "frozen-pending-canonical-verifier" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "activation": {
            "properties": {
              "canonicalVerifierCommit": { "type": "null" },
              "canonicalVerifierTree": { "type": "null" },
              "emissionPermitted": { "const": false },
              "verificationPermitted": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "active" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "activation": {
            "properties": {
              "canonicalVerifierCommit": { "$ref": "#/$defs/git_object" },
              "canonicalVerifierTree": { "$ref": "#/$defs/git_object" },
              "emissionPermitted": { "const": true },
              "verificationPermitted": { "const": true }
            }
          }
        }
      }
    }
  ],
  "examples": [
    {
      "$schema": "../schemas/mutation-evidence-policy-v2.schema.json",
      "schemaVersion": "2.1.0",
      "id": "mutation-evidence-v2",
      "status": "frozen-pending-canonical-verifier",
      "authority": "Architect",
      "contractSchema": "law/schemas/mutation-report-set-v2.schema.json",
