{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/campaign.schema.json",
  "title": "Campaign plan",
  "description": "A campaign is a human-declared plan that implements a set of accepted decision records through ordered rounds. A round contains waves; a wave is a coupled task group in the sense of Constitution Article 24; a task is the smallest unit one role executes in one session. This document is a plan and a ledger of merged outcomes, never runtime state: it is Architect-authored under product/campaigns and it materializes into governed round and task records only through the mapping declared in law/policy/campaign-execution.json.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "type",
    "status",
    "date",
    "authority",
    "mandate",
    "goal",
    "records",
    "constraints",
    "owner_effects",
    "prompts",
    "rounds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/id_campaign"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "type": {
      "const": "campaign"
    },
    "status": {
      "enum": ["proposed", "accepted", "active", "closed", "abandoned"],
      "description": "proposed: drafted, not yet approved by the mandate holder. accepted: approved, no round open. active: at least one round open. closed: every round closed. abandoned: stopped with at least one round not closed; the reason is recorded in disposition."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "authority": {
      "const": "Architect",
      "description": "The plan is an engineering artifact. Scope approval comes from the mandate, not from this field."
    },
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "description": "Where the scope decision came from. Human maintainers choose scope; the campaign only orders it.",
      "properties": {
        "kind": {
          "enum": ["maintainer-decision", "decision-record", "owner-mandate"]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative path or D- decision identity."
        }
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/adr_reference"
      },
      "description": "Every decision record the campaign implements. Each must be accepted before the round that implements it opens."
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self_dogfood", "human_invoked_only", "one_role_per_session", "remote_effects"],
      "properties": {
        "self_dogfood": {
          "type": "boolean",
          "description": "true when the subject is DEVAI's own repository, which binds law/policy/self-dogfood.json."
        },
        "human_invoked_only": {
          "const": true
        },
        "one_role_per_session": {
          "const": true
        },
        "remote_effects": {
          "const": "forbidden"
        }
      }
    },
    "owner_effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "required_before"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OE-[0-9]{2,}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_before": {
            "$ref": "#/$defs/id_round",
            "description": "The round that cannot close until this separately authorized effect is performed."
          },
          "performed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      },
      "description": "External or repository-setting effects that no task may perform. They are listed so a round gate can require them."
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preamble"],
      "properties": {
        "preamble": {
          "$ref": "#/$defs/relativePath",
          "description": "Path relative to the campaign directory of the text pasted before every task prompt."
        }
      }
    },
    "disposition": {
      "type": "string",
      "minLength": 1,
      "description": "Required when status is abandoned."
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/round"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "abandoned"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["disposition"]
      }
    }
  ],
  "$defs": {
    "id_campaign": {
      "type": "string",
      "pattern": "^CMP-[0-9]{4}$"
    },
    "id_round": {
      "type": "string",
      "pattern": "^R-[0-9]{4}$"
    },
    "id_wave": {
      "type": "string",
      "pattern": "^CTG-[0-9]{4,}$"
    },
    "id_task": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4,}$"
    },
    "adr_reference": {
      "type": "string",
      "pattern": "^ADR-[A-Z][A-Z0-9]{1,15}(?:-[A-Z][A-Z0-9]{1,15})*-[0-9]{4}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      ],
      "description": "Shell-free argument vector; the first item is a bare executable name."
    },
    "check_member": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)*$",
      "description": "A check adapter member name or a package script alias."
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "goal",
        "status",
        "records",
        "depends_on",
        "attestation_reissue",
        "owner_effects_required",
        "close_checks",
        "waves"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_round"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["planned", "open", "closing", "closed", "abandoned"],
          "description": "planned: gate not yet satisfied. open: gate satisfied, tasks may start. closing: every task merged, close checks running. closed: close checks passed and closure recorded. abandoned: stopped; disposition required."
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/adr_reference"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id_round"
          },
          "description": "Rounds that must be closed before this one opens. Must be acyclic across the campaign."
        },
        "attestation_reissue": {
          "type": "boolean",
          "description": "true when a task in this round changes test-tasks.json or any input of the task-policy digest, so the RC attestation must be re-issued at close."
        },
        "owner_effects_required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^OE-[0-9]{2,}$"
          }
        },
        "close_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/check_member"
          },
          "description": "Check members that must pass on the merged head in addition to the policy's universal close checks."
        },
        "closure": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["merged_head", "closed_at"],
          "properties": {
            "merged_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "closed_at": {
              "type": "string",
              "format": "date-time"
            },
            "task_policy_digest": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "phase_closure": {
              "type": ["string", "null"],
              "pattern": "^PC-[0-9]{4}$"
            }
          }
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        },
        "waves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/wave"
          }
        }
      }
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "records", "depends_on", "lock_scopes", "gates", "tasks"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_wave"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "enum": ["coupled-triplet", "single-role"],
          "description": "coupled-triplet: exactly one architect, one inspector, and one engineer task in pipeline order. single-role: one task."
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/adr_reference"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id_wave"
          },
          "description": "Waves in the same round whose engineer task must be merged before this wave's architect task starts."
        },
        "lock_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "description": "Path prefixes this wave writes. Two waves with an overlapping scope may not be open at the same time."
        },
        "gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/check_member"
          },
          "description": "Check members every task in the wave must pass before pre_merge."
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "discipline",
        "coupled_pipeline_position",
        "upstream_task_id",
        "status",
        "target_substrates",
        "boundary",
        "deliverables",
        "acceptance_commands",
        "commit_types",
        "prompt",
        "pull_request",
        "merged_as"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_task"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "discipline": {
          "enum": ["architect", "inspector", "engineer"],
          "description": "Owner and Auditor never execute campaign tasks; they approve and observe."
        },
        "coupled_pipeline_position": {
          "enum": ["architect", "inspector", "engineer"],
          "description": "Must equal discipline. Position order is architect, inspector, engineer per Constitution Article 24."
        },
        "upstream_task_id": {
          "type": ["string", "null"],
          "pattern": "^TASK-[0-9]{4,}$",
          "description": "null for the architect position; the previous position's task otherwise."
        },
        "status": {
          "enum": [
            "planned",
            "ready",
            "in_progress",
            "checkpoint",
            "pre_merge",
            "merged",
            "blocked",
            "cancelled"
          ],
          "description": "Plan-level projection of the runtime task lifecycle. merged corresponds to the runtime completed state."
        },
        "target_substrates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["F1", "F2", "F3", "F4", "F5"]
          }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths"],
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              },
              "description": "The only paths the task may create, edit, or delete. A path may not yet exist."
            },
            "forbidden": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              },
              "description": "Paths explicitly called out as off limits because a naive implementation would touch them."
            }
          }
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/argv"
          }
        },
        "commit_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+(?:\\([a-z0-9-]+\\))?$"
          },
          "description": "The commit type and scope pairs the task is expected to produce. A commit outside this list is a review finding."
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "$ref": "#/$defs/relativePath",
              "description": "Path relative to the campaign directory of the task prompt."
            },
            "sha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$",
              "description": "Pinned when the task starts. A later change to the prompt file is drift and requires re-review before merge."
            }
          }
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "pull_request": {
          "type": ["string", "null"],
          "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+$"
        },
        "merged_as": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "id": "CMP-0001",
      "title": "Example campaign",
      "type": "campaign",
      "status": "proposed",
      "date": "2026-09-26",
      "authority": "Architect",
      "mandate": {
        "kind": "maintainer-decision",
        "ref": "docs/dev/operations/workflow-economy-proposals.md"
      },
      "goal": "Implement one accepted decision record.",
      "records": ["ADR-CHK-0002"],
      "constraints": {
        "self_dogfood": true,
        "human_invoked_only": true,
        "one_role_per_session": true,
        "remote_effects": "forbidden"
      },
      "owner_effects": [],
      "prompts": {
        "preamble": "prompts/preamble.md"
      },
      "rounds": [
        {
          "id": "R-0101",
          "title": "Example round",
          "goal": "Land the record.",
          "status": "planned",
          "records": ["ADR-CHK-0002"],
          "depends_on": [],
          "attestation_reissue": false,
          "owner_effects_required": [],
          "close_checks": ["schemas"],
          "waves": [
            {
              "id": "CTG-0101",
              "title": "Example wave",
              "type": "single-role",
              "records": ["ADR-CHK-0002"],
              "depends_on": [],
              "lock_scopes": ["law/schemas/"],
              "gates": ["schemas"],
              "tasks": [
                {
                  "id": "TASK-0111",
                  "title": "Example task",
                  "discipline": "architect",
                  "coupled_pipeline_position": "architect",
                  "upstream_task_id": null,
                  "status": "planned",
                  "target_substrates": ["F1"],
                  "boundary": {
                    "paths": ["law/schemas/example.schema.json"]
                  },
                  "deliverables": ["The schema."],
                  "acceptance_commands": [["pnpm", "run", "test:schemas"]],
                  "commit_types": ["law(example)"],
                  "prompt": {
                    "path": "prompts/TASK-0111.md"
                  },
                  "pull_request": null,
                  "merged_as": null
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
