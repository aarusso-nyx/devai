{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/campaign.schema.json",
  "title": "Campaign plan",
  "description": "A campaign is a human-declared plan that implements a set of accepted decision records through ordered rounds. A round contains waves; a wave is a coupled task group in the sense of Constitution Article 24; a task is the smallest unit one role executes in one session. This document is a plan and a ledger of merged outcomes, never runtime state: it is Architect-authored under product/campaigns and it materializes into governed round and task records only through the mapping declared in law/policy/campaign-execution.json.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "type",
    "status",
    "date",
    "authority",
    "mandate",
    "goal",
    "records",
    "constraints",
    "owner_effects",
    "prompts",
    "rounds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/id_campaign"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "type": {
      "const": "campaign"
    },
    "status": {
      "enum": ["proposed", "accepted", "active", "closed", "abandoned"],
      "description": "proposed: drafted, not yet approved by the mandate holder. accepted: approved, no round open. active: at least one round open. closed: every round closed. abandoned: stopped with at least one round not closed; the reason is recorded in disposition."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "authority": {
      "const": "Architect",
      "description": "The plan is an engineering artifact. Scope approval comes from the mandate, not from this field."
    },
    "mandate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "description": "Where the scope decision came from. Human maintainers choose scope; the campaign only orders it.",
      "properties": {
        "kind": {
          "enum": ["maintainer-decision", "decision-record", "owner-mandate"]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative path or D- decision identity."
        }
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/adr_reference"
      },
      "description": "Every decision record the campaign implements. Each must be accepted before the round that implements it opens."
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self_dogfood", "human_invoked_only", "one_role_per_session", "remote_effects"],
      "properties": {
        "self_dogfood": {
          "type": "boolean",
          "description": "true when the subject is DEVAI's own repository, which binds law/policy/self-dogfood.json."
        },
        "human_invoked_only": {
          "const": true
        },
        "one_role_per_session": {
          "const": true
        },
        "remote_effects": {
          "const": "forbidden"
        }
      }
    },
    "owner_effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "required_before"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OE-[0-9]{2,}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_before": {
            "$ref": "#/$defs/id_round",
            "description": "The round that cannot close until this separately authorized effect is performed."
          },
          "performed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "outcome": {
            "enum": ["performed", "fallback"],
            "description": "How the effect was resolved. performed: the effect described was carried out; this is the meaning when outcome is absent and performed_at is set. fallback: the effect was resolved by the fallback its description names, and performed_at then records when the fallback was recorded, not when the described effect happened. A required effect closes its round with either outcome once performed_at is set; a rule that depends on the described effect itself, such as the merge queue that lifts serialized admission, stays in force while the outcome is fallback."
          }
        }
      },
      "description": "External or repository-setting effects that no task may perform. They are listed so a round gate can require them."
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preamble"],
      "properties": {
        "preamble": {
          "$ref": "#/$defs/relativePath",
          "description": "Path relative to the campaign directory of the text pasted before every task prompt."
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "description": "Which of the four review steps of law/policy/campaign-execution.json gates.review the campaign delegates to a model (ADR-GOV-0023). Absent, the campaign resolves to human. Gate ratification, merge, and dispatch of any remote effect are human in every mode.",
      "properties": {
        "mode": {
          "enum": ["human", "model-advisory"],
          "description": "human: no step is delegated and no task carries a review block. model-advisory: model evaluation of the task pull request runs inside the human-initiated orchestrator session, by a model instance distinct from the working agent, and the orchestrator records its advisory verdict on the task before the human ratifies the gate; the verdict never satisfies a gate, merges, or authorizes an effect."
        }
      }
    },
    "disposition": {
      "type": "string",
      "minLength": 1,
      "description": "Required when status is abandoned."
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/round"
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "tiers"],
      "description": "Optional override of the repository default in law/policy/model-tiers.json, by tier name (ADR-MDL-0002). A tier the block does not name resolves to the default; an unknown tier name, an effort outside the tier grammar, or a host the default does not declare fails closed at the campaign check. A campaign never introduces a host. A closed campaign keeps its block byte-for-byte as evidence. Tiers are the only names prompts and tasks use; the host models behind a tier change in the default, not in a prompt.",
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["claude", "codex"]
          },
          "description": "The hosts the campaign runs on; a subset of the hosts law/policy/model-tiers.json declares."
        },
        "tiers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9-]*$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rank": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "1 is the highest capability. Escalation moves to a lower rank number. When present it must equal the rank of the same tier in the default."
                },
                "claude": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Claude alias for this tier, one that law/policy/model-tiers.json declares for the claude host, for example fable. Ledgers written before the default existed carry a display name; a closed ledger is never edited."
                },
                "codex": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Codex alias for this tier, one that law/policy/model-tiers.json declares for the codex host, for example gpt-6-astra. Ledgers written before the default existed carry a display name; a closed ledger is never edited."
                },
                "default_effort": {
                  "enum": ["low", "medium", "high", "max"]
                },
                "use_for": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "minProperties": 1
            }
          }
        },
        "escalation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger", "step", "ceiling", "authority"],
          "properties": {
            "trigger": {
              "type": "string",
              "minLength": 1
            },
            "step": {
              "const": "one-rank-up"
            },
            "ceiling": {
              "type": "string",
              "minLength": 1,
              "description": "Tier name past which no escalation happens."
            },
            "authority": {
              "const": "orchestrator"
            }
          },
          "description": "Optional; absent, the default escalation rule applies. When present, the ceiling must be a tier the merged map declares."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "abandoned"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["disposition"]
      }
    }
  ],
  "$defs": {
    "id_campaign": {
      "type": "string",
      "pattern": "^CMP-[0-9]{4}$"
    },
    "id_round": {
      "type": "string",
      "pattern": "^R-[0-9]{4}$"
    },
    "id_wave": {
      "type": "string",
      "pattern": "^CTG-[0-9]{4,}$"
    },
    "id_task": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4,}$"
    },
    "adr_reference": {
      "type": "string",
      "pattern": "^ADR-[A-Z][A-Z0-9]{1,15}(?:-[A-Z][A-Z0-9]{1,15})*-[0-9]{4}$"
    },
    "tier_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "host_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "runtime_model_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9._-]*$",
      "description": "The registry id form the executor code enforces: the runtime id from law/policy/model-runtime-registry.json, a colon, and the host model alias, for example claude-cli:fable or codex-cli:gpt-6-astra."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      ],
      "description": "Shell-free argument vector; the first item is a bare executable name."
    },
    "check_member": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)*$",
      "description": "A check adapter member name or a package script alias."
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "goal",
        "status",
        "records",
        "depends_on",
        "attestation_reissue",
        "owner_effects_required",
        "close_checks",
        "waves"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_round"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["planned", "open", "closing", "closed", "abandoned"],
          "description": "planned: gate not yet satisfied. open: gate satisfied, tasks may start. closing: every task merged, close checks running. closed: close checks passed and closure recorded. abandoned: stopped; disposition required."
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/adr_reference"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id_round"
          },
          "description": "Rounds that must be closed before this one opens. Must be acyclic across the campaign."
        },
        "attestation_reissue": {
          "type": "boolean",
          "description": "true when a task in this round changes test-tasks.json or any input of the task-policy digest, so the RC attestation must be re-issued at close."
        },
        "owner_effects_required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^OE-[0-9]{2,}$"
          }
        },
        "close_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/check_member"
          },
          "description": "Check members that must pass on the merged head in addition to the policy's universal close checks."
        },
        "closure": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["merged_head", "closed_at"],
          "properties": {
            "merged_head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "closed_at": {
              "type": "string",
              "format": "date-time"
            },
            "task_policy_digest": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            },
            "phase_closure": {
              "type": ["string", "null"],
              "pattern": "^PC-[0-9]{4}$"
            }
          }
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        },
        "waves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/wave"
          }
        }
      }
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "records", "depends_on", "lock_scopes", "gates", "tasks"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_wave"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "enum": ["coupled-triplet", "single-role"],
          "description": "coupled-triplet: exactly one architect, one inspector, and one engineer task in pipeline order. single-role: one task."
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/adr_reference"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id_wave"
          },
          "description": "Waves in the same round whose engineer task must be merged before this wave's architect task starts."
        },
        "lock_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "description": "Path prefixes this wave writes. Two waves with an overlapping scope may not be open at the same time."
        },
        "gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/check_member"
          },
          "description": "Check members every task in the wave must pass before pre_merge."
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "discipline",
        "coupled_pipeline_position",
        "upstream_task_id",
        "status",
        "target_substrates",
        "boundary",
        "deliverables",
        "acceptance_commands",
        "commit_types",
        "prompt",
        "pull_request",
        "merged_as",
        "execution"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_task"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "discipline": {
          "enum": ["architect", "inspector", "engineer"],
          "description": "Owner and Auditor never execute campaign tasks; they approve and observe."
        },
        "coupled_pipeline_position": {
          "enum": ["architect", "inspector", "engineer"],
          "description": "Must equal discipline. Position order is architect, inspector, engineer per Constitution Article 24."
        },
        "upstream_task_id": {
          "type": ["string", "null"],
          "pattern": "^TASK-[0-9]{4,}$",
          "description": "null for the architect position; the previous position's task otherwise."
        },
        "status": {
          "enum": [
            "planned",
            "ready",
            "in_progress",
            "checkpoint",
            "pre_merge",
            "merged",
            "blocked",
            "cancelled"
          ],
          "description": "Plan-level projection of the runtime task lifecycle. merged corresponds to the runtime completed state."
        },
        "target_substrates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["F1", "F2", "F3", "F4", "F5"]
          }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths"],
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              },
              "description": "The only paths the task may create, edit, or delete. A path may not yet exist."
            },
            "forbidden": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/relativePath"
              },
              "description": "Paths explicitly called out as off limits because a naive implementation would touch them."
            }
          }
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/argv"
          }
        },
        "commit_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+(?:\\([a-z0-9-]+\\))?$"
          },
          "description": "The commit type and scope pairs the task is expected to produce. A commit outside this list is a review finding."
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "$ref": "#/$defs/relativePath",
              "description": "Path relative to the campaign directory of the task prompt."
            },
            "sha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$",
              "description": "Pinned when the task starts. A later change to the prompt file is drift and requires re-review before merge."
            }
          }
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "pull_request": {
          "type": ["string", "null"],
          "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+$"
        },
        "merged_as": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "effort"],
          "properties": {
            "tier": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "A tier name declared in law/policy/model-tiers.json or in models.tiers of this campaign."
            },
            "effort": {
              "enum": ["low", "medium", "high", "max"]
            },
            "time_budget_minutes": {
              "type": "integer",
              "minimum": 5,
              "description": "Soft budget after which the worker reports partial progress instead of continuing."
            },
            "resolved": {
              "type": "object",
              "additionalProperties": false,
              "required": ["policy_version", "pinned_at", "tiers", "ceiling"],
              "description": "The tier map this task resolved at task_start: the default of law/policy/model-tiers.json merged with the campaign override, every alias in the runtime:model registry id form, with the default policy_version (ADR-MDL-0002). Absent until the task starts. A later change to the default or to the override never reinterprets this task; Article 19 escalation climbs this map.",
              "properties": {
                "policy_version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                  "description": "The policy_version of law/policy/model-tiers.json the map was resolved from."
                },
                "pinned_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "tiers": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": false,
                  "propertyNames": {
                    "$ref": "#/$defs/tier_name"
                  },
                  "patternProperties": {
                    "^[a-z][a-z0-9-]*$": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["rank", "hosts", "default_effort"],
                      "properties": {
                        "rank": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "hosts": {
                          "type": "object",
                          "minProperties": 1,
                          "additionalProperties": false,
                          "propertyNames": {
                            "$ref": "#/$defs/host_id"
                          },
                          "patternProperties": {
                            "^[a-z][a-z0-9-]*$": {
                              "$ref": "#/$defs/runtime_model_id"
                            }
                          },
                          "description": "One resolved registry id per host, keyed by host id."
                        },
                        "default_effort": {
                          "enum": ["low", "medium", "high", "max"]
                        }
                      }
                    }
                  }
                },
                "ceiling": {
                  "$ref": "#/$defs/tier_name",
                  "description": "The escalation ceiling of the pinned map."
                }
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "reply_sha256", "evaluator", "recorded_at"],
          "description": "Present only when the campaign review.mode is model-advisory: the advisory verdict the orchestrator recorded before the human ratified the gate (ADR-GOV-0023). Under model-advisory a task in pre_merge without this block, with a verdict that fails law/schemas/review-verdict.schema.json, or with a digest that does not match the reply cannot transition to merged. The block is advice to the ratifying human; it never satisfies a gate, merges, or authorizes an effect, and the ledger still shows a human actor on the gate, the merge, and every remote effect.",
          "properties": {
            "verdict": {
              "type": "object",
              "additionalProperties": false,
              "required": ["verdict", "confidence", "rationale"],
              "description": "The verdict document extracted from the evaluator reply through the shared extractor, restated member for member from law/schemas/review-verdict.schema.json (ADR-MDL-0001) so the campaign check refuses a partial or foreign document without a cross-file reference; the reply schema stays the contract and this restatement follows it.",
              "properties": {
                "verdict": {
                  "enum": ["pass", "review", "fail", "unknown"]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["severity", "code", "message"],
                    "properties": {
                      "severity": {
                        "enum": ["info", "warning", "error", "critical"]
                      },
                      "code": {
                        "type": "string",
                        "minLength": 1
                      },
                      "message": {
                        "type": "string",
                        "minLength": 1
                      },
                      "file": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            },
            "reply_sha256": {
              "$ref": "#/$defs/sha256",
              "description": "SHA-256 of the full reply bytes the verdict was extracted from."
            },
