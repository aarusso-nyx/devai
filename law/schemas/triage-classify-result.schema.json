{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/triage-classify-result.schema.json",
  "title": "Triage Classify Result",
  "description": "Result envelope payload for deterministic failure classification, its persisted triage artifact, and the appended evidence reference.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "artifact", "evidence_ref"],
  "properties": {
    "verdict": { "$ref": "triage.schema.json" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "kind": { "const": "triage" }
      }
    },
    "evidence_ref": { "type": "string", "pattern": "^EV-[a-f0-9]{16}$" }
  },
  "schema_version": "1.0.0",
  "examples": [
    {
      "verdict": {
        "schemaVersion": "1.0.0",
        "id": "TRG-0123456789abcdef",
        "generated_at": "2026-08-22T00:00:00.000Z",
        "subject_evidence_ref": "EV-0123456789abcdef",
        "classification": "plant_bug",
        "confidence": { "score": 1 },
        "summary": "Plant behavior contradicts the declared invariant.",
        "recommended_route": { "discipline": "engineer" }
      },
      "artifact": {
        "path": ".devai/state/triage/TRG-0123456789abcdef.json",
        "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "kind": "triage"
      },
      "evidence_ref": "EV-0123456789abcdef"
    }
  ]
}
