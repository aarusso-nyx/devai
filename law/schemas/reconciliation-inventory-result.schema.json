{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/reconciliation-inventory-result.schema.json",
  "title": "Seven diagnostic inventory publication result",
  "description": "Closed machine output only. Schema validity, previews and hash strings confer no authority or readiness.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "approval_id",
    "plan_sha256",
    "owned",
    "grants_authority",
    "outcome",
    "intent_sha256",
    "completion_sha256",
    "outputs_manifest_sha256",
    "phase",
    "outputs",
    "publishes_readings",
    "grants_readiness"
  ],
  "properties": {
    "kind": {
      "const": "reconciliation-inventory-result"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "owned": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "dev", "ino", "birthtime_ns"],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "dev": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "ino": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "birthtime_ns": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      }
    },
    "grants_authority": {
      "const": false
    },
    "outcome": {
      "enum": ["completed", "existing", "indeterminate"]
    },
    "intent_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "completion_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "outputs_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase": {
      "const": "04"
    },
    "outputs": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "schema", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "enum": [
              "api-map.schema.json",
              "routes-inventory.schema.json",
              "data-model-inventory.schema.json",
              "rbac-inventory.schema.json",
              "dep-graph.schema.json",
              "coverage-matrix.schema.json"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          }
        }
      }
    },
    "publishes_readings": {
      "const": false
    },
    "grants_readiness": {
      "const": false
    }
  },
  "examples": [
    {
      "approval_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "plan_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "owned": [],
      "grants_authority": false,
      "outcome": "indeterminate",
      "intent_sha256": null,
      "completion_sha256": null,
      "outputs_manifest_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "kind": "reconciliation-inventory-result",
      "phase": "04",
      "outputs": [
        {
          "path": "diagnostic/0.json",
          "schema": "api-map.schema.json",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bytes": 1
        },
        {
          "path": "diagnostic/1.json",
          "schema": "routes-inventory.schema.json",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bytes": 1
        },
        {
          "path": "diagnostic/2.json",
          "schema": "routes-inventory.schema.json",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bytes": 1
        },
        {
          "path": "diagnostic/3.json",
          "schema": "data-model-inventory.schema.json",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bytes": 1
        },
        {
          "path": "diagnostic/4.json",
          "schema": "rbac-inventory.schema.json",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bytes": 1
        },
        {
          "path": "diagnostic/5.json",
          "schema": "dep-graph.schema.json",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bytes": 1
        },
        {
          "path": "diagnostic/6.json",
          "schema": "coverage-matrix.schema.json",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "bytes": 1
        }
      ],
      "publishes_readings": false,
      "grants_readiness": false
    }
  ]
}
