{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/mutation-assurance-policy-v2.schema.json",
  "title": "Mutation assurance policy v2",
  "description": "Additive v2 policy binding mutation assurance results to exact identities. It declares the ten identity classes a report must bind, keeps targeted and full assurance distinct and non-substitutable, forbids a not-required disposition from ever reading as a pass, and permits reuse of a prior result only on an exact match of every declared identity.",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "authority",
    "policy_version",
    "report_schema",
    "supersedes_policy",
    "required_identity_bindings",
    "modes",
    "dispositions",
    "reuse",
    "not_required",
    "thresholds",
    "semantic_verifier",
    "prohibitions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "id": {
      "const": "mutation-assurance-v2"
    },
    "status": {
      "const": "active"
    },
    "authority": {
      "const": "Architect"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "report_schema": {
      "const": "law/schemas/mutation-assurance-v2.schema.json"
    },
    "supersedes_policy": {
      "type": "array",
      "uniqueItems": true,
      "description": "Policies this one extends additively. v2 adds identity binding; it does not relax any v1 pass condition.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required_identity_bindings": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "candidate",
          "source",
          "test",
          "config",
          "toolchain",
          "roster",
          "threshold",
          "sanitizer",
          "orchestration",
          "lockfile"
        ]
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "interchangeable", "targeted", "full"],
      "properties": {
        "declared": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["targeted", "full"]
          }
        },
        "interchangeable": {
          "const": false,
          "description": "A targeted result never discharges a full-roster requirement and a full result never retroactively re-scopes a targeted one."
        },
        "targeted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection_must_be_nonempty", "roster_complete_required", "satisfies"],
          "properties": {
            "selection_must_be_nonempty": {
              "const": true
            },
            "roster_complete_required": {
              "const": false
            },
            "satisfies": {
              "const": "targeted"
            }
          }
        },
        "full": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection_must_be_nonempty", "roster_complete_required", "satisfies"],
          "properties": {
            "selection_must_be_nonempty": {
              "const": true
            },
            "roster_complete_required": {
              "const": true
            },
            "satisfies": {
              "const": "full"
            }
          }
        }
      }
    },
    "dispositions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["disposition", "pass_permitted", "blocks_required_readiness"],
        "properties": {
          "disposition": {
            "enum": ["executed", "reused", "not-required", "failed", "unknown"]
          },
          "pass_permitted": {
            "type": "boolean"
          },
          "blocks_required_readiness": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "enum": ["not-required", "failed", "unknown"]
                }
              },
              "required": ["disposition"]
            },
            "then": {
              "properties": {
                "pass_permitted": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted_when",
        "partial_match_behavior",
        "missing_identity_behavior",
        "cross_mode_reuse"
      ],
      "properties": {
        "permitted_when": {
          "const": "every-required-identity-binding-matches-exactly"
        },
        "partial_match_behavior": {
          "const": "deny"
        },
        "missing_identity_behavior": {
          "const": "deny"
        },
        "cross_mode_reuse": {
          "const": "deny",
          "description": "A targeted report is never reused to satisfy a full requirement."
        }
      }
    },
    "not_required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "requires_typed_reason", "permitted_reasons", "is_pass"],
      "properties": {
        "verdict": {
          "const": "not-applicable"
        },
        "requires_typed_reason": {
          "const": true
        },
        "permitted_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "documentation-only-change",
              "metadata-only-change",
              "no-behavioral-surface-selected"
            ]
          }
        },
        "is_pass": {
          "const": false
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "score_operator", "survived_operator"],
      "properties": {
        "source": {
          "const": "law/policy/thresholds.json#/mutation"
        },
        "score_operator": {
          "const": ">="
        },
        "survived_operator": {
          "const": "<="
        }
      }
    },
    "semantic_verifier": {
      "type": "object",
      "additionalProperties": false,
      "description": "The mandatory recomputation pass over a report. A report can assert a score, a survivor count, and a met threshold in a shape that validates perfectly; validation confirms the assertion is well formed and never that it is true. A pass is established only by recomputing those values from the report's own declared execution artifacts and finding them identical.",
      "required": [
        "kernel_id",
        "mandatory",
        "schema_assertion_establishes_pass",
        "required_report_references",
        "score_model",
        "algorithm",
        "errors"
      ],
      "properties": {
        "kernel_id": {
          "const": "devai.kernel.mutation-assurance-v2.v1"
        },
        "mandatory": {
          "const": true
        },
        "schema_assertion_establishes_pass": {
          "const": false,
          "description": "Article 41: a schema assertion alone never establishes a pass."
        },
        "required_report_references": {
          "const": [
            "mutant-roster",
            "per-mutant-outcome-log",
            "runner-output",
            "score-computation",
            "threshold-snapshot"
          ],
          "description": "The execution artifact kinds a passing report must reference by exact path and digest. A report that names none of them is not independently checkable."
        },
        "score_model": {
          "const": {
            "model": "stryker-detected-over-scored-v1",
            "outcomes": ["killed", "timeout", "survived", "no_coverage", "runtime_error", "infrastructure_error"],
            "detected": "killed-plus-timeout",
            "scored": "detected-plus-survived-plus-no_coverage",
            "score": "scored-equals-zero-question-100-colon-detected-times-100-divided-by-scored",
            "reported_decimal_comparison": "convert-the-json-decimal-to-an-exact-base-10-rational-and-require-equality-to-the-detected-times-100-over-scored-rational-with-no-rounding-and-no-tolerance",
            "thresholds_met": "score-greater-than-or-equal-to-score_min-and-survived-less-than-or-equal-to-survived_max",
            "runtime_or_infrastructure_error": "always-blocks-pass"
          }
        },
        "algorithm": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": false,
          "prefixItems": [
            {
              "const": "resolve-every-declared-execution-artifact-and-recompute-its-sha256"
            },
            {
              "const": "recompute-killed-timeout-survived-no_coverage-runtime_error-and-infrastructure_error-counts-from-the-per-mutant-outcome-log"
            },
            {
              "const": "recompute-detected-as-killed-plus-timeout-and-scored-as-detected-plus-survived-plus-no_coverage"
            },
            {
              "const": "recompute-score-as-scored-equals-zero-question-100-colon-detected-times-100-divided-by-scored-and-compare-as-an-exact-rational-with-no-tolerance"
            },
            {
              "const": "load-the-canonical-thresholds-and-compare-them-to-thresholds_applied"
            },
            {
              "const": "recompute-thresholds_met-as-score-greater-than-or-equal-to-score_min-and-survived-less-than-or-equal-to-survived_max"
            },
            {
              "const": "recompute-verdict-and-block-pass-when-runtime_error-or-infrastructure_error-is-nonzero"
            },
            {
              "const": "reject-pass-when-any-recomputed-value-differs-from-the-reported-value"
            }
          ]
        },
        "errors": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": false,
          "prefixItems": [
            {
              "const": "ma2-execution-artifact-unresolved"
            },
            {
              "const": "ma2-execution-artifact-digest-mismatch"
            },
            {
              "const": "ma2-killed-count-mismatch"
            },
            {
              "const": "ma2-timeout-count-mismatch"
            },
            {
              "const": "ma2-survivor-count-mismatch"
            },
            {
              "const": "ma2-no-coverage-count-mismatch"
            },
            {
              "const": "ma2-runtime-error-count-mismatch"
            },
            {
              "const": "ma2-infrastructure-error-count-mismatch"
            },
            {
              "const": "ma2-score-mismatch"
            },
            {
              "const": "ma2-threshold-source-mismatch"
            },
            {
              "const": "ma2-threshold-value-mismatch"
            },
            {
              "const": "ma2-thresholds-met-mismatch"
            },
            {
              "const": "ma2-verdict-mismatch"
            },
            {
              "const": "ma2-semantic-verification-not-performed"
            }
          ]
        }
      }
    },
    "prohibitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "2.0.0",
      "id": "mutation-assurance-v2",
      "status": "active",
      "authority": "Architect",
      "policy_version": "2.0.0",
      "report_schema": "law/schemas/mutation-assurance-v2.schema.json",
      "supersedes_policy": [],
      "required_identity_bindings": [
        "candidate",
        "source",
        "test",
        "config",
        "toolchain",
        "roster",
        "threshold",
        "sanitizer",
        "orchestration",
        "lockfile"
      ],
      "modes": {
        "declared": ["targeted", "full"],
        "interchangeable": false,
        "targeted": {
          "selection_must_be_nonempty": true,
          "roster_complete_required": false,
          "satisfies": "targeted"
        },
        "full": {
          "selection_must_be_nonempty": true,
          "roster_complete_required": true,
          "satisfies": "full"
        }
      },
      "dispositions": [
        {
          "disposition": "executed",
          "pass_permitted": true,
          "blocks_required_readiness": false
        },
        {
          "disposition": "reused",
          "pass_permitted": true,
          "blocks_required_readiness": false
        },
        {
          "disposition": "not-required",
          "pass_permitted": false,
          "blocks_required_readiness": false
        },
        {
          "disposition": "failed",
          "pass_permitted": false,
          "blocks_required_readiness": true
        },
        {
          "disposition": "unknown",
          "pass_permitted": false,
          "blocks_required_readiness": true
        }
      ],
      "reuse": {
        "permitted_when": "every-required-identity-binding-matches-exactly",
        "partial_match_behavior": "deny",
        "missing_identity_behavior": "deny",
        "cross_mode_reuse": "deny"
      },
      "not_required": {
        "verdict": "not-applicable",
        "requires_typed_reason": true,
        "permitted_reasons": ["documentation-only-change"],
        "is_pass": false
      },
      "thresholds": {
        "source": "law/policy/thresholds.json#/mutation",
        "score_operator": ">=",
        "survived_operator": "<="
      },
      "semantic_verifier": {
        "kernel_id": "devai.kernel.mutation-assurance-v2.v1",
        "mandatory": true,
        "schema_assertion_establishes_pass": false,
        "required_report_references": [
          "mutant-roster",
          "per-mutant-outcome-log",
          "runner-output",
          "score-computation",
          "threshold-snapshot"
        ],
        "score_model": {
          "model": "stryker-detected-over-scored-v1",
          "outcomes": ["killed", "timeout", "survived", "no_coverage", "runtime_error", "infrastructure_error"],
          "detected": "killed-plus-timeout",
          "scored": "detected-plus-survived-plus-no_coverage",
          "score": "scored-equals-zero-question-100-colon-detected-times-100-divided-by-scored",
          "reported_decimal_comparison": "convert-the-json-decimal-to-an-exact-base-10-rational-and-require-equality-to-the-detected-times-100-over-scored-rational-with-no-rounding-and-no-tolerance",
          "thresholds_met": "score-greater-than-or-equal-to-score_min-and-survived-less-than-or-equal-to-survived_max",
          "runtime_or_infrastructure_error": "always-blocks-pass"
        },
        "algorithm": [
          "resolve-every-declared-execution-artifact-and-recompute-its-sha256",
          "recompute-killed-timeout-survived-no_coverage-runtime_error-and-infrastructure_error-counts-from-the-per-mutant-outcome-log",
          "recompute-detected-as-killed-plus-timeout-and-scored-as-detected-plus-survived-plus-no_coverage",
          "recompute-score-as-scored-equals-zero-question-100-colon-detected-times-100-divided-by-scored-and-compare-as-an-exact-rational-with-no-tolerance",
          "load-the-canonical-thresholds-and-compare-them-to-thresholds_applied",
          "recompute-thresholds_met-as-score-greater-than-or-equal-to-score_min-and-survived-less-than-or-equal-to-survived_max",
          "recompute-verdict-and-block-pass-when-runtime_error-or-infrastructure_error-is-nonzero",
          "reject-pass-when-any-recomputed-value-differs-from-the-reported-value"
        ],
        "errors": [
          "ma2-execution-artifact-unresolved",
          "ma2-execution-artifact-digest-mismatch",
          "ma2-killed-count-mismatch",
          "ma2-timeout-count-mismatch",
          "ma2-survivor-count-mismatch",
          "ma2-no-coverage-count-mismatch",
          "ma2-runtime-error-count-mismatch",
          "ma2-infrastructure-error-count-mismatch",
          "ma2-score-mismatch",
          "ma2-threshold-source-mismatch",
          "ma2-threshold-value-mismatch",
          "ma2-thresholds-met-mismatch",
          "ma2-verdict-mismatch",
          "ma2-semantic-verification-not-performed"
        ]
      },
      "prohibitions": ["empty-selection-pass"]
    }
  ]
}
