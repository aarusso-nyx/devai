{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/self-dogfood-policy.schema.json",
  "title": "Constrained self-dogfood policy",
  "description": "Contract for DEVAI running its own governed checks against the DEVAI source repository. Self-consumption is verification configuration only: every run is human-invoked, no run performs autonomous work, no run widens a role, and no run carries publication authority. The role and effect matrix states, per role, exactly which effects a self-dogfood run may initiate; remote-write is forbidden for every role without exception. The check roster and the role rows are frozen by position and by exact value, so a duplicated, reordered, or substituted identifier, effect, or role fails rather than resolving to the entry it resembles. ADR-SCR-0001 admits three sensing actions by addition: sense run with a read effect for every role, and sense record and audit observe with a harness-write effect for the inspector only. The harness-write sensing actions are structurally limited to rows that permit harness-write, and no sensing action carries a remote effect.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "authority",
    "policy_version",
    "scope",
    "invocation",
    "role_widening",
    "publication_authority",
    "permitted_checks",
    "role_effect_matrix",
    "fail_closed"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "self-dogfood"
    },
    "status": {
      "const": "active"
    },
    "authority": {
      "const": "Architect"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "governs_human_maintainers",
        "produces_readiness_claim",
        "adopter_applicability"
      ],
      "properties": {
        "subject": {
          "const": "devai-source-repository"
        },
        "governs_human_maintainers": {
          "const": false,
          "description": "DEVAI does not govern its own development. Maintainers choose scope, review changes, and decide releases."
        },
        "produces_readiness_claim": {
          "const": false,
          "description": "Self-observation is evidence about the harness, never a readiness verdict the harness grants itself."
        },
        "adopter_applicability": {
          "const": "none"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_invoked_only",
        "autonomous_work",
        "scheduled_execution",
        "backlog_dequeue",
        "self_dispatch",
        "unknown_invocation_behavior"
      ],
      "properties": {
        "human_invoked_only": {
          "const": true
        },
        "autonomous_work": {
          "const": "forbidden"
        },
        "scheduled_execution": {
          "const": "forbidden",
          "description": "Article 34: never on a timer. The framework is quiescent when the repository is quiet."
        },
        "backlog_dequeue": {
          "const": "forbidden"
        },
        "self_dispatch": {
          "const": "forbidden"
        },
        "unknown_invocation_behavior": {
          "const": "fail"
        }
      }
    },
    "role_widening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitted", "inference", "elevation", "cross_role_session"],
      "properties": {
        "permitted": {
          "const": false
        },
        "inference": {
          "const": "forbidden",
          "description": "Article 7: DEVAI never infers a role."
        },
        "elevation": {
          "const": "forbidden"
        },
        "cross_role_session": {
          "const": "forbidden"
        }
      }
    },
    "publication_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granted",
        "implied_by_check_pass",
        "implied_by_write_consent",
        "remote_effects"
      ],
      "properties": {
        "granted": {
          "const": false
        },
        "implied_by_check_pass": {
          "const": false
        },
        "implied_by_write_consent": {
          "const": false
        },
        "remote_effects": {
          "const": "forbidden"
        }
      }
    },
    "permitted_checks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": false,
      "description": "The exact check and sensing identifiers a self-dogfood run may execute, in exactly this order, each with exactly the effect and initiator roles frozen here. Check identifiers name repository scripts; the three sensing identifiers (audit observe, sense record, sense run) name registered actions and are keyed by their action id. Anything absent is not permitted by default, and a duplicated, reordered, or substituted identifier fails rather than resolving to the entry it resembles.",
      "prefixItems": [
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "action-registry:check"
            },
            "effect": {
              "const": "read"
            },
            "initiator_roles": {
              "const": ["owner", "architect", "inspector", "engineer", "auditor"]
            }
          }
        },
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "audit observe"
            },
            "effect": {
              "const": "harness-write"
            },
            "initiator_roles": {
              "const": ["inspector"]
            }
          }
        },
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "error-codes:check"
            },
            "effect": {
              "const": "read"
            },
            "initiator_roles": {
              "const": ["owner", "architect", "inspector", "engineer", "auditor"]
            }
          }
        },
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "format:check"
            },
            "effect": {
              "const": "read"
            },
            "initiator_roles": {
              "const": ["owner", "architect", "inspector", "engineer", "auditor"]
            }
          }
        },
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "lint"
            },
            "effect": {
              "const": "read"
            },
            "initiator_roles": {
              "const": ["owner", "architect", "inspector", "engineer", "auditor"]
            }
          }
        },
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "release:closure"
            },
            "effect": {
              "const": "local-write"
            },
            "initiator_roles": {
              "const": ["architect"]
            }
          }
        },
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "release:static-integrity"
            },
            "effect": {
              "const": "read"
            },
            "initiator_roles": {
              "const": ["owner", "architect", "inspector", "engineer", "auditor"]
            }
          }
        },
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "sense record"
            },
            "effect": {
              "const": "harness-write"
            },
            "initiator_roles": {
              "const": ["inspector"]
            },
            "harness_write_paths": {
              "const": [".devai/state/sensor-readings", "record/proofs/chain.json"]
            }
          },
          "required": ["harness_write_paths"]
        },
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "sense run"
            },
            "effect": {
              "const": "read"
            },
            "initiator_roles": {
              "const": ["owner", "architect", "inspector", "engineer", "auditor"]
            }
          }
        },
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "test-task-selectors:check"
            },
            "effect": {
              "const": "read"
            },
            "initiator_roles": {
              "const": ["owner", "architect", "inspector", "engineer", "auditor"]
            }
          }
        },
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "test:schemas"
            },
            "effect": {
              "const": "local-write"
            },
            "initiator_roles": {
              "const": ["inspector"]
            }
          }
        },
        {
          "$ref": "#/$defs/permitted_check",
          "properties": {
            "check_id": {
              "const": "typecheck"
            },
            "effect": {
              "const": "local-write"
            },
            "initiator_roles": {
              "const": ["architect", "engineer"]
            }
          }
        }
      ]
    },
    "role_effect_matrix": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": false,
      "description": "Exactly five rows, one per declared human role, in exactly this order, each carrying exactly the effects and actions frozen here. The matrix is total: a role absent from a row's permitted list may not initiate that effect, and a row that substitutes another role's arrays fails rather than widening quietly.",
      "prefixItems": [
        {
          "$ref": "#/$defs/role_row",
          "properties": {
            "role": {
              "const": "owner"
            },
            "permitted_effects": {
              "const": ["read"]
            },
            "forbidden_effects": {
              "const": ["harness-write", "local-write", "remote-write"]
            },
            "may_initiate": {
              "const": [
                "audit scorecard",
                "catalog actions",
                "doctor",
                "evidence verify",
                "init plan",
                "release offline-verify",
                "release plan",
                "release resume",
                "release status",
                "round status",
                "sense run"
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/role_row",
          "properties": {
            "role": {
              "const": "architect"
            },
            "permitted_effects": {
              "const": ["read", "local-write"]
            },
            "forbidden_effects": {
              "const": ["harness-write", "remote-write"]
            },
            "may_initiate": {
              "const": [
                "audit scorecard",
                "catalog actions",
                "check",
                "doctor",
                "evidence verify",
                "init plan",
                "release offline-verify",
                "release plan",
                "release resume",
                "release status",
                "round status",
                "sense run"
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/role_row",
          "properties": {
            "role": {
              "const": "inspector"
            },
            "permitted_effects": {
              "const": ["read", "harness-write", "local-write"]
            },
            "forbidden_effects": {
              "const": ["remote-write"]
            },
            "may_initiate": {
              "const": [
                "audit observe",
                "audit scorecard",
                "catalog actions",
                "check",
                "doctor",
                "evidence record",
                "evidence verify",
                "init plan",
                "release offline-verify",
                "release plan",
                "release resume",
                "release status",
                "round status",
                "sense record",
                "sense run"
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/role_row",
          "properties": {
            "role": {
              "const": "engineer"
            },
            "permitted_effects": {
              "const": ["read", "local-write"]
            },
            "forbidden_effects": {
              "const": ["harness-write", "remote-write"]
            },
            "may_initiate": {
              "const": [
                "audit scorecard",
                "catalog actions",
                "check",
                "doctor",
                "evidence verify",
                "init plan",
                "release offline-verify",
                "release plan",
                "release resume",
                "release status",
                "round status",
                "sense run"
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/role_row",
          "properties": {
            "role": {
              "const": "auditor"
            },
            "permitted_effects": {
              "const": ["read"]
            },
            "forbidden_effects": {
              "const": ["harness-write", "local-write", "remote-write"]
            },
            "may_initiate": {
              "const": [
                "audit scorecard",
                "catalog actions",
                "doctor",
                "evidence verify",
                "init plan",
                "release offline-verify",
                "release plan",
                "release resume",
                "release status",
                "round status",
                "sense run"
              ]
            }
          }
        }
      ]
    },
    "fail_closed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "$defs": {
    "role": {
      "enum": ["owner", "architect", "inspector", "engineer", "auditor"]
    },
    "permitted_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "effect", "initiator_roles"],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*([: ][a-z0-9][a-z0-9-]*)*$",
          "description": "A repository script identifier (segments joined by ':') or a registered action identifier (words joined by a single space)."
        },
        "effect": {
          "enum": ["read", "harness-write", "local-write"],
          "description": "remote-write is absent from this enum. No self-dogfood check carries a remote effect."
        },
        "initiator_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "harness_write_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(\\.devai/state|record/proofs)(/[A-Za-z0-9._-]+)*$"
          },
          "description": "The repository paths a harness-write check is declared to write, relative to the repository root. ADR-SCR-0008 requires sense record to declare the chain path beside the readings directory, so its two ordered writes (the reading file, then the sense.readings.record chain entry) are both declared harness-writes."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "check_id": {
                "enum": ["sense record", "audit observe"]
              }
            },
            "required": ["check_id"]
          },
          "then": {
            "properties": {
              "effect": {
                "const": "harness-write"
              },
              "initiator_roles": {
                "const": ["inspector"]
              }
            },
            "description": "sense record and audit observe are harness-write actions admitted for the inspector only. Any other effect or initiator set is rejected by the contract itself."
          }
        },
        {
          "if": {
            "properties": {
              "check_id": {
                "const": "sense run"
              }
            },
            "required": ["check_id"]
          },
          "then": {
            "properties": {
              "effect": {
                "const": "read"
              }
            },
            "description": "sense run is admitted with an aggregate effect of read. A population that resolves to a write member is decided by the inspector row at runtime, never by this roster."
          }
        }
      ]
    },
    "role_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "permitted_effects", "forbidden_effects", "may_initiate"],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "permitted_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["read", "harness-write", "local-write"]
          }
        },
        "forbidden_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "remote-write"
          },
          "description": "Every row forbids remote-write. Publication is never a self-dogfood effect.",
          "items": {
            "enum": ["read", "harness-write", "local-write", "remote-write"]
          }
        },
        "may_initiate": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*( [a-z][a-z0-9-]*)*$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "may_initiate": {
                "contains": {
                  "enum": ["sense record", "audit observe"]
                }
              }
            },
            "required": ["may_initiate"]
          },
          "then": {
            "properties": {
              "permitted_effects": {
                "contains": {
                  "const": "harness-write"
                }
              },
              "forbidden_effects": {
                "not": {
                  "contains": {
                    "const": "harness-write"
                  }
                }
              }
            },
            "description": "sense record and audit observe are harness-write actions. A row that lists either must permit harness-write; a row that forbids harness-write cannot list them."
          }
        }
      ]
    }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "id": "self-dogfood",
      "status": "active",
      "authority": "Architect",
      "policy_version": "1.2.0",
