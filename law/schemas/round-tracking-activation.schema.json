{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/round-tracking-activation.schema.json",
  "title": "Round tracking activation",
  "description": "Owner authorization that binds opt-in governance tracking to exactly one governed round. Activation authorizes automatic publication only for validated public-safe events belonging to that round, on that repository, through that exact adapter binding. It is never inferred and never inherited by another round.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "round_id",
    "repository_id",
    "state",
    "adapter",
    "authorization",
    "disclosure_profile",
    "pending_policy"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "round_id": { "type": "string", "pattern": "^R-[0-9]{4,}$" },
    "repository_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "state": {
      "enum": ["active", "frozen", "disabled"],
      "description": "active accepts and projects events; frozen keeps canonical recording and stops projection; disabled ends tracking for the round. Previously published issues and comments are never deleted in any state."
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapter_version",
        "package_version",
        "config_digest_sha256",
        "workflow_digest_sha256"
      ],
      "properties": {
        "id": { "const": "github-issues" },
        "adapter_version": { "$ref": "#/$defs/semver" },
        "package_version": { "$ref": "#/$defs/semver" },
        "config_digest_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Digest of the exact bound adapter configuration. A stale binding invalidates the activation rather than silently re-binding."
        },
        "workflow_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Exact owner/name remote identity. A mismatch against the live binding is a refusal, never a re-target."
        },
        "issue_number": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_session_id", "role", "publish_flag", "authorized_at"],
      "description": "The exact Owner authority under which bounded remote publication was authorized.",
      "properties": {
        "authority_session_id": {
          "type": "string",
          "pattern": "^AUTH-SESSION-[A-Za-z0-9][A-Za-z0-9_-]{15,127}$"
        },
        "role": { "const": "owner" },
        "publish_flag": {
          "const": true,
          "description": "Activation refuses without explicit --publish. Consent is never derived from the presence of a binding."
        },
        "authorized_at": { "type": "string", "format": "date-time" }
      }
    },
    "disclosure_profile": { "const": "public-safe-v1" },
    "pending_policy": {
      "enum": ["freeze", "drain"],
      "description": "Disposition of unprojected events when tracking is disabled. Defaults to freeze; drain performs remote writes and therefore requires its own explicit publication authorization."
    },
    "disabled": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["disabled_at", "authority_session_id", "pending_events"],
      "properties": {
        "disabled_at": { "type": "string", "format": "date-time" },
        "authority_session_id": {
          "type": "string",
          "pattern": "^AUTH-SESSION-[A-Za-z0-9][A-Za-z0-9_-]{15,127}$"
        },
        "pending_events": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$" }
  },
  "schema_version": "1.0.0",
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "round_id": "R-0042",
      "repository_id": "devai",
      "state": "active",
      "adapter": {
        "id": "github-issues",
        "adapter_version": "1.0.0",
        "package_version": "1.3.0",
        "config_digest_sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
        "workflow_digest_sha256": "2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae"
      },
      "target": { "repository": "aarusso-nyx/devai", "issue_number": 123 },
      "authorization": {
        "authority_session_id": "AUTH-SESSION-0f1e2d3c4b5a69788796",
        "role": "owner",
        "publish_flag": true,
        "authorized_at": "2026-08-27T12:00:00.000Z"
      },
      "disclosure_profile": "public-safe-v1",
      "pending_policy": "freeze",
      "disabled": null
    }
  ]
}
