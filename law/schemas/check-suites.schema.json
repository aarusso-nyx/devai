{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/check-suites.schema.json",
  "title": "DEVAI check-suite policy",
  "description": "Closed Architect-owned ordered check-suite descriptors and their executable member definitions.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "status",
    "authority",
    "ordering",
    "unknown_behavior",
    "prerequisites",
    "suites",
    "member_definitions"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/check-suites.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "check-suites"
    },
    "status": {
      "const": "active"
    },
    "authority": {
      "const": "Architect"
    },
    "ordering": {
      "const": "members-execute-in-declared-order-without-coalescing"
    },
    "unknown_behavior": {
      "const": "error-never-pass"
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "suites": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "prefixItems": [
        {
          "$ref": "#/$defs/quick"
        },
        {
          "$ref": "#/$defs/standard"
        },
        {
          "$ref": "#/$defs/full"
        },
        {
          "$ref": "#/$defs/release"
        }
      ],
      "items": false
    },
    "member_definitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "members", "excluded"],
      "properties": {
        "name": {
          "enum": ["quick", "standard", "full", "release"]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        }
      }
    },
    "quick": {
      "allOf": [
        {
          "$ref": "#/$defs/suite"
        },
        {
          "if": true,
          "then": {
            "properties": {
              "name": {
                "const": "quick"
              }
            }
          }
        }
      ]
    },
    "standard": {
      "allOf": [
        {
          "$ref": "#/$defs/suite"
        },
        {
          "if": true,
          "then": {
            "properties": {
              "name": {
                "const": "standard"
              }
            }
          }
        }
      ]
    },
    "full": {
      "allOf": [
        {
          "$ref": "#/$defs/suite"
        },
        {
          "if": true,
          "then": {
            "properties": {
              "name": {
                "const": "full"
              }
            }
          }
        }
      ]
    },
    "release": {
      "allOf": [
        {
          "$ref": "#/$defs/suite"
        },
        {
          "if": true,
          "then": {
            "properties": {
              "name": {
                "const": "release"
              }
            }
          }
        }
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "binding", "effect", "cost", "output"],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["package-script", "action", "runtime-gate", "test-file", "literal-argv"]
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "gate_id": {
              "$ref": "#/$defs/token"
            }
          },
          "oneOf": [
            {
              "required": ["argv"],
              "not": {
                "required": ["gate_id"]
              }
            },
            {
              "required": ["gate_id"],
              "not": {
                "required": ["argv"]
              }
            }
          ]
        },
        "effect": {
          "enum": ["read", "harness-write", "local-write", "remote-write"]
        },
        "cost": {
          "enum": ["low", "medium", "high"]
        },
        "output": {
          "$ref": "#/$defs/token"
        }
      }
    }
  },
  "examples": [{}]
}
