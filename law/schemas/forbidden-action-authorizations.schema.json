{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/forbidden-action-authorizations.schema.json",
  "title": "Forbidden Action Authorizations",
  "description": "Exact-commit human authorization receipts for forbidden-action findings. Receipts are additive and never weaken the canonical registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorizations"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["forbidden_id", "commit", "authorized_by", "reason"],
        "properties": {
          "forbidden_id": {
            "type": "string",
            "pattern": "^FORBID-[A-Z][A-Z0-9_-]*$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "authorized_by": {
            "const": "Owner"
          },
          "reason": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    }
  }
}
