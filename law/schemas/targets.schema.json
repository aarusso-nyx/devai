{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/targets.schema.json",
  "title": "Sensor targets",
  "description": "Architect-authored performance or robustness targets for one repository, stored at law/targets/performance.json and law/targets/robustness.json (ADR-SCR-0004). Every target names a sensor kind registered in law/policy/sensor-registry.json, a metric that sensor emits (a key of the reading's metrics map, or the reading-level duration_ms), a comparator and a numeric threshold, and the invariants the target makes measurable. A target is a setpoint the spec performance and robustness sensors read; it never overrides a sensor's own threshold.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "title", "status", "authority", "date", "targets"],
  "$defs": {
    "invariant_ref": {
      "$ref": "common-defs.schema.json#/$defs/id_invariant"
    },
    "decision_ref": {
      "type": "string",
      "pattern": "^ADR-(?:[0-9]{3}|[A-Z]{3}-[0-9]{4})$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "subject",
        "statement",
        "sensor_kind",
        "metric",
        "metric_source",
        "comparator",
        "threshold",
        "unit",
        "invariants",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TGT-(?:PERF|ROB)-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "The process or artifact the target bounds, for example the check runner, the sweep, or the release candidate."
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "One measurable sentence: the metric, the comparator, and the threshold in words."
        },
        "sensor_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "A kind registered in law/policy/sensor-registry.json."
        },
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "The metric the sensor emits under the named source."
        },
        "metric_source": {
          "enum": ["metrics", "reading"],
          "description": "metrics: a key of SensorReading.metrics. reading: a numeric top-level SensorReading field such as duration_ms."
        },
        "comparator": {
          "enum": ["lte", "gte", "eq"]
        },
        "threshold": {
          "type": "number"
        },
        "unit": {
          "enum": ["ms", "percent", "count", "boolean"]
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/invariant_ref"
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doc", "anchor"],
          "properties": {
            "doc": {
              "type": "string",
              "minLength": 1
            },
            "anchor": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "The constitution article or accepted decision the target derives from, as a resolvable heading anchor."
        },
        "decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/decision_ref"
          }
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "const": "../schemas/targets.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "kind": {
      "enum": ["performance", "robustness"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["draft", "active"]
    },
    "authority": {
      "const": "Architect"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "id": "performance",
      "kind": "performance",
      "title": "Example performance targets",
      "status": "active",
      "authority": "Architect",
      "date": "2026-09-27",
      "targets": [
        {
          "id": "TGT-PERF-001",
          "title": "Check runner median wall time",
          "subject": "check runner",
          "statement": "The median wall time of successful check-runner workflow runs on main is at most 600000 ms.",
          "sensor_kind": "harness_performance",
          "metric": "median_ms",
          "metric_source": "metrics",
          "comparator": "lte",
          "threshold": 600000,
          "unit": "ms",
          "invariants": ["INV-PERF-001"],
          "source": {
            "doc": "law/constitution.md",
            "anchor": "article-16-cycles"
          }
        }
      ]
    }
  ]
}
