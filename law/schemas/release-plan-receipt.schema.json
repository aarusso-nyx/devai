{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/release-plan-receipt.schema.json",
  "title": "Release plan receipt",
  "description": "The deterministic document emitted to stdout by release plan. It resolves the lifecycle plan for one exact candidate from pinned inputs and writes nothing: no state record, no evidence, no receipt file. It observes the derived state planned, which is never persisted. The receipt grants no authority, no publication consent, and no lifecycle transition; a later mutating action may bind it as checkable evidence by exact digest, and binding it is not the same as being permitted by it.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receipt_kind",
    "canonicalization",
    "receipt_id",
    "state_observed",
    "verdict",
    "repository",
    "candidate",
    "inputs",
    "plan",
    "determination",
    "verification_kernel",
    "emitted_by",
    "grants",
    "determinism",
    "receipt_digest_sha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "receipt_kind": {
      "const": "release-plan-receipt"
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel_id", "encoding", "json_form", "digest_algorithm", "receipt_projection_excludes", "calculation_order"],
      "properties": {
        "kernel_id": {"const": "devai.kernel.release-plan-receipt-canonicalization.v1"},
        "encoding": {"const": "utf-8"},
        "json_form": {"const": "rfc8785-jcs"},
        "digest_algorithm": {"const": "sha256"},
        "receipt_projection_excludes": {"const": ["receipt_id", "receipt_digest_sha256"]},
        "calculation_order": {"const": ["compute-receipt_digest_sha256-over-the-receipt-projection", "derive-receipt_id-as-RPL-hyphen-plus-the-first-16-lowercase-hex-characters-of-receipt_digest_sha256"]}
      }
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^RPL-[0-9a-f]{16}$",
      "description": "Content-derived identity: canonical sha256 over every field of this receipt except receipt_id and receipt_digest_sha256, truncated to 16 hex characters."
    },
    "state_observed": {
      "type": ["string", "null"],
      "enum": [null, "planned"],
      "description": "A derived state. It exists in this receipt and never in a state record. Null when the plan could not be resolved."
    },
    "verdict": {
      "enum": ["pass", "block"],
      "description": "block means the plan could not be resolved from the bound inputs. A blocked receipt is not bindable by any mutating action."
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "inputs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": false,
      "description": "The exact ordered four-input plan contract. Each digest is over the UTF-8 RFC 8785 canonical JSON bytes of the resolved document.",
      "prefixItems": [
        {"$ref": "#/$defs/input", "required": ["inline_document"], "properties": {"kind": {"const": "release-intent"}, "source": {"const": "invocation-provided-release-intent-document"}, "schema": {"const": "law/schemas/release-intent.schema.json"}, "inline_document": {"$ref": "release-intent.schema.json"}}},
        {"$ref": "#/$defs/input", "not": {"required": ["inline_document"]}, "properties": {"kind": {"const": "release-verification-profile"}, "source": {"const": "law/policy/release-verification.json"}, "schema": {"const": "law/schemas/release-verification-profile.schema.json"}, "path": {"const": "law/policy/release-verification.json"}}},
        {"$ref": "#/$defs/input", "not": {"required": ["inline_document"]}, "properties": {"kind": {"const": "release-lifecycle-policy"}, "source": {"const": "law/policy/release-lifecycle.json"}, "schema": {"const": "law/schemas/release-lifecycle-policy.schema.json"}, "path": {"const": "law/policy/release-lifecycle.json"}}},
        {"$ref": "#/$defs/input", "not": {"required": ["inline_document"]}, "properties": {"kind": {"const": "action-registry-policy"}, "source": {"const": "law/policy/action-registry.json"}, "schema": {"const": "law/schemas/action-registry.schema.json"}, "path": {"const": "law/policy/action-registry.json"}}}
      ]
    },
    "plan": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": false,
      "description": "All nine lifecycle actions in order, each with the state it produces and the state it derives stated explicitly. A step that produces nothing derives something, and the plan says which: an action whose outcome is left unstated is the gap a later reader fills with an assumption.",
      "prefixItems": [
        {
          "$ref": "#/$defs/plan_step",
          "properties": {
            "order": {
              "const": 1
            },
            "action_id": {
              "const": "release plan"
            },
            "produces_state": {
              "type": "null"
            },
            "derives_state": {
              "const": "planned"
            }
          }
        },
        {
          "$ref": "#/$defs/plan_step",
          "properties": {
            "order": {
              "const": 2
            },
            "action_id": {
              "const": "release preflight"
            },
            "produces_state": {
              "const": "preflight_passed"
            },
            "derives_state": {
              "type": "null"
            }
          }
        },
        {
          "$ref": "#/$defs/plan_step",
          "properties": {
            "order": {
              "const": 3
            },
            "action_id": {
              "const": "release certify"
            },
            "produces_state": {
              "const": "certified"
            },
            "derives_state": {
              "type": "null"
            }
          }
        },
        {
          "$ref": "#/$defs/plan_step",
          "properties": {
            "order": {
              "const": 4
            },
            "action_id": {
              "const": "release prepare"
            },
            "produces_state": {
              "const": "prepared"
            },
            "derives_state": {
              "type": "null"
            }
          }
        },
        {
          "$ref": "#/$defs/plan_step",
          "properties": {
            "order": {
              "const": 5
            },
            "action_id": {
              "const": "release export"
            },
            "produces_state": {
              "const": "exported"
            },
            "derives_state": {
              "type": "null"
            }
          }
        },
        {
          "$ref": "#/$defs/plan_step",
          "properties": {
            "order": {
              "const": 6
            },
            "action_id": {
              "const": "release offline-verify"
            },
            "produces_state": {
              "type": "null"
            },
            "derives_state": {
              "const": "offline_verified"
            }
          }
        },
        {
          "$ref": "#/$defs/plan_step",
          "properties": {
            "order": {
              "const": 7
            },
            "action_id": {
              "const": "release evidence-publish"
            },
            "produces_state": {
              "const": "evidence_published"
            },
            "derives_state": {
              "type": "null"
            }
          }
        },
        {
          "$ref": "#/$defs/plan_step",
          "properties": {
            "order": {
              "const": 8
            },
            "action_id": {
              "const": "release publish"
            },
            "produces_state": {
              "const": "publication_dispatched",
              "description": "A dispatch is not an outcome. No step of any plan produces published."
            },
            "derives_state": {
              "type": "null"
            }
          }
        },
        {
          "$ref": "#/$defs/plan_step",
          "properties": {
            "order": {
              "const": 9
            },
            "action_id": {
              "const": "release resume"
            },
            "produces_state": {
              "type": "null"
            },
            "derives_state": {
              "const": "published"
            }
          }
        }
      ]
    },
    "determination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_verdict", "transition", "support", "impact", "risk_classes", "capabilities", "mutation", "mutation_disposition", "blocking_reasons"],
      "description": "The classifications the plan was resolved under, each recomputable from the bound inputs. They are reported so the semantic kernel can recompute them; a receipt that only asserts them asserts something nobody can check.",
      "properties": {
        "profile_verdict": {"enum": ["ready", "block"]},
        "transition": {
          "enum": ["patch", "minor", "major", "prerelease", "support-promotion"],
          "description": "Recomputed from the release intent's current_version and target_version. A declared bump that disagrees with the versions is a mismatch, not an override."
        },
        "support": {
          "enum": ["preview", "current", "lts"]
        },
        "impact": {
          "enum": ["documentation", "metadata", "behavioral"]
        },
        "risk_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
        },
        "mutation": {"enum": ["none", "affected", "targeted", "full-roster"]},
        "mutation_disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["required", "not-required", "blocked"]},
            "reason": {"type": "string", "minLength": 1, "maxLength": 200}
          }
        },
        "blocking_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "verification_kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_id",
        "mandatory",
        "determination_contract",
        "schema_assertion_establishes_pass",
        "algorithm",
        "errors"
      ],
      "description": "The named kernel that must recompute this receipt before any action binds it. A receipt is a claim about a deterministic computation; the only way to believe it is to redo the computation.",
      "properties": {
        "kernel_id": {
          "const": "devai.kernel.release-plan-receipt.v1"
        },
        "mandatory": {
          "const": true
        },
        "determination_contract": {
          "const": "law/policy/release-lifecycle.json#/plan_determination"
        },
        "schema_assertion_establishes_pass": {
          "const": false,
          "description": "This receipt validating against this schema is not a pass verdict. A verdict of pass that the kernel cannot reproduce is rejected."
        },
        "algorithm": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": false,
          "prefixItems": [
            {
              "const": "resolve-every-declared-input-and-recompute-its-sha256"
            },
            {
              "const": "require-the-exact-four-ordered-input-kinds-sources-schemas-paths-and-utf-8-rfc8785-jcs-sha256-digests-declared-by-plan_determination"
            },
            {
              "const": "recompute-profile_verdict-transition-support-impact-risk_classes-capabilities-mutation-mutation_disposition-and-blocking_reasons-under-plan_determination-and-compare-to-determination"
            },
            {
              "const": "recompute-the-nine-ordered-plan-steps-from-the-lifecycle-policy-and-compare-to-plan"
            },
            {
              "const": "recompute-receipt_digest_sha256-under-devai.kernel.release-plan-receipt-canonicalization.v1"
            },
            {
              "const": "recompute-receipt_id-as-RPL-hyphen-plus-the-first-16-lowercase-hex-characters-of-the-recomputed-receipt-digest"
            },
            {
              "const": "reject-pass-when-any-recomputed-value-differs-from-the-reported-value"
            }
          ]
        },
        "errors": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": false,
          "prefixItems": [
            {
              "const": "rpl-input-unresolved"
            },
            {
              "const": "rpl-input-digest-mismatch"
            },
            {
              "const": "rpl-input-set-mismatch"
            },
            {
              "const": "rpl-determination-mismatch"
            },
            {
              "const": "rpl-plan-mismatch"
            },
            {
              "const": "rpl-receipt-digest-mismatch"
            },
            {
              "const": "rpl-receipt-id-mismatch"
            },
            {
              "const": "rpl-semantic-verification-not-performed"
            }
          ]
        }
      }
    },
    "emitted_by": {
      "$ref": "#/$defs/pure_read_emitter"
    },
    "grants": {
      "$ref": "#/$defs/grants_nothing"
    },
    "determinism": {
      "$ref": "#/$defs/determinism"
    },
    "receipt_digest_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "Canonical digest of this receipt with receipt_id and this field omitted. Identity and integrity only; it is never a capability."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "state_observed": {
            "const": "planned"
          }
        }
      },
      "else": {
        "properties": {
          "state_observed": {
            "type": "null",
            "description": "A blocked plan observes no state. It is a reason to stop, never a weaker plan."
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "$ref": "common-defs.schema.json#/$defs/sha256"
    },
    "git_object": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[*?])[^\\u0000]+$"
    },
    "persisted_state": {
      "enum": [
        "preflight_passed",
        "certified",
        "prepared",
        "exported",
        "evidence_published",
        "publication_dispatched"
      ]
    },
    "derived_state": {
      "enum": ["planned", "offline_verified", "published"]
    },
    "plan_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "action_id", "produces_state", "derives_state"],
      "description": "One lifecycle action and its exact outcome. produces_state names the record it appends; derives_state names the state a receipt lets a reader observe. Exactly one of the two is non-null for every action.",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "action_id": {
          "$ref": "#/$defs/lifecycle_action"
        },
        "produces_state": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/persisted_state"
            }
          ]
        },
        "derives_state": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/derived_state"
            }
          ]
        }
      }
    },
    "lifecycle_action": {
      "enum": [
        "release plan",
        "release preflight",
        "release certify",
        "release prepare",
        "release export",
        "release offline-verify",
        "release evidence-publish",
        "release publish",
        "release resume"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "commit", "tree"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
        },
        "commit": {
          "$ref": "#/$defs/git_object"
        },
        "tree": {
          "$ref": "#/$defs/git_object"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_unit", "version", "commit", "tree"],
      "properties": {
        "release_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "commit": {
          "$ref": "#/$defs/git_object"
        },
        "tree": {
          "$ref": "#/$defs/git_object"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "schema", "path", "canonical_bytes", "sha256"],
      "properties": {
        "kind": {
          "enum": [
            "release-intent",
            "release-verification-profile",
            "release-lifecycle-policy",
            "action-registry-policy"
          ]
        },
        "source": {"type": "string", "minLength": 1, "maxLength": 500},
        "schema": {"type": "string", "minLength": 1, "maxLength": 500},
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "canonical_bytes": {"const": "utf-8-rfc8785-jcs"},
        "inline_document": {"type": "object"},
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pure_read_emitter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "effect",
        "output_channel",
        "persists_repository_state",
        "appends_state_record",
        "writes_receipt_file"
      ],
      "properties": {
        "action_id": {
          "const": "release plan"
        },
        "effect": {
          "const": "read"
        },
        "output_channel": {
          "const": "stdout"
        },
        "persists_repository_state": {
          "const": false
        },
        "appends_state_record": {
          "const": false
        },
        "writes_receipt_file": {
          "const": false
        }
      }
    },
    "grants_nothing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "publication_authority",
        "lifecycle_transition",
        "satisfies_state"
      ],
      "properties": {
        "authority": {
          "const": false
        },
        "publication_authority": {
          "const": false
        },
        "lifecycle_transition": {
          "const": false
        },
        "satisfies_state": {
          "const": false,
          "description": "A receipt never stands in for a state it did not produce."
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "derived_from_bound_inputs_only",
        "contains_wall_clock_time"
      ],
      "properties": {
        "deterministic": {
          "const": true,
          "description": "Identical bound inputs produce identical receipt bytes."
        },
        "derived_from_bound_inputs_only": {
          "const": true
        },
        "contains_wall_clock_time": {
          "const": false,
          "description": "No emission timestamp. A field that varies per invocation would make two receipts over one candidate incomparable."
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "receipt_kind": "release-plan-receipt",
      "canonicalization": {
        "kernel_id": "devai.kernel.release-plan-receipt-canonicalization.v1",
        "encoding": "utf-8",
        "json_form": "rfc8785-jcs",
        "digest_algorithm": "sha256",
        "receipt_projection_excludes": ["receipt_id", "receipt_digest_sha256"],
        "calculation_order": ["compute-receipt_digest_sha256-over-the-receipt-projection", "derive-receipt_id-as-RPL-hyphen-plus-the-first-16-lowercase-hex-characters-of-receipt_digest_sha256"]
      },
      "receipt_id": "RPL-b0d5ce2dbb6e9667",
      "state_observed": "planned",
      "verdict": "pass",
      "repository": {
        "id": "aarusso-nyx/devai",
        "commit": "5461ba500000000000000000000000000000aaaa",
        "tree": "2cad519aba8117a1850eee85d41eae452d51a141"
      },
      "candidate": {
        "release_unit": "@aarusso-nyx/devai",
        "version": "1.5.0",
        "commit": "5461ba500000000000000000000000000000aaaa",
        "tree": "2cad519aba8117a1850eee85d41eae452d51a141"
      },
      "inputs": [
        {
          "kind": "release-intent",
          "source": "invocation-provided-release-intent-document",
          "schema": "law/schemas/release-intent.schema.json",
          "path": "release-intent.json",
          "canonical_bytes": "utf-8-rfc8785-jcs",
          "inline_document": {
            "schemaVersion": "1.0.0",
            "release_unit": "@aarusso-nyx/devai",
            "current_version": "1.4.5",
            "target_version": "1.5.0",
            "support": "current",
            "support_promotion": false,
            "change_kind": "behavioral",
            "changed_paths": ["law/policy/release-lifecycle.json"],
            "changed_packages": ["@aarusso-nyx/devai"],
            "risks": ["release-integrity"],
            "owner_escalations": [],
            "candidate": {"commit": "5461ba500000000000000000000000000000aaaa", "tree": "2cad519aba8117a1850eee85d41eae452d51a141"},
            "base": {"commit": "37e75a5c27569d4cb3fdb4a3dc97a140da4d78de", "tree": "1111111111111111111111111111111111111111"}
          },
          "sha256": "96c991f919212bd4516996b1359fbd20078a1e5be0212a0ada9eee3b4d06d6bd"
        },
        {
          "kind": "release-verification-profile",
          "source": "law/policy/release-verification.json",
          "schema": "law/schemas/release-verification-profile.schema.json",
          "path": "law/policy/release-verification.json",
          "canonical_bytes": "utf-8-rfc8785-jcs",
          "sha256": "d116fe46b30c6bde0523a22a28aab6c8a7a8212ebcab884a51b5bd8d12454f11"
        },
        {
          "kind": "release-lifecycle-policy",
          "source": "law/policy/release-lifecycle.json",
          "schema": "law/schemas/release-lifecycle-policy.schema.json",
          "path": "law/policy/release-lifecycle.json",
          "canonical_bytes": "utf-8-rfc8785-jcs",
          "sha256": "de93ffd12e8aa4cb3c15a47223d0d3d9f525b7e69c72af7470c9100f6fdf2f64"
        },
        {
          "kind": "action-registry-policy",
          "source": "law/policy/action-registry.json",
          "schema": "law/schemas/action-registry.schema.json",
          "path": "law/policy/action-registry.json",
          "canonical_bytes": "utf-8-rfc8785-jcs",
          "sha256": "5c40603c65ca0a263c11a9d02f297782711b7fb67ac8ff0ae5ae68a72ffbf06f"
        }
      ],
      "plan": [
        {
          "order": 1,
          "action_id": "release plan",
          "produces_state": null,
          "derives_state": "planned"
        },
        {
          "order": 2,
          "action_id": "release preflight",
          "produces_state": "preflight_passed",
          "derives_state": null
        },
        {
          "order": 3,
          "action_id": "release certify",
          "produces_state": "certified",
          "derives_state": null
        },
        {
          "order": 4,
          "action_id": "release prepare",
          "produces_state": "prepared",
          "derives_state": null
        },
        {
          "order": 5,
          "action_id": "release export",
          "produces_state": "exported",
          "derives_state": null
        },
        {
          "order": 6,
