{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/release-verification-profile.schema.json",
  "title": "Release verification profile",
  "description": "Adopter-owned mapping from generic release risks and capabilities to repository task nodes and mutation evidence selectors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy_id",
    "policy_version",
    "release_unit",
    "version_source",
    "default_support",
    "capability_tasks",
    "risk_capabilities",
    "mutation_roster"
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0"] },
    "policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
    "policy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "release_unit": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version_source": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$",
      "maxLength": 500
    },
    "default_support": { "enum": ["preview", "current", "lts"] },
    "required_check": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Stable external CI status name; internal selected task nodes may vary."
    },
    "capability_tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$" }
      }
    },
    "risk_capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
      }
    },
    "mutation_roster": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package",
          "task_node",
          "source_selectors",
          "test_selectors",
          "manifest_path",
          "config_paths",
          "sanitizer_paths",
          "orchestration_paths",
          "lockfile_path",
          "toolchain_keys",
          "thresholds"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$" },
          "package": { "type": "string", "minLength": 1, "maxLength": 200 },
          "task_node": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]*$"
          },
          "risk_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
          },
          "source_selectors": { "$ref": "#/$defs/pathList" },
          "test_selectors": { "$ref": "#/$defs/pathList" },
          "manifest_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
          },
          "config_paths": { "$ref": "#/$defs/pathList" },
          "sanitizer_paths": { "$ref": "#/$defs/pathList" },
          "orchestration_paths": { "$ref": "#/$defs/pathList" },
          "lockfile_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
          },
          "toolchain_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
          },
          "thresholds": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "mutation_execution": {
      "$ref": "#/$defs/devaiProtectedMutationExecution"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1.1.0" } },
        "required": ["schemaVersion"]
      },
      "then": { "required": ["mutation_execution"] }
    },
    {
      "if": {
        "properties": {
          "mutation_execution": {
            "properties": { "template_id": { "const": "devai.protected-mutation-stryker.v1" } },
            "required": ["template_id"]
          }
        },
        "required": ["mutation_execution"]
      },
      "then": {
        "properties": {
          "release_unit": { "const": "@aarusso-nyx/devai" },
          "mutation_roster": {
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "properties": {
                "thresholds": {
                  "const": { "score_min": 60, "survived_max": 50 }
                }
              },
              "required": ["thresholds"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "devaiProtectedMutationExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "template_id",
        "runner",
        "selection",
        "roster_order",
        "output",
        "threshold_projection",
        "toolchain_fixture_validation"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "template_id": { "const": "devai.protected-mutation-stryker.v1" },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "package_manager", "packages", "vitest_peer_range"],
          "properties": {
            "kind": { "const": "stryker-vitest-typescript" },
            "package_manager": { "const": "pnpm" },
            "packages": {
              "const": [
                { "name": "@stryker-mutator/core", "version": "9.6.1" },
                { "name": "@stryker-mutator/typescript-checker", "version": "9.6.1" },
                { "name": "@stryker-mutator/vitest-runner", "version": "9.6.1" }
              ]
            },
            "vitest_peer_range": { "const": ">=2" }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package_root",
            "source",
            "tests",
            "lockfile",
            "configuration",
            "invocation"
          ],
          "properties": {
            "package_root": { "const": "parent-of-roster.manifest_path" },
            "source": { "const": "roster.source_selectors" },
            "tests": { "const": "roster.test_selectors" },
            "lockfile": { "const": "roster.lockfile_path" },
            "configuration": { "const": "host-derived-ephemeral-from-roster-only" },
            "invocation": { "const": "fixed-host-template-not-profile-or-candidate-script" }
          }
        },
        "roster_order": { "const": "id-lexicographic" },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "normalized_report", "package_result", "finalization"],
          "properties": {
            "raw": { "const": "protected-container-only" },
            "normalized_report": { "const": "mutation-normalized-stryker-report-v2" },
            "package_result": { "const": "mutation-package-result-v2" },
            "finalization": {
              "const": "verify-mutation-evidence-v21-before-certification-evidence-retention"
            }
          }
        },
        "threshold_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "target"],
          "properties": {
            "source": { "const": "roster.thresholds.score_min-and-survived_max" },
            "target": {
              "const": {
                "break": "score_min",
                "high": "score_min",
                "low": "score_min",
                "scoreMin": "score_min",
                "survivedMax": "survived_max"
              }
            }
          }
        },
        "toolchain_fixture_validation": {
          "const": "pending-engineer-pinned-toolchain-fixture-validation-before-protected-invocation"
        }
      }
    },
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
      }
    }
  }
}
