{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/reconciliation-owner-action.schema.json",
  "title": "Native Owner reconciliation exchange",
  "description": "Closed machine output only. Schema validity, previews and hash strings confer no authority or readiness.",
  "schema_version": "1.0.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "approval_id",
        "plan_sha256",
        "confirmation",
        "lifetime_ms",
        "grants_authority",
        "action_id",
        "source_manifest_sha256",
        "effect_plan_sha256",
        "approval_sha256",
        "approval_bytes",
        "issuer_sha256",
        "namespace_sha256",
        "effects"
      ],
      "properties": {
        "kind": {
          "const": "reconciliation-approval-review"
        },
        "approval_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "confirmation": {
          "type": "string",
          "minLength": 1
        },
        "lifetime_ms": {
          "const": 300000
        },
        "grants_authority": {
          "const": false
        },
        "action_id": {
          "const": "evidence reconcile approve"
        },
        "source_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "effect_plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approval_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approval_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "issuer_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "namespace_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "operation", "mode"],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": ["0600", "0700"]
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "approval_id",
        "plan_sha256",
        "confirmation",
        "lifetime_ms",
        "grants_authority",
        "operation",
        "prior_grant_sha256",
        "record_sha256",
        "record_bytes",
        "sequence",
        "namespace_sha256",
        "effects"
      ],
      "properties": {
        "kind": {
          "const": "reconciliation-grant-review"
        },
        "approval_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "confirmation": {
          "type": "string",
          "minLength": 1
        },
        "lifetime_ms": {
          "const": 300000
        },
        "grants_authority": {
          "const": false
        },
        "operation": {
          "enum": ["renew", "revoke"]
        },
        "prior_grant_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 2
        },
        "namespace_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "operation", "mode"],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "const": "0600"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "approval_id",
        "plan_sha256",
        "confirmation",
        "lifetime_ms",
        "grants_authority",
        "expected_lease_sha256",
        "lease_witness",
        "effects"
      ],
      "properties": {
        "kind": {
          "const": "reconciliation-dead-lease-review"
        },
        "approval_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "confirmation": {
          "type": "string",
          "minLength": 1
        },
        "lifetime_ms": {
          "const": 300000
        },
        "grants_authority": {
          "const": false
        },
        "expected_lease_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "const": "ABSENT"
            }
          ]
        },
        "lease_witness": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["dev", "ino", "birthtime_ns"],
              "properties": {
                "dev": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "ino": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "birthtime_ns": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "operation"],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "approval_id",
        "plan_sha256",
        "owned",
        "grants_authority",
        "action_id",
        "outcome",
        "approval_sha256"
      ],
      "properties": {
        "kind": {
          "const": "reconciliation-approval-result"
        },
        "approval_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "owned": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "dev", "ino", "birthtime_ns"],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "dev": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "ino": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "birthtime_ns": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            }
          }
        },
        "grants_authority": {
          "const": false
        },
        "action_id": {
          "const": "evidence reconcile approve"
        },
        "outcome": {
          "enum": ["approved", "cancelled", "indeterminate"]
        },
        "approval_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "approval_id",
        "plan_sha256",
        "owned",
        "grants_authority",
        "operation",
        "outcome",
        "record_sha256",
        "sequence"
      ],
      "properties": {
        "kind": {
          "const": "reconciliation-grant-result"
        },
        "approval_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "owned": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "dev", "ino", "birthtime_ns"],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "dev": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "ino": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "birthtime_ns": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            }
          }
        },
        "grants_authority": {
          "const": false
        },
        "operation": {
          "enum": ["renew", "revoke"]
        },
        "outcome": {
          "enum": ["renewed", "revoked", "cancelled", "indeterminate"]
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "approval_id",
        "plan_sha256",
        "outcome",
        "expected_lease_sha256",
        "lease_witness",
        "grants_authority"
      ],
      "properties": {
        "kind": {
          "const": "reconciliation-dead-lease-result"
        },
        "approval_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outcome": {
          "enum": ["recovered", "absent", "cancelled", "indeterminate"]
        },
        "expected_lease_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "const": "ABSENT"
            }
          ]
        },
        "lease_witness": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["dev", "ino", "birthtime_ns"],
              "properties": {
                "dev": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "ino": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "birthtime_ns": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "grants_authority": {
          "const": false
        }
      }
    }
  ],
  "examples": [
    {
      "kind": "reconciliation-dead-lease-result",
      "approval_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "plan_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "outcome": "cancelled",
      "expected_lease_sha256": "ABSENT",
      "lease_witness": null,
      "grants_authority": false
    }
  ]
}
