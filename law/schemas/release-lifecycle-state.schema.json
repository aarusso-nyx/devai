{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/release-lifecycle-state.schema.json",
  "title": "Release lifecycle state record",
  "description": "One appended release lifecycle state transition. Only the six persisted states are appendable: preflight_passed, certified, prepared, exported, evidence_published, and publication_dispatched. The three derived states are never persisted, so a record naming planned, offline_verified, or published is rejected. Every record binds exact repository, candidate, input, evidence, artifact, and prior-state identity, so a state is never inherited from an unnamed predecessor or a differently identified tree. A record additionally binds, by exact digest, every read receipt its action requires: release preflight binds a valid plan receipt and release evidence-publish binds a passing offline-verification receipt. A bound receipt is checkable evidence and never an authorization. Records are appended, never edited; a correction is a new record. Remote-write transitions additionally cite the exact one-time effect authorization they consumed. release publish records publication_dispatched, which asserts that a publication was dispatched and never that it completed.",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "state_id",
    "state",
    "action_id",
    "effect",
    "prior_state",
    "bound_receipts",
    "repository",
    "candidate",
    "inputs",
    "evidence",
    "artifacts",
    "actor",
    "consent",
    "authorization_event_id",
    "recorded_at",
    "record_digest_sha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "state_id": {
      "type": "string",
      "pattern": "^RLS-[0-9a-f]{16}$"
    },
    "state": {
      "$ref": "#/$defs/persisted_state"
    },
    "action_id": {
      "enum": [
        "release preflight",
        "release certify",
        "release prepare",
        "release export",
        "release evidence-publish",
        "release publish"
      ],
      "description": "Read actions are pure: they emit a deterministic receipt or observation to stdout and never produce a state record."
    },
    "effect": {
      "enum": ["harness-write", "local-write", "remote-write"]
    },
    "prior_state": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["state", "state_id", "record_digest_sha256"],
      "description": "Exact identity of the consumed predecessor. Null only for the record that opens the chain.",
      "properties": {
        "state": {
          "$ref": "#/$defs/persisted_state"
        },
        "state_id": {
          "type": "string",
          "pattern": "^RLS-[0-9a-f]{16}$"
        },
        "record_digest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "bound_receipts": {
      "type": "array",
      "uniqueItems": true,
      "description": "Every read receipt this transition required, pinned by exact receipt identity and canonical digest. Only passing receipts are bindable. Possession of a receipt authorizes nothing; it evidences a check that the transition depended on.",
      "items": {
        "$ref": "#/$defs/bound_receipt"
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "commit", "tree"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
        },
        "commit": {
          "$ref": "#/$defs/git_object"
        },
        "tree": {
          "$ref": "#/$defs/git_object"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_unit", "version", "commit", "tree"],
      "properties": {
        "release_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "commit": {
          "$ref": "#/$defs/git_object"
        },
        "tree": {
          "$ref": "#/$defs/git_object"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Every governed input the transition consumed, pinned by exact path and content digest.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {
            "enum": [
              "release-intent",
              "release-profile",
              "release-lifecycle-policy",
              "task-policy",
              "toolchain",
              "lockfile",
              "action-registry",
              "threshold"
            ]
          },
          "path": {
            "$ref": "#/$defs/relative_path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_digest_sha256", "receipt_digests", "independently_checkable"],
      "properties": {
        "manifest_digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "independently_checkable": {
          "const": true,
          "description": "Article 41: judge-only or otherwise uncheckable evidence never establishes readiness."
        }
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "size_bytes"],
        "properties": {
          "kind": {
            "enum": ["package-tarball", "evidence-bundle", "manifest", "attestation"]
          },
          "path": {
            "$ref": "#/$defs/relative_path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "declaration_source"],
      "properties": {
        "kind": {
          "const": "human"
        },
        "role": {
          "enum": ["owner", "architect", "inspector", "engineer", "auditor"]
        },
        "declaration_source": {
          "enum": ["cli-flag", "session-state"]
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write", "allow_publish", "experimental"],
      "properties": {
        "write": {
          "const": true
        },
        "allow_publish": {
          "type": "boolean"
        },
        "experimental": {
          "const": false
        }
      }
    },
    "authorization_event_id": {
      "type": ["string", "null"],
      "pattern": "^EA-[0-9a-f]{16}$",
      "description": "The exact one-time authorization consumed by this transition. Null for every non-remote effect; a non-null value on a non-remote transition is a violation."
    },
    "recorded_at": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    },
    "record_digest_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "Canonical digest of this record with this field omitted. Audit integrity only; it is never a capability."
    }
  },
  "allOf": [
    {
      "properties": {
        "state": {
          "not": {
            "$ref": "#/$defs/derived_state"
          },
          "description": "planned, offline_verified, and published are derived from receipts and are never appended. published in particular is observation-only: it is derived by release resume from a verified signed publication receipt."
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "preflight_passed"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "prior_state": {
            "type": "null"
          },
          "action_id": {
            "const": "release preflight"
          }
        }
      },
      "else": {
        "properties": {
          "prior_state": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "const": "remote-write"
          }
        },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "authorization_event_id": {
            "type": "string"
          },
          "actor": {
            "properties": {
              "role": {
                "const": "owner"
              }
            }
          },
          "consent": {
            "properties": {
              "allow_publish": {
                "const": true
              }
            }
          },
          "artifacts": {
            "minItems": 1
          }
        },
        "required": ["authorization_event_id"]
      },
      "else": {
        "properties": {
          "authorization_event_id": {
            "type": "null"
          },
          "consent": {
            "properties": {
              "allow_publish": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "const": "harness-write"
          }
        },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "action_id": {
            "enum": ["release preflight", "release certify"]
          },
          "actor": {
            "properties": {
              "role": {
                "const": "inspector"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "const": "local-write"
          }
        },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "action_id": {
            "enum": ["release prepare", "release export"]
          },
          "actor": {
            "properties": {
              "role": {
                "const": "architect"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "const": "remote-write"
          }
        },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "action_id": {
            "enum": ["release evidence-publish", "release publish"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release preflight"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "preflight_passed"
          },
          "effect": {
            "const": "harness-write"
          },
          "bound_receipts": {
            "minItems": 1,
            "maxItems": 1,
            "contains": {
              "$ref": "#/$defs/plan_receipt_binding"
            },
            "minContains": 1,
            "maxContains": 1,
            "description": "A preflight that cannot name the exact plan receipt it acted on opens the chain on an unstated basis."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release certify"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "certified"
          },
          "prior_state": {
            "properties": {
              "state": {
                "const": "preflight_passed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release prepare"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "prepared"
          },
          "prior_state": {
            "properties": {
              "state": {
                "const": "certified"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release export"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "exported"
          },
          "prior_state": {
            "properties": {
              "state": {
                "const": "prepared"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release evidence-publish"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "evidence_published"
          },
          "prior_state": {
            "properties": {
              "state": {
                "const": "exported"
              }
            }
          },
          "bound_receipts": {
            "minItems": 1,
            "maxItems": 1,
            "contains": {
              "$ref": "#/$defs/offline_verification_receipt_binding"
            },
            "minContains": 1,
            "maxContains": 1,
            "description": "Evidence publication requires a passing offline verification of the exported artifact. The receipt evidences the check; it never authorizes the publication."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release publish"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "publication_dispatched",
            "description": "A dispatch is not an outcome. published is derived only by observing a verified signed publication receipt and is never appended here."
          },
          "prior_state": {
            "properties": {
              "state": {
                "const": "evidence_published"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "persisted_state": {
      "enum": [
        "preflight_passed",
        "certified",
        "prepared",
        "exported",
        "evidence_published",
        "publication_dispatched"
      ]
    },
    "derived_state": {
      "enum": ["planned", "offline_verified", "published"],
      "description": "States that exist only in a receipt or an observation. No state record may name one."
    },
    "bound_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "receipt_id", "receipt_digest_sha256", "verdict"],
      "properties": {
        "kind": {
          "enum": ["release-plan-receipt", "release-offline-verification-receipt"]
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^(?:RPL|ROV)-[0-9a-f]{16}$"
        },
        "receipt_digest_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Canonical digest of the exact receipt document this transition relied on. A different digest is a different receipt."
        },
        "verdict": {
          "const": "pass",
          "description": "Only a passing receipt is bindable. A failing receipt is a reason to stop, never a weaker permission."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "release-plan-receipt"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "receipt_id": {
                "pattern": "^RPL-[0-9a-f]{16}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "release-offline-verification-receipt"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "receipt_id": {
                "pattern": "^ROV-[0-9a-f]{16}$"
              }
            }
          }
        }
      ]
    },
    "plan_receipt_binding": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "release-plan-receipt"
        }
      }
    },
    "offline_verification_receipt_binding": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "release-offline-verification-receipt"
        }
      }
    },
    "sha256": {
      "$ref": "common-defs.schema.json#/$defs/sha256"
    },
    "git_object": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[*?])[^\\u0000]+$"
    }
  },
  "examples": [
