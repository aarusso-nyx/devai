    "bound_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "receipt_id", "receipt_digest_sha256", "verdict"],
      "properties": {
        "kind": {
          "enum": ["release-plan-receipt", "release-offline-verification-receipt"]
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^(?:RPL|ROV)-[0-9a-f]{16}$"
        },
        "receipt_digest_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Canonical digest of the exact receipt document this transition relied on. A different digest is a different receipt."
        },
        "verdict": {
          "const": "pass",
          "description": "Only a passing receipt is bindable. A failing receipt is a reason to stop, never a weaker permission."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "release-plan-receipt"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "receipt_id": {
                "pattern": "^RPL-[0-9a-f]{16}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "release-offline-verification-receipt"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "receipt_id": {
                "pattern": "^ROV-[0-9a-f]{16}$"
              }
            }
          }
        }
      ]
    },
    "plan_receipt_binding": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "release-plan-receipt"
        }
      }
    },
    "offline_verification_receipt_binding": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "release-offline-verification-receipt"
        }
      }
    },
    "sha256": {
      "$ref": "common-defs.schema.json#/$defs/sha256"
    },
    "git_object": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
