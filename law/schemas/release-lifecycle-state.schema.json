{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/release-lifecycle-state.schema.json",
  "title": "Release lifecycle state record",
  "description": "One appended release lifecycle state transition. Only the six persisted states are appendable: preflight_passed, certified, prepared, exported, evidence_published, and publication_dispatched. The three derived states are never persisted, so a record naming planned, offline_verified, or published is rejected. Every record binds exact repository, candidate, input, evidence, artifact, and prior-state identity, so a state is never inherited from an unnamed predecessor or a differently identified tree. A record additionally binds, by exact digest, every read receipt its action requires: release preflight binds a valid plan receipt and release evidence-publish binds a passing offline-verification receipt. A bound receipt is checkable evidence and never an authorization. Records are appended, never edited; a correction is a new record. Remote-write transitions additionally cite the exact one-time effect authorization they consumed. release publish records publication_dispatched, which asserts that a publication was dispatched and never that it completed.",
  "schema_version": "2.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "state_id",
    "state",
    "action_id",
    "effect",
    "prior_state",
    "bound_receipts",
    "repository",
    "candidate",
    "inputs",
    "evidence",
    "artifacts",
    "actor",
    "consent",
    "authorization_event_id",
    "publication_expectation",
    "recorded_at",
    "record_digest_sha256"
  ],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "2.0.0", "2.1.0"] },
    "state_id": {
      "type": "string",
      "pattern": "^RLS-[0-9a-f]{16}$"
    },
    "state": {
      "$ref": "#/$defs/persisted_state"
    },
    "action_id": {
      "enum": [
        "release preflight",
        "release certify",
        "release prepare",
        "release export",
        "release evidence-publish",
        "release publish"
      ],
      "description": "Read actions are pure: they emit a deterministic receipt or observation to stdout and never produce a state record."
    },
    "effect": {
      "enum": ["harness-write", "local-write", "remote-write"]
    },
    "prior_state": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["state", "state_id", "record_digest_sha256"],
      "description": "Exact identity of the consumed predecessor. Null only for the record that opens the chain.",
      "properties": {
        "state": {
          "$ref": "#/$defs/persisted_state"
        },
        "state_id": {
          "type": "string",
          "pattern": "^RLS-[0-9a-f]{16}$"
        },
        "record_digest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "bound_receipts": {
      "type": "array",
      "uniqueItems": true,
      "description": "Every read receipt this transition required, pinned by exact receipt identity and canonical digest. Only passing receipts are bindable. Possession of a receipt authorizes nothing; it evidences a check that the transition depended on.",
      "items": {
        "$ref": "#/$defs/bound_receipt"
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "commit", "tree"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
        },
        "commit": {
          "$ref": "#/$defs/git_object"
        },
        "tree": {
          "$ref": "#/$defs/git_object"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_unit", "version", "commit", "tree"],
      "properties": {
        "release_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "commit": {
          "$ref": "#/$defs/git_object"
        },
        "tree": {
          "$ref": "#/$defs/git_object"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Every governed input the transition consumed, pinned by exact path and content digest.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {
            "enum": [
              "release-intent",
              "release-profile",
              "release-lifecycle-policy",
              "task-policy",
              "toolchain",
              "lockfile",
              "action-registry",
              "threshold"
            ]
          },
          "path": {
            "$ref": "#/$defs/relative_path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_digest_sha256", "receipt_digests", "independently_checkable"],
      "properties": {
        "manifest_digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "independently_checkable": {
          "const": true,
          "description": "Article 41: judge-only or otherwise uncheckable evidence never establishes readiness."
        }
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/state_artifact_ref" }
    },
    "artifact_sink": {
      "description": "V3-only trusted ArtifactSink transaction identity. It is absent from legacy records and contains opaque handles rather than a filesystem path.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact_sink_commit" }]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "declaration_source"],
      "properties": {
        "kind": {
          "const": "human"
        },
        "role": {
          "enum": ["owner", "architect", "inspector", "engineer", "auditor"]
        },
        "declaration_source": {
          "enum": ["cli-flag", "session-state"]
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write", "allow_publish", "experimental"],
      "properties": {
        "write": {
          "const": true
        },
        "allow_publish": {
          "type": "boolean"
        },
        "experimental": {
          "const": false
        }
      }
    },
    "authorization_event_id": {
      "type": ["string", "null"],
      "pattern": "^EA-[0-9a-f]{16}$",
      "description": "The exact one-time authorization consumed by this transition. Null for every non-remote effect; a non-null value on a non-remote transition is a violation."
    },
    "publication_expectation": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/publication_expectation" }],
      "description": "Authoritative expected publication destination, protected workflow/environment, external trust identities, and exact Owner grant. Present only on release publish/publication_dispatched and contains no key material."
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_id",
        "encoding",
        "json_form",
        "digest_algorithm",
        "projection_excludes",
        "id_derivation"
      ],
      "properties": {
        "kernel_id": { "const": "devai.kernel.release-lifecycle-state.v2" },
        "encoding": { "const": "utf-8" },
        "json_form": { "const": "rfc8785-jcs" },
        "digest_algorithm": { "const": "sha256" },
        "projection_excludes": { "const": ["state_id", "record_digest_sha256"] },
        "id_derivation": {
          "const": "RLS-hyphen-plus-first-16-lowercase-hex-of-record_digest_sha256"
        }
      }
    },
    "release_units": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "The exact multi-package release-unit roster. The v2 semantic kernel requires a sorted unique bijection to candidate, request, state artifacts, evidence, provider results, and trust identities.",
      "items": { "$ref": "#/$defs/release_unit_evidence" }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "head_before"],
      "description": "Core-derived compare-and-swap observation. Semantic validation requires agreement with prior_state and the persisted head; this object is never supplied by a client request.",
      "properties": {
        "generation": { "type": "integer", "minimum": 0 },
        "head_before": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/storage_head" }]
        }
      }
    },
    "recorded_at": {
      "$ref": "common-defs.schema.json#/$defs/timestamp"
    },
    "record_digest_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "Canonical digest of this record with this field omitted. Audit integrity only; it is never a capability."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "enum": ["2.0.0", "2.1.0"] } },
        "required": ["schemaVersion"]
      },
      "then": { "required": ["canonicalization", "release_units", "storage"] }
    },
    {
      "properties": {
        "state": {
          "not": {
            "$ref": "#/$defs/derived_state"
          },
          "description": "planned, offline_verified, and published are derived from receipts and are never appended. published in particular is observation-only: it is derived by release resume from a verified signed publication receipt."
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "preflight_passed"
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "prior_state": {
            "type": "null"
          },
          "storage": {
            "properties": {
              "generation": { "const": 0 },
              "head_before": { "type": "null" }
            }
          },
          "action_id": {
            "const": "release preflight"
          }
        }
      },
      "else": {
        "properties": {
          "prior_state": {
            "type": "object"
          },
          "storage": {
            "properties": {
              "generation": { "minimum": 1 },
              "head_before": { "$ref": "#/$defs/storage_head" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "const": "remote-write"
          }
        },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "authorization_event_id": {
            "type": "string"
          },
          "actor": {
            "properties": {
              "role": {
                "const": "owner"
              }
            }
          },
          "consent": {
            "properties": {
              "allow_publish": {
                "const": true
              }
            }
          },
          "artifacts": {
            "minItems": 1
          }
        },
        "required": ["authorization_event_id"]
      },
      "else": {
        "properties": {
          "authorization_event_id": {
            "type": "null"
          },
          "consent": {
            "properties": {
              "allow_publish": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "const": "harness-write"
          }
        },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "action_id": {
            "enum": ["release preflight", "release certify"]
          },
          "actor": {
            "properties": {
              "role": {
                "const": "inspector"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "const": "local-write"
          }
        },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "action_id": {
            "enum": ["release prepare", "release export"]
          },
          "actor": {
            "properties": {
              "role": {
                "const": "architect"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effect": {
            "const": "remote-write"
          }
        },
        "required": ["effect"]
      },
      "then": {
        "properties": {
          "action_id": {
            "enum": ["release evidence-publish", "release publish"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release preflight"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "preflight_passed"
          },
          "effect": {
            "const": "harness-write"
          },
          "bound_receipts": {
            "minItems": 1,
            "maxItems": 1,
            "contains": {
              "$ref": "#/$defs/plan_receipt_binding"
            },
            "minContains": 1,
            "maxContains": 1,
            "description": "A preflight that cannot name the exact plan receipt it acted on opens the chain on an unstated basis."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release certify"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "certified"
          },
          "prior_state": {
            "properties": {
              "state": {
                "const": "preflight_passed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release prepare"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "prepared"
          },
          "prior_state": {
            "properties": {
              "state": {
                "const": "certified"
              }
            }
          },
          "artifacts": {
            "allOf": [
              {
                "contains": {
                  "required": ["kind"],
                  "properties": { "kind": { "const": "package-tarball" } }
                }
              },
              {
                "contains": {
                  "required": ["kind"],
                  "properties": { "kind": { "const": "manifest" } }
                }
              },
              {
                "contains": { "required": ["kind"], "properties": { "kind": { "const": "sbom" } } }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release export"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "exported"
          },
          "prior_state": {
            "properties": {
              "state": {
                "const": "prepared"
              }
            }
          },
          "artifacts": {
            "allOf": [
              {
                "contains": {
                  "required": ["kind"],
                  "properties": { "kind": { "const": "evidence-bundle" } }
                }
              },
              {
                "contains": {
                  "required": ["kind"],
                  "properties": { "kind": { "const": "provider-result" } }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": { "const": "2.1.0" },
          "action_id": {
            "enum": [
              "release prepare",
              "release export",
              "release evidence-publish",
              "release publish"
            ]
          }
        },
        "required": ["schemaVersion", "action_id"]
      },
      "then": {
        "required": ["artifact_sink"],
        "properties": {
          "artifact_sink": { "$ref": "#/$defs/artifact_sink_commit" },
          "artifacts": { "items": { "$ref": "#/$defs/opaque_artifact_ref" } },
          "release_units": {
            "items": {
              "properties": {
                "packages": { "items": { "$ref": "#/$defs/v3_handle_package_evidence" } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": { "const": "2.1.0" },
          "action_id": { "const": "release prepare" }
        },
        "required": ["schemaVersion", "action_id"]
      },
      "then": {
        "required": ["artifact_sink"],
        "properties": {
          "artifact_sink": { "$ref": "#/$defs/artifact_sink_commit" },
          "artifacts": { "items": { "$ref": "#/$defs/opaque_artifact_ref" } },
          "release_units": {
            "items": {
              "properties": {
                "packages": { "items": { "$ref": "#/$defs/v3_prepared_package_evidence" } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release evidence-publish"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "evidence_published"
          },
          "prior_state": {
            "properties": {
              "state": {
                "const": "exported"
              }
            }
          },
          "bound_receipts": {
            "minItems": 1,
            "maxItems": 1,
            "contains": {
              "$ref": "#/$defs/offline_verification_receipt_binding"
            },
            "minContains": 1,
            "maxContains": 1,
            "description": "Evidence publication requires a passing offline verification of the exported artifact. The receipt evidences the check; it never authorizes the publication."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "release publish"
          }
        },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "state": {
            "const": "publication_dispatched",
            "description": "A dispatch is not an outcome. published is derived only by observing a verified signed publication receipt and is never appended here."
          },
          "prior_state": {
            "properties": {
              "state": {
                "const": "evidence_published"
              }
            }
          },
          "publication_expectation": {
            "$ref": "#/$defs/publication_expectation"
          }
        }
      },
      "else": {
        "properties": {
          "publication_expectation": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "release_unit_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_unit", "version", "packages"],
      "properties": {
        "release_unit": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/package_evidence" }
        }
      }
    },
    "package_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "manifest",
        "tarball",
        "sbom",
        "evidence_manifest",
        "provider_result",
        "trust"
      ],
      "properties": {
        "package_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "manifest": { "$ref": "#/$defs/release_artifact_ref" },
        "tarball": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/release_artifact_ref" }] },
        "sbom": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/release_artifact_ref" }] },
        "evidence_manifest": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/release_artifact_ref" }]
        },
        "provider_result": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/release_artifact_ref" }]
        },
        "trust": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/trust_identity" }] },
        "certification_manifest": {
          "description": "V3 certification package-entry manifest. It is required by the active prepare semantic kernel for certified packages and stays optional here only for byte-preserved v1/v2 read compatibility.",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/certification_package_entry_manifest" }]
        }
      }
    },
    "certification_package_entry_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "task_policy_digest_sha256",
        "package_id",
        "package_version",
        "entry_order",
        "manifest_digest_contract",
        "entries",
        "manifest_digest_sha256"
      ],
      "properties": {
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "tree"],
          "properties": {
            "commit": { "$ref": "#/$defs/git_object" },
            "tree": { "$ref": "#/$defs/git_object" }
          }
        },
        "task_policy_digest_sha256": { "$ref": "#/$defs/sha256" },
        "package_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "package_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "entry_order": { "const": "ascending-utf-8-byte-collation-by-path;duplicates-refuse" },
        "manifest_digest_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "payload", "canonicalization", "algorithm"],
          "properties": {
            "domain": { "const": "DEVAI-CERTIFIED-PACKAGE-ENTRY-MANIFEST-V1\u0000" },
            "payload": {
              "const": "utf-8-rfc8785-jcs-of-the-entire-manifest-with-manifest_digest_sha256-omitted;framed-as-domain-utf8-bytes-plus-payload-utf8-bytes"
            },
            "canonicalization": { "const": "rfc8785-jcs" },
            "algorithm": { "const": "sha256" }
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/certification_package_entry" }
        },
        "manifest_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "certification_package_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "size_bytes", "sha256", "immutable_blob_locator"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "mode": { "enum": ["100644", "100755"] },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "immutable_blob_locator": { "$ref": "#/$defs/immutable_blob_locator" }
      }
    },
    "immutable_blob_locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "object_id"],
          "properties": {
            "kind": { "const": "git-object" },
            "object_id": { "$ref": "#/$defs/git_object" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "output_blob_sha256", "certification_evidence_receipt"],
          "properties": {
            "kind": { "const": "generated-output" },
            "output_blob_sha256": { "$ref": "#/$defs/sha256" },
            "certification_evidence_receipt": {
              "$ref": "#/$defs/certification_evidence_receipt_ref"
            }
          }
        }
      ]
    },
    "certification_evidence_receipt_ref": {
      "description": "Independent finalized certification evidence, never the mutable or self-referential lifecycle state digest. Resolution loads the immutable receipt by digest from the certified evidence store and verifies this exact referent before reading the generated blob.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "receipt_digest_sha256", "canonicalization", "referent"],
      "properties": {
        "kind": { "const": "release-certification-evidence-receipt-v1" },
        "receipt_digest_sha256": { "$ref": "#/$defs/sha256" },
        "canonicalization": { "const": "utf-8-rfc8785-jcs-sha256" },
        "referent": {
          "type": "object",
