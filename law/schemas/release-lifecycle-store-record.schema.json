{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/release-lifecycle-store-record.schema.json",
  "title": "Release lifecycle append-only store record",
  "description": "One durable append-only release execution event. predecessor_record is the exact append-log tail; observed_head_before is the exact full v2 canonical completed-state head observed by the attempt and copied by its terminal record. Completion alone may advance that head through compare-and-swap. Failure advances only the log tail. An unknown provider or ArtifactSink commit result is terminal and non-retriable; prepare ambiguity retains exact sink transaction, manifest, and opaque artifact identities for external reconciliation without asserting commit success.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "record_kind",
    "canonicalization",
    "record_id",
    "sequence",
    "repository",
    "candidate",
    "predecessor_record",
    "observed_head_before",
    "attempt_id",
    "action_id",
    "request_digest_sha256",
    "authorization_event_id",
    "provider_handle",
    "provider_dispatch",
    "completion",
    "failure",
    "unknown",
    "record_digest_sha256"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "record_kind": { "enum": ["attempt", "completion", "failure", "unknown-provider-result"] },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json_form",
        "encoding",
        "digest_algorithm",
        "projection_excludes",
        "id_derivation"
      ],
      "properties": {
        "json_form": { "const": "rfc8785-jcs" },
        "encoding": { "const": "utf-8" },
        "digest_algorithm": { "const": "sha256" },
        "projection_excludes": { "const": ["record_id", "record_digest_sha256"] },
        "id_derivation": {
          "const": "RLE-hyphen-plus-first-16-lowercase-hex-of-record_digest_sha256"
        }
      }
    },
    "record_id": { "type": "string", "pattern": "^RLE-[0-9a-f]{16}$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "repository": { "$ref": "#/$defs/repository" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "predecessor_record": {
      "description": "Exact append-log predecessor. Null only for the opening attempt; a successor after failure names the failure record rather than the unchanged completed-state head.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/record_ref" }]
    },
    "observed_head_before": {
      "description": "Exact full v2 canonical completed-state HEAD observed before the attempt, or null when no action has completed. Every terminal record copies its attempt value byte-for-byte.",
      "oneOf": [{ "type": "null" }, { "$ref": "release-lifecycle-store-head.schema.json" }]
    },
    "attempt_id": { "type": "string", "pattern": "^RLA-[0-9a-f]{16}$" },
    "action_id": {
      "enum": [
        "release preflight",
        "release certify",
        "release prepare",
        "release export",
        "release evidence-publish",
        "release publish"
      ]
    },
    "request_digest_sha256": { "$ref": "#/$defs/sha256" },
    "authorization_event_id": { "type": ["string", "null"], "pattern": "^EA-[0-9a-f]{16}$" },
    "provider_handle": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "provider_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "handle_observed"],
      "properties": {
        "status": { "enum": ["not-dispatched", "failed-before-dispatch", "dispatched", "unknown"] },
        "handle_observed": { "type": "boolean" }
      }
    },
    "completion": { "$ref": "#/$defs/completion" },
    "failure": { "$ref": "#/$defs/failure" },
    "unknown": { "$ref": "#/$defs/unknown" },
    "record_digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "sequence": { "const": 0 } },
        "required": ["sequence"]
      },
      "then": {
        "properties": {
          "record_kind": { "const": "attempt" },
          "predecessor_record": { "type": "null" },
          "observed_head_before": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "sequence": { "type": "integer", "minimum": 1 } },
        "required": ["sequence"]
      },
      "then": { "properties": { "predecessor_record": { "type": "object" } } }
    },
    {
      "if": {
        "properties": { "record_kind": { "const": "attempt" } },
        "required": ["record_kind"]
      },
      "then": {
        "properties": {
          "completion": { "type": "null" },
          "failure": { "type": "null" },
          "unknown": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "record_kind": { "const": "completion" } },
        "required": ["record_kind"]
      },
      "then": {
        "required": ["completion"],
        "properties": {
          "completion": { "type": "object" },
          "failure": { "type": "null" },
          "unknown": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "record_kind": { "const": "failure" } },
        "required": ["record_kind"]
      },
      "then": {
        "required": ["failure"],
        "properties": {
          "completion": { "type": "null" },
          "failure": { "type": "object" },
          "unknown": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "record_kind": { "const": "unknown-provider-result" } },
        "required": ["record_kind"]
      },
      "then": {
        "required": ["authorization_event_id", "provider_handle", "unknown"],
        "properties": {
          "action_id": {
            "enum": [
              "release prepare",
              "release export",
              "release evidence-publish",
              "release publish"
            ]
          },
          "completion": { "type": "null" },
          "failure": { "type": "null" },
          "unknown": { "type": "object" }
        }
      }
    },
    {
      "if": {
        "properties": { "action_id": { "enum": ["release evidence-publish", "release publish"] } },
        "required": ["action_id"]
      },
      "then": {
        "properties": {
          "authorization_event_id": { "type": "string" },
          "provider_dispatch": { "type": "object" }
        }
      },
      "else": {
        "properties": {
          "authorization_event_id": { "type": "null" },
          "provider_handle": { "type": "null" },
          "provider_dispatch": {
            "properties": {
              "status": { "const": "not-dispatched" },
              "handle_observed": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider_dispatch": { "properties": { "handle_observed": { "const": true } } }
        },
        "required": ["provider_dispatch"]
      },
      "then": { "properties": { "provider_handle": { "type": "string", "minLength": 1 } } },
      "else": { "properties": { "provider_handle": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "record_kind": { "const": "attempt" } },
        "required": ["record_kind"]
      },
      "then": {
        "properties": {
          "provider_dispatch": {
            "properties": {
              "status": { "const": "not-dispatched" },
              "handle_observed": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": { "const": "completion" },
          "action_id": { "enum": ["release evidence-publish", "release publish"] }
        },
        "required": ["record_kind", "action_id"]
      },
      "then": {
        "properties": {
          "provider_dispatch": {
            "properties": {
              "status": { "const": "dispatched" },
              "handle_observed": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": { "const": "unknown-provider-result" },
          "action_id": { "enum": ["release evidence-publish", "release publish"] }
        },
        "required": ["record_kind", "action_id"]
      },
      "then": {
        "properties": {
          "provider_dispatch": { "properties": { "status": { "const": "unknown" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": { "const": "unknown-provider-result" },
          "action_id": { "const": "release prepare" }
        },
        "required": ["record_kind", "action_id"]
      },
      "then": {
        "properties": {
          "unknown": { "required": ["artifact_sink", "artifacts"] }
        }
      },
      "else": {
        "properties": {
          "unknown": {
            "properties": { "artifact_sink": false, "artifacts": false }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "$ref": "common-defs.schema.json#/$defs/sha256" },
    "git_object": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "commit", "tree"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$" },
        "commit": { "$ref": "#/$defs/git_object" },
        "tree": { "$ref": "#/$defs/git_object" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "release_units"],
      "properties": {
        "commit": { "$ref": "#/$defs/git_object" },
        "tree": { "$ref": "#/$defs/git_object" },
        "release_units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/release_unit" }
        }
      }
    },
    "release_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_unit", "version", "packages"],
      "properties": {
        "release_unit": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/package_evidence" }
        }
      }
    },
    "package_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id"],
      "properties": {
        "package_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "manifest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] },
        "tarball": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] },
        "sbom": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] },
        "evidence_manifest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] },
        "provider_result": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }] },
        "trust": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/trust_identity" }] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "trust_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_root_id", "trust_store_digest_sha256", "key_id", "signature_algorithm"],
      "properties": {
        "trust_root_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$" },
        "trust_store_digest_sha256": { "$ref": "#/$defs/sha256" },
        "key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$" },
        "signature_algorithm": { "enum": ["ed25519", "ecdsa-p256-sha256", "rsa-pss-sha256"] }
      }
    },
    "record_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "record_id", "record_digest_sha256"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "record_id": { "type": "string", "pattern": "^RLE-[0-9a-f]{16}$" },
        "record_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "completion": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["state_id", "state_digest_sha256", "state"],
      "properties": {
        "state_id": { "type": "string", "pattern": "^RLS-[0-9a-f]{16}$" },
        "state_digest_sha256": { "$ref": "#/$defs/sha256" },
        "state": {
          "enum": [
            "preflight_passed",
            "certified",
            "prepared",
            "exported",
            "evidence_published",
            "publication_dispatched"
          ]
        }
      }
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^release-[a-z0-9-]+$" },
        "retryable": { "const": false }
      }
    },
    "unknown": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "redispatch_permitted"],
      "properties": {
        "code": { "const": "release-provider-result-unknown" },
        "redispatch_permitted": { "const": false },
        "artifact_sink": {
          "description": "Exact attempted commit identity retained only for prepare ambiguity. The committed_manifest fields identify the submitted manifest, not proof of successful commit.",
          "$ref": "release-lifecycle-state.schema.json#/$defs/artifact_sink_commit"
        },
        "artifacts": {
          "description": "Complete opaque artifact identities submitted in the attempted manifest, retained without abort or rollback for external reconciliation.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "release-lifecycle-state.schema.json#/$defs/v3_opaque_artifact_ref" }
        }
      }
    }
  }
}
