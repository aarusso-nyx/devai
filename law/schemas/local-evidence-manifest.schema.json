        "actor": "aarusso-nyx",
        "headSha": "f74c617100220d0adbffd3281ed79b1498edfba7",
        "baseSha": "400bcf70181874108d6a0152626d1f85b53c03e0",
        "mergeBaseSha": "400bcf70181874108d6a0152626d1f85b53c03e0",
        "testedCommitSha": "bafdaf27de19fe1e03d3e6fdc0b62f043cb8a308",
