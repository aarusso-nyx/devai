{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devai.nyxk.com.br/schemas/round-execution.schema.json",
  "title": "Round execution policy",
  "description": "Schema for the round/task containment, selection, ordering, role, resource, lifecycle, failure, rollback, output, and public vocabulary policy.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "status",
    "authority",
    "task_contract",
    "selection",
    "dependencies",
    "roles",
    "resources",
    "capacity",
    "lifecycle",
    "failure",
    "rollback",
    "outputs",
    "vocabularies"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/round-execution.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "round-execution"
    },
    "status": {
      "const": "active"
    },
    "authority": {
      "const": "Architect"
    },
    "task_contract": {
      "$ref": "#/$defs/section"
    },
    "selection": {
      "$ref": "#/$defs/section"
    },
    "dependencies": {
      "$ref": "#/$defs/section"
    },
    "roles": {
      "$ref": "#/$defs/section"
    },
    "resources": {
      "$ref": "#/$defs/section"
    },
    "capacity": {
      "description": "Bounded concurrent admission within one round. Parallelism is opt-in per invocation and never exceeds the ceiling.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_workers",
        "max_workers",
        "activation",
        "admission",
        "lock_denial_escalation_threshold",
        "cross_round_controller",
        "review_reserve"
      ],
      "properties": {
        "default_workers": {
          "const": 1
        },
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "activation": {
          "const": "explicit-per-invocation"
        },
        "admission": {
          "const": "same-topological-generation-and-resource-disjoint-only"
        },
        "lock_denial_escalation_threshold": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "cross_round_controller": {
          "const": "forbidden"
        },
        "review_reserve": {
          "description": "Workers kept for review-discipline tasks (ADR-MDL-0009). While a same-generation review task awaits admission, non-review tasks may occupy at most the run's workers minus reserved_workers; review tasks may use every worker. A serial run, or one with no more workers than the reserve, is unreserved.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disciplines",
            "reserved_workers",
            "applies_when",
            "non_review_ceiling",
            "review_tasks",
            "serial_runs",
            "refusal"
          ],
          "properties": {
            "disciplines": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["inspector", "auditor"]
              }
            },
            "reserved_workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15
            },
            "applies_when": {
              "const": "run-workers-exceed-reserved-and-a-same-generation-review-task-awaits-admission"
            },
            "non_review_ceiling": {
              "const": "run-workers-minus-reserved-workers"
            },
            "review_tasks": {
              "const": "may-use-every-run-worker"
            },
            "serial_runs": {
              "const": "unreserved"
            },
            "refusal": {
              "const": "TASK_WORKER_CAP"
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "terminal", "transitions", "undeclared_transition", "timestamps"],
      "properties": {
        "initial": {
          "const": "queued"
        },
        "terminal": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taskStatus"
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {
                "$ref": "#/$defs/taskStatus"
              },
              "to": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/taskStatus"
                }
              }
            }
          }
        },
        "undeclared_transition": {
          "type": "string",
          "minLength": 1
        },
        "timestamps": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failure": {
      "$ref": "#/$defs/section"
    },
    "rollback": {
      "$ref": "#/$defs/section"
    },
    "outputs": {
      "$ref": "#/$defs/section"
    },
    "vocabularies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_slices",
        "adoption_tiers",
        "surface_tiers",
        "verdicts",
        "action_lifecycles"
      ],
      "properties": {
        "inventory_slices": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namedPopulation"
          }
        },
        "adoption_tiers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namedPopulation"
          }
        },
        "surface_tiers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namedPopulation"
          }
        },
        "verdicts": {
          "type": "array",
          "prefixItems": [
            {
              "const": "pass"
            },
            {
              "const": "review"
            },
            {
              "const": "fail"
            },
            {
              "const": "unknown"
            },
            {
              "const": "na"
            },
            {
              "const": "skipped"
            },
            {
              "const": "error"
            },
            {
              "const": "killed"
            }
          ],
          "items": false,
          "minItems": 8,
          "maxItems": 8
        },
        "action_lifecycles": {
          "type": "array",
          "prefixItems": [
            {
              "const": "supported"
            },
            {
              "const": "experimental"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "minProperties": 1
    },
    "taskStatus": {
      "enum": [
        "queued",
        "ready",
        "lock_denied",
        "in_progress",
        "checkpoint",
        "pre_merge",
        "merging",
        "completed",
        "awaiting_human_review",
        "experimental_blocked",
        "escalated",
        "rgr_pending",
        "cancelled"
      ]
    },
    "namedPopulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "members"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "examples": [{}]
}
