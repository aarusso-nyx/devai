  "lifecycle": "supported",
  "severity": "constitutional",
  "type": "governance",
  "title": "A readiness computation over an empty invariant set is a gate failure",
  "statement": "A readiness or strategy-coverage computation over the readiness-bearing severity set MUST resolve at least one active invariant, and resolving an empty set MUST produce a gate failure and never a passing, ready, or complete result.",
  "rationale": "Article 11 forbids vacuous readiness: an empty reference signal cannot certify anything.",
  "status": "active",
  "verification": {
    "required_suites": ["unit", "int"],
    "oracle": "tests",
    "strategy": {
      "primary": "regression",
      "deterministic_check_available": true,
      "rationale": "A deterministic test corpus under tests/ and packages/*/tests observes this obligation; trace links the tests."
    }
  },
