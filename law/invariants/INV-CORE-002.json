  "id": "INV-CORE-002",
  "domain": "CORE",
  "lifecycle": "supported",
  "severity": "constitutional",
  "type": "api_contract",
  "title": "Every executable sensor emits a normalized SensorReading",
  "statement": "Every executable sensor MUST emit its output through the SensorReading schema with status, evidence path, timestamp, command, command hash, failure mode, and optional structured findings, so that scorecard composition is polymorphic over sensor kinds.",
  "rationale": "Article 32 makes the reading contract the only interface between sensors and the scorecard.",
  "status": "active",
  "verification": {
    "required_suites": ["unit", "int"],
    "oracle": "tests",
    "strategy": {
      "primary": "regression",
      "deterministic_check_available": true,
      "rationale": "A deterministic test corpus under tests/ and packages/*/tests observes this obligation; trace links the tests."
    }
  },
  "authority_docs": {
    "docs": [
      {
        "doc": "law/constitution.md",
        "anchor": "article-32-sensor-adapter-uniformity"
      },
      {
