        "anchor": "decision"
      }
    ],
    "decisions": ["ADR-SCR-0001"]
  },
  "scope": {
    "components": ["sensors", "sense-runtime"],
    "code_areas": ["packages/sensors/src/**", "packages/cli/src/commands/sense/**"]
  },
  "change_policy": {
    "breaking_change_requires": [
      "doc_update",
      "trace_update",
      "test_update",
      "human_approval",
      "adr"
    ],
    "test_weakening_allowed": false,
