{
  "schemaVersion": "1.0.0",
  "version": "1.0.0",
  "id": "INV-AUTH-001",
  "domain": "AUTH",
  "lifecycle": "supported",
  "severity": "constitutional",
  "type": "governance",
  "title": "Substrate authority is enforced by path prefix before mutation",
  "statement": "Every write performed through the DEVAI runtime MUST be decided by a fixed path prefix of at most two segments against the declared role, and a write whose prefix is not authorized for that role MUST be refused before any mutation, with zero exemptions and no wildcard remainder.",
  "rationale": "Article 6 makes authority a table lookup on the filesystem path. A default remainder or an exemption would turn the authority boundary into advisory metadata.",
  "status": "active",
  "verification": {
    "required_suites": ["unit", "int", "e2e"],
    "oracle": "tests",
    "strategy": {
      "primary": "regression",
      "deterministic_check_available": true,
      "rationale": "A deterministic test corpus under tests/ and packages/*/tests observes this obligation; trace links the tests."
    }
  },
