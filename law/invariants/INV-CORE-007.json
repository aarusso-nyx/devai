  "id": "INV-CORE-007",
  "domain": "CORE",
  "lifecycle": "supported",
  "severity": "constitutional",
  "type": "audit",
  "title": "Evidence is hash-chained, append-only, attributed, and never edited",
  "statement": "Every evidence record MUST be appended by the executing verb, attributed to that verb, content-hashed and predecessor-linked into the chain with exact tree, inputs, and outcomes, MUST never be edited in place, and a chain with a sequence gap or a broken digest link MUST fail verification rather than resolve its intact prefix.",
  "rationale": "Article 41 and Article 6 (record/ is machine only) make evidence trustworthy only because it cannot be rewritten; ADR-GOV-0012 and ADR-GOV-0013 apply the same rule to release records.",
  "status": "active",
  "verification": {
    "required_suites": ["unit", "int"],
    "oracle": "tests",
    "strategy": {
      "primary": "regression",
      "deterministic_check_available": true,
      "rationale": "A deterministic test corpus under tests/ and packages/*/tests observes this obligation; trace links the tests."
    }
  },
