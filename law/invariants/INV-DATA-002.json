{
  "schemaVersion": "1.0.0",
  "version": "1.0.0",
  "id": "INV-DATA-002",
  "domain": "DATA",
  "lifecycle": "supported",
  "severity": "constitutional",
  "type": "data_contract",
  "title": "Machine-readable artifacts are JSON that validates against a catalogued schema",
  "statement": "Every machine-readable artifact the DEVAI engine produces or consumes MUST be JSON validating against a schema catalogued under law/schemas/, and Markdown MUST NOT carry canonical machine-readable metadata.",
  "rationale": "Article 38 fixes the JSON canon so every record, reading, and receipt is validatable by the same schema roster.",
  "status": "active",
  "verification": {
    "required_suites": ["unit", "int"],
    "oracle": "tests",
    "strategy": {
      "primary": "regression",
      "deterministic_check_available": true,
      "rationale": "A deterministic test corpus under tests/ and packages/*/tests observes this obligation; trace links the tests."
    }
  },
  "authority_docs": {
    "docs": [
      {
        "doc": "law/constitution.md",
        "anchor": "article-38-json-canon"
      },
      {
        "doc": "law/adr/ADR-GOV-0019-backlog-action-family.md",
        "anchor": "decision"
      }
    ],
    "decisions": ["ADR-GOV-0019"]
  },
  "scope": {
    "components": ["schemas", "cli-output", "backlog"],
    "code_areas": [
      "packages/schemas/src/**",
      "packages/cli/src/commands/actions-list.ts",
      "packages/cli/src/commands/backlog/**",
      "packages/loop/src/repository-backlog/**"
    ]
  },
  "change_policy": {
    "breaking_change_requires": [
      "doc_update",
      "trace_update",
      "test_update",
      "human_approval",
      "adr"
    ],
    "test_weakening_allowed": false,
    "human_approval_required": true
  },
  "tags": ["json-canon", "schemas", "article-38"],
  "measurable_via": [
    "catalog actions",
    "backlog add",
    "backlog list",
    "backlog show",
    "backlog resolve"
  ],
  "provenance": ["ADR-SCR-0004", "CMP-0002:R-0203:TASK-0231"],
  "supersedes": null,
  "superseded_by": null
}
