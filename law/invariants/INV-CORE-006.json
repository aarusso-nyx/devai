  "id": "INV-CORE-006",
  "domain": "CORE",
  "lifecycle": "supported",
  "severity": "constitutional",
  "type": "governance",
  "title": "The backlog is the only work queue and the supported harness never dequeues by itself",
  "statement": "All governed work MUST enter through explicit backlog operations, the supported harness MUST NOT invent, dequeue, edit, merge, or publish work on its own, and no task injection MUST bypass the backlog.",
  "rationale": "Articles 3 and 35 give the controller a single human-fed queue to regulate.",
  "status": "active",
  "verification": {
    "required_suites": ["unit", "int"],
    "oracle": "tests",
    "strategy": {
      "primary": "regression",
      "deterministic_check_available": true,
      "rationale": "A deterministic test corpus under tests/ and packages/*/tests observes this obligation; trace links the tests."
    }
  },
  "authority_docs": {
