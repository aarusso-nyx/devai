    ],
    "decisions": ["ADR-GOV-0019"]
  },
  "scope": {
    "components": ["backlog", "task-queue"],
    "code_areas": ["packages/loop/src/repository-backlog/**", "packages/cli/src/commands/task/**"]
  },
  "change_policy": {
