{
  "schemaVersion": "1.0.0",
  "version": "1.0.0",
  "id": "INV-SEC-002",
  "domain": "SEC",
  "lifecycle": "supported",
  "severity": "constitutional",
  "type": "security",
  "title": "Release lifecycle actions bind exact identity and accept only their registry role",
  "statement": "Every release lifecycle action MUST accept only the initiator role the action registry declares, MUST bind the canonical repository identity, candidate commit and tree, plan digest, and trust identity exactly with a near match treated as a mismatch, MUST derive published only from a verified signed publication receipt, and release plan, release offline-verify, release resume, and release status MUST leave the repository byte-identical.",
  "rationale": "Articles 9 and 41 make authority explicit and evidence exact; ADR-REL-0001, ADR-REL-0002, ADR-REL-0016, and ADR-REL-0023 define the release trust boundary the workflow defends.",
  "status": "active",
  "verification": {
    "required_suites": ["unit", "int", "e2e"],
    "oracle": "tests",
    "strategy": {
      "primary": "regression",
      "deterministic_check_available": true,
      "rationale": "A deterministic test corpus under tests/ and packages/*/tests observes this obligation; trace links the tests."
    }
  },
