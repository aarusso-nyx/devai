  "severity": "constitutional",
  "type": "lifecycle",
  "title": "The Auditor observes after merges or on request and never on a timer",
  "statement": "The Auditor MUST run after a merge to integration, on explicit human request, or before a task batch when a human or an explicitly enabled experimental controller requests it, MUST NOT run on a timer, MUST NOT actuate, and its round records and tracking projections MUST recommend without ratifying the reference signal.",
  "rationale": "Articles 33 and 34 keep the Auditor outside the loop and the framework quiescent when integration is quiet.",
  "status": "active",
  "verification": {
    "required_suites": ["unit", "int"],
    "oracle": "tests",
    "strategy": {
      "primary": "regression",
      "deterministic_check_available": true,
      "rationale": "A deterministic test corpus under tests/ and packages/*/tests observes this obligation; trace links the tests."
    }
  },
