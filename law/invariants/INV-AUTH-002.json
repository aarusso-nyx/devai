  "id": "INV-AUTH-002",
  "domain": "AUTH",
  "lifecycle": "supported",
  "severity": "constitutional",
  "type": "governance",
  "title": "One declared role per session, never inferred or elevated",
  "statement": "Every governed action MUST identify exactly one caller-declared constitutional role, MUST ignore ambient role or session state for authorization, and MUST refuse rather than elevate when the declared role initiates an action reserved to another role.",
  "rationale": "Articles 7 and 10 make the role declaration the only source of authority and forbid one discipline from setting its own reference and actuating against it.",
  "status": "active",
  "verification": {
    "required_suites": ["unit", "int", "e2e"],
    "oracle": "tests",
    "strategy": {
      "primary": "regression",
      "deterministic_check_available": true,
      "rationale": "A deterministic test corpus under tests/ and packages/*/tests observes this obligation; trace links the tests."
    }
  },
