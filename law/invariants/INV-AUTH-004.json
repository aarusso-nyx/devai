  "severity": "hard-fail",
  "type": "governance",
  "title": "Self-dogfood runs are human-invoked and admitted only by the role and effect matrix",
  "statement": "A self-dogfood invocation MUST be human-initiated, MUST be admitted only from the matrix row of the declared role and check id with no default-permit remainder, MUST forbid remote-write for every role, and a passing check MUST grant no publication authority and no readiness claim.",
  "rationale": "Article 3 forbids the supported harness from dequeuing or publishing on its own; ADR-GOV-0002 and ADR-SCR-0001 bound what the framework may do to itself.",
  "status": "active",
  "verification": {
    "required_suites": ["unit", "int"],
    "oracle": "tests",
    "strategy": {
      "primary": "regression",
      "deterministic_check_available": true,
      "rationale": "A deterministic test corpus under tests/ and packages/*/tests observes this obligation; trace links the tests."
    }
  },
