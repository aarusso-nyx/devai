  "completeness_gates": [
    {
      "gate_id": "docs-policy-schema",
      "phase": "current",
      "scope": "policy",
      "condition": "the policy validates against documentation-information-architecture.schema.json",
      "failure": "DOCS_POLICY_SCHEMA_INVALID"
    },
    {
      "gate_id": "docs-page-manifest-unique",
      "phase": "current",
      "scope": "page-manifest",
      "condition": "page identifiers and planned paths are nonempty and unique and every category points to one declared page",
      "failure": "DOCS_PAGE_MANIFEST_INVALID"
    },
    {
      "gate_id": "docs-source-routing-resolves",
      "phase": "current",
      "scope": "category",
      "condition": "every canonical source exists at the candidate and every declared pointer or projection resolves without inference",
      "failure": "DOCS_CANONICAL_SOURCE_UNRESOLVED"
    },
    {
      "gate_id": "docs-category-census-exact",
      "phase": "current",
      "scope": "category",
      "condition": "the machine report contains exactly the policy category identifiers with no missing or extra category",
      "failure": "DOCS_CATEGORY_CENSUS_DRIFT"
    },
    {
      "gate_id": "docs-category-bijection",
      "phase": "current",
      "scope": "category",
      "condition": "each category's expected and documented identifiers are an exact ordered bijection with no missing extra or duplicate identifier",
      "failure": "DOCS_CATEGORY_BIJECTION_FAILED"
    },
    {
      "gate_id": "docs-entry-semantics-complete",
      "phase": "current",
      "scope": "entry",
      "condition": "every documented value has every policy semantic field and every field is nonempty or carries an explicit not-applicable reason",
      "failure": "DOCS_ENTRY_SEMANTICS_INCOMPLETE"
    },
    {
      "gate_id": "docs-source-parity",
      "phase": "current",
      "scope": "category",
      "condition": "all supplemental-source projections agree with the canonical population and semantic assignment",
      "failure": "DOCS_SOURCE_PARITY_FAILED"
    },
    {
      "gate_id": "docs-generated-deterministic",
      "phase": "current",
      "scope": "entry",
      "condition": "two renders from identical canonical bytes are byte-identical and the check path performs no writes",
      "failure": "DOCS_GENERATED_BYTES_DRIFT"
    },
    {
      "gate_id": "docs-narrative-no-population-copy",
      "phase": "current",
      "scope": "narrative",
      "condition": "narrative pages link to generated tables and contain no independently maintained complete mutable enumeration",
      "failure": "DOCS_NARRATIVE_DUPLICATES_CANON"
    },
    {
      "gate_id": "docs-examples-current-surface",
      "phase": "current",
      "scope": "example",
      "condition": "every required example uses only the new grammar and passes a read-only or dry-run fixture or fails with its documented precondition",
      "failure": "DOCS_EXAMPLE_INVALID"
    },
    {
      "gate_id": "docs-page-set",
      "phase": "current",
      "scope": "page-manifest",
      "condition": "every planned page exists at its exact path with all generated links and no undeclared competing canonical CLI page",
      "failure": "DOCS_PAGE_SET_INCOMPLETE"
    }
  ]
