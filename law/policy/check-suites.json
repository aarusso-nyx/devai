{
  "$schema": "../schemas/check-suites.schema.json",
  "schemaVersion": "1.0.0",
  "id": "check-suites",
  "status": "active",
  "authority": "Architect",
  "ordering": "members-execute-in-declared-order-without-coalescing",
  "unknown_behavior": "error-never-pass",
  "prerequisites": [
    "clean-or-explicitly-described-worktree",
    "frozen-install-complete",
    "pnpm-run-devai-prepare"
  ],
  "suites": [
    {
      "name": "quick",
      "members": ["ledger-local"],
      "excluded": []
    },
    {
      "name": "standard",
      "members": ["ledger-local"],
      "excluded": []
    },
    {
      "name": "full",
      "members": ["ledger-rc"],
      "excluded": []
    },
    {
      "name": "release",
      "members": ["ledger-rc"],
      "excluded": []
    }
  ],
  "member_definitions": [
    {
      "id": "ledger-local",
      "binding": {
        "kind": "runtime-gate",
        "gate_id": "content-addressed-local-task-ledger"
      },
      "effect": "local-write",
      "cost": "medium",
      "output": "action-envelope-plus-local-task-ledger-report",
      "applicability": "both"
    },
    {
      "id": "ledger-rc",
      "binding": {
        "kind": "runtime-gate",
        "gate_id": "content-addressed-rc-task-ledger"
      },
      "effect": "local-write",
      "cost": "high",
      "output": "action-envelope-plus-rc-task-ledger-report",
      "applicability": "both"
    },
    {
      "id": "campaign",
      "binding": {
        "kind": "literal-argv",
        "argv": ["node", "scripts/check-campaign.mjs"]
      },
      "effect": "read",
      "cost": "low",
      "output": "action-envelope-plus-campaign-report",
      "applicability": "self"
    },
    {
      "id": "scorecard-page",
      "binding": {
        "kind": "literal-argv",
        "argv": ["node", "scripts/generate-scorecard-page.mjs", "--check"]
      },
      "effect": "read",
      "cost": "low",
      "output": "action-envelope-plus-scorecard-page-report",
      "applicability": "self"
    }
  ],
  "selector_definitions": [
    { "id": "action-coverage", "applicability": "both" },
    { "id": "action-effects", "applicability": "self" },
    { "id": "adrs", "applicability": "both" },
    { "id": "blueprint", "applicability": "both" },
    { "id": "change-taxonomy", "applicability": "both" },
    { "id": "ci-economy", "applicability": "both" },
    { "id": "cli-reference", "applicability": "self" },
    { "id": "dependencies", "applicability": "both" },
    { "id": "docs-governance", "applicability": "both" },
    { "id": "docs-links", "applicability": "both" },
    { "id": "forbidden-actions", "applicability": "both" },
    { "id": "glob-guards", "applicability": "both" },
    { "id": "glossary", "applicability": "both" },
    { "id": "invariant-strategies", "applicability": "both" },
    { "id": "invariants", "applicability": "both" },
    { "id": "journeys", "applicability": "both" },
    { "id": "mutation", "applicability": "both" },
    { "id": "overrides", "applicability": "both" },
    { "id": "pr-compliance", "applicability": "both" },
    { "id": "prompt-overlays", "applicability": "self" },
    { "id": "schema", "applicability": "both" },
    { "id": "schemas", "applicability": "both" },
    { "id": "sensor-integrity", "applicability": "both" },
    { "id": "test-trace", "applicability": "both" },
    { "id": "trace", "applicability": "both" },
    { "id": "translation", "applicability": "both" }
  ]
}
