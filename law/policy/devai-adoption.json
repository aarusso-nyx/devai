{
  "schemaVersion": "1.0.0",
  "policy_id": "devai.devai-adoption",
  "policy_version": "1.1.0",
  "release_verification": {
    "schemaVersion": "1.2.0",
    "policy_id": "devai.release-verification",
    "policy_version": "1.2.0",
    "release_unit": "@aarusso-nyx/devai",
    "version_source": "packages/cli/package.json",
    "default_support": "current",
    "required_check": "devai-release-gate",
    "capability_tasks": {
      "formatting-hygiene": ["format"],
      "lint": ["lint"],
      "type-integrity": ["typecheck"],
      "schema-consistency": ["generate", "test:schemas"],
      "secret-scan": ["release:static-integrity"],
      "path-portability": ["release:static-integrity"],
      "package-integrity": ["release:closure"],
      "exact-candidate": ["release:static-integrity"],
      "affected-checks": ["release:affected-anchor"],
      "dependent-checks": ["release:affected-anchor"],
      "build-integrity": ["build"],
      "unit": ["test:local-full"],
      "integration": ["test:root", "test:cli"],
      "e2e": ["test:cli"],
      "consumer": ["test:skills", "test:cli"],
      "api-compatibility": ["test:cli"],
      "migration": ["test:cli"],
      "rollback": ["test:cli"],
      "adopter-materialization": ["test:cli"],
      "security": ["test:authority", "test:evidence"],
      "database": ["test:root"],
      "tenancy": ["test:authority"],
      "provenance": ["test:evidence", "release:closure"],
      "reproducibility": ["release:closure"],
      "operational-matrix": ["test:local-full"]
    },
    "risk_capabilities": {},
    "mutation_execution": {
      "schemaVersion": "1.2.0",
      "template_id": "devai.protected-mutation-stryker.v1",
      "runner": {
        "kind": "stryker-vitest-typescript",
        "package_manager": "pnpm",
        "packages": [
          { "name": "@stryker-mutator/core", "version": "9.6.1" },
          { "name": "@stryker-mutator/typescript-checker", "version": "9.6.1" },
          { "name": "@stryker-mutator/vitest-runner", "version": "9.6.1" }
        ],
        "vitest_peer_range": ">=2"
      },
      "selection": {
        "package_root": "parent-of-roster.manifest_path",
        "source": "roster.source_selectors",
        "tests": "roster.test_selectors",
        "lockfile": "roster.lockfile_path",
        "configuration": "host-derived-ephemeral-from-roster-only",
        "invocation": "fixed-host-template-not-profile-or-candidate-script"
      },
      "runner_mapping": {
        "task_node": "roster.task_node",
        "vitest_config": "roster.vitest_config_path",
        "typescript_config": "roster.typescript_config_path",
        "typescript_config_closure": "protected-no-follow-extends-and-project-references-closure-from-roster.typescript_config_path;missing-or-out-of-bound-reference-refuses",
        "test_population": "complete-roster.test_selectors-without-runner-config-exclusions",
        "security_population": "complete-roster.source_selectors-and-test_selectors-without-runner-config-exclusions",
        "effective_options": "protected-resolved-effective-options-from-the-exact-vitest-and-typescript-config-bytes"
      },
      "mutation_targets": {
        "root": "parent-of-roster.manifest_path/src",
        "include_extensions": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
        "exclude_suffixes": [
          ".d.ts",
          ".d.tsx",
          ".d.mts",
          ".d.cts",
          ".test.ts",
          ".test.tsx",
          ".test.mts",
          ".test.cts",
          ".test.js",
          ".test.jsx",
          ".test.mjs",
          ".test.cjs",
          ".spec.ts",
          ".spec.tsx",
          ".spec.mts",
          ".spec.cts",
          ".spec.js",
          ".spec.jsx",
          ".spec.mjs",
          ".spec.cjs"
        ],
        "exclude_path_segments": ["__tests__", "test", "tests"],
        "entry_type": "regular-file",
        "order": "utf8-lexicographic-relative-package-path",
        "empty": "refuse-production-mutation",
        "binding": "separate-actual-target-population-and-projection-rule-digest-in-mutationConfiguration;never-replace-full-roster-input-identity"
      },
      "roster_order": "id-lexicographic",
      "output": {
        "raw": "protected-container-only",
        "normalized_report": "mutation-normalized-stryker-report-v2",
        "package_result": "mutation-package-result-v2",
        "finalization": "verify-mutation-evidence-v21-before-certification-evidence-retention"
      },
      "retention": {
        "carrier": "certification-evidence-sink-v3-unit-mutation-closure-v1",
        "scope": "exactly-one-closure-per-release-unit-not-per-mutation-roster-package",
        "members": "two-canonical-members-per-required-mutation-package-plus-exactly-one-summary-and-one-semantic-receipt;not-required-packages-have-no-report-or-result-member",
        "binding": "externally-finalized-unit-receipt-binds-repository-candidate-release-unit-plan-profile-mutation-policy-task-policy-digests-the-exact-canonical-output-contract-and-the-complete-sorted-member-handle-digest-size-projection",
        "continuity": "certify-and-prepare-reread-rehash-and-semantic-verify-the-sink-closure;export-rehydrates-the-exact-closure-into-the-existing-provider-result-and-the-signed-export-transcript-binds-its-receipt-and-member-projection-digests;offline-rehashes-and-semantic-verifies-only-that-portable-provider-result-copy",
        "tarball": "never-a-certified-package-entry-and-never-included-in-a-package-tarball"
      },
      "threshold_projection": {
        "source": "roster.thresholds.score_min-and-survived_max",
        "target": {
          "break": "score_min",
          "high": "score_min",
          "low": "score_min",
          "scoreMin": "score_min",
          "survivedMax": "survived_max"
        }
      },
      "toolchain_fixture_validation": {
        "production_gate": "pending-engineer-pinned-toolchain-fixture-validation-before-production-certification-invocation",
        "diagnostic_fixture_exception": {
          "execution": "existing-protected-preflight-provider-broker-on-the-fixed-host-template",
          "scope": "fixed-host-owned-diagnostic-fixture-candidate-and-frozen-dependency-identities-only",
          "result": "bounded-toolchain-compatibility-observation-only",
          "prohibitions": [
            "production-candidate-or-production-certification",
            "pass-or-certification-projection",
            "certification-evidence-semantic-receipt-or-reusable-artifact",
            "production-lifecycle-state-or-artifact-sink",
            "signing-publication-or-production-credential"
          ]
        }
      }
    },
    "mutation_roster": [
      {
        "id": "authority",
        "package": "@devai-nyx/authority",
        "task_node": "test:authority",
        "source_selectors": ["packages/authority/"],
        "test_selectors": ["packages/authority/tests/"],
        "manifest_path": "packages/authority/package.json",
        "config_paths": [
          "test-tasks.json",
          "tests/config/local.config.ts",
          "vitest.config.ts",
          "packages/authority/tsconfig.json"
        ],
        "vitest_config_path": "tests/config/local.config.ts",
        "typescript_config_path": "packages/authority/tsconfig.json",
        "sanitizer_paths": ["packages/cli/vendor/evidence-verification/src/mutation-v21.js"],
        "orchestration_paths": ["test-tasks.json"],
        "lockfile_path": "pnpm-lock.yaml",
        "toolchain_keys": ["node", "pnpm", "vitest"],
        "thresholds": { "score_min": 60, "survived_max": 50 }
      },
      {
        "id": "cli",
        "package": "@aarusso-nyx/devai",
