{
  "schemaVersion": "1.0.0",
  "policy_id": "devai.devai-adoption",
  "policy_version": "1.1.0",
  "release_verification": {
    "schemaVersion": "1.1.0",
    "policy_id": "devai.release-verification",
    "policy_version": "1.1.0",
    "release_unit": "@aarusso-nyx/devai",
    "version_source": "packages/cli/package.json",
    "default_support": "current",
    "required_check": "devai-release-gate",
    "capability_tasks": {
      "formatting-hygiene": ["format"],
      "lint": ["lint"],
      "type-integrity": ["typecheck"],
      "schema-consistency": ["generate", "test:schemas"],
      "secret-scan": ["release:static-integrity"],
      "path-portability": ["release:static-integrity"],
      "package-integrity": ["release:closure"],
      "exact-candidate": ["release:static-integrity"],
      "affected-checks": ["release:affected-anchor"],
      "dependent-checks": ["release:affected-anchor"],
      "build-integrity": ["build"],
      "unit": ["test:local-full"],
      "integration": ["test:root", "test:cli"],
      "e2e": ["test:cli"],
      "consumer": ["test:skills", "test:cli"],
      "api-compatibility": ["test:cli"],
      "migration": ["test:cli"],
      "rollback": ["test:cli"],
      "adopter-materialization": ["test:cli"],
      "security": ["test:authority", "test:evidence"],
      "database": ["test:root"],
      "tenancy": ["test:authority"],
      "provenance": ["test:evidence", "release:closure"],
      "reproducibility": ["release:closure"],
      "operational-matrix": ["test:local-full"]
    },
    "risk_capabilities": {},
    "mutation_execution": {
      "schemaVersion": "1.0.0",
      "template_id": "devai.protected-mutation-stryker.v1",
      "runner": {
        "kind": "stryker-vitest-typescript",
        "package_manager": "pnpm",
        "packages": [
          { "name": "@stryker-mutator/core", "version": "9.6.1" },
          { "name": "@stryker-mutator/typescript-checker", "version": "9.6.1" },
          { "name": "@stryker-mutator/vitest-runner", "version": "9.6.1" }
        ],
        "vitest_peer_range": ">=2"
      },
      "selection": {
        "package_root": "parent-of-roster.manifest_path",
        "source": "roster.source_selectors",
        "tests": "roster.test_selectors",
        "lockfile": "roster.lockfile_path",
        "configuration": "host-derived-ephemeral-from-roster-only",
        "invocation": "fixed-host-template-not-profile-or-candidate-script"
      },
      "roster_order": "id-lexicographic",
      "output": {
        "raw": "protected-container-only",
        "normalized_report": "mutation-normalized-stryker-report-v2",
        "package_result": "mutation-package-result-v2",
        "finalization": "verify-mutation-evidence-v21-before-certification-evidence-retention"
      },
      "threshold_projection": {
        "source": "roster.thresholds.score_min-and-survived_max",
        "target": {
          "break": "score_min",
          "high": "score_min",
          "low": "score_min",
          "scoreMin": "score_min",
          "survivedMax": "survived_max"
        }
      },
      "toolchain_fixture_validation": "pending-engineer-pinned-toolchain-fixture-validation-before-protected-invocation"
    },
    "mutation_roster": [
      {
        "id": "authority",
        "package": "@devai-nyx/authority",
        "task_node": "test:authority",
        "source_selectors": ["packages/authority/"],
        "test_selectors": ["packages/authority/tests/"],
        "manifest_path": "packages/authority/package.json",
        "config_paths": ["test-tasks.json", "tests/config/local.config.ts", "vitest.config.ts"],
        "sanitizer_paths": ["packages/cli/vendor/evidence-verification/src/mutation-v21.js"],
        "orchestration_paths": ["test-tasks.json"],
        "lockfile_path": "pnpm-lock.yaml",
        "toolchain_keys": ["node", "pnpm", "vitest"],
        "thresholds": { "score_min": 60, "survived_max": 50 }
      },
      {
        "id": "cli",
        "package": "@aarusso-nyx/devai",
        "task_node": "test:cli",
        "source_selectors": ["packages/cli/"],
        "test_selectors": ["packages/cli/tests/"],
        "manifest_path": "packages/cli/package.json",
        "config_paths": ["test-tasks.json", "tests/config/local.config.ts", "vitest.config.ts"],
        "sanitizer_paths": ["packages/cli/vendor/evidence-verification/src/mutation-v21.js"],
        "orchestration_paths": ["test-tasks.json"],
        "lockfile_path": "pnpm-lock.yaml",
        "toolchain_keys": ["node", "pnpm", "vitest"],
        "thresholds": { "score_min": 60, "survived_max": 50 }
      },
      {
        "id": "effects-check",
        "package": "@devai-nyx/effects-check",
        "task_node": "test:effects",
        "source_selectors": ["packages/effects-check/"],
        "test_selectors": ["packages/effects-check/tests/"],
        "manifest_path": "packages/effects-check/package.json",
        "config_paths": ["test-tasks.json", "tests/config/local.config.ts", "vitest.config.ts"],
        "sanitizer_paths": ["packages/cli/vendor/evidence-verification/src/mutation-v21.js"],
        "orchestration_paths": ["test-tasks.json"],
        "lockfile_path": "pnpm-lock.yaml",
        "toolchain_keys": ["node", "pnpm", "vitest"],
        "thresholds": { "score_min": 60, "survived_max": 50 }
      },
      {
        "id": "evidence",
        "package": "@devai-nyx/evidence",
        "task_node": "test:evidence",
        "source_selectors": ["packages/evidence/"],
        "test_selectors": ["packages/evidence/tests/"],
        "manifest_path": "packages/evidence/package.json",
        "config_paths": ["test-tasks.json", "tests/config/local.config.ts", "vitest.config.ts"],
        "sanitizer_paths": ["packages/cli/vendor/evidence-verification/src/mutation-v21.js"],
        "orchestration_paths": ["test-tasks.json"],
        "lockfile_path": "pnpm-lock.yaml",
        "toolchain_keys": ["node", "pnpm", "vitest"],
        "thresholds": { "score_min": 60, "survived_max": 50 }
      },
      {
        "id": "loop",
        "package": "@devai-nyx/loop",
        "task_node": "test:loop",
        "source_selectors": ["packages/loop/"],
        "test_selectors": ["packages/loop/tests/"],
        "manifest_path": "packages/loop/package.json",
        "config_paths": ["test-tasks.json", "tests/config/local.config.ts", "vitest.config.ts"],
        "sanitizer_paths": ["packages/cli/vendor/evidence-verification/src/mutation-v21.js"],
        "orchestration_paths": ["test-tasks.json"],
        "lockfile_path": "pnpm-lock.yaml",
        "toolchain_keys": ["node", "pnpm", "vitest"],
        "thresholds": { "score_min": 60, "survived_max": 50 }
      },
      {
        "id": "schemas",
        "package": "@devai-nyx/schemas",
        "task_node": "test:schemas",
        "source_selectors": ["packages/schemas/", "law/schemas/"],
        "test_selectors": ["packages/schemas/tests/"],
        "manifest_path": "packages/schemas/package.json",
        "config_paths": ["test-tasks.json", "tests/config/local.config.ts", "vitest.config.ts"],
        "sanitizer_paths": ["packages/cli/vendor/evidence-verification/src/mutation-v21.js"],
        "orchestration_paths": ["test-tasks.json"],
        "lockfile_path": "pnpm-lock.yaml",
        "toolchain_keys": ["node", "pnpm", "vitest"],
        "thresholds": { "score_min": 60, "survived_max": 50 }
      },
      {
        "id": "sensors",
        "package": "@devai-nyx/sensors",
        "task_node": "test:sensors",
        "source_selectors": ["packages/sensors/"],
        "test_selectors": ["packages/sensors/tests/"],
        "manifest_path": "packages/sensors/package.json",
        "config_paths": ["test-tasks.json", "tests/config/local.config.ts", "vitest.config.ts"],
        "sanitizer_paths": ["packages/cli/vendor/evidence-verification/src/mutation-v21.js"],
        "orchestration_paths": ["test-tasks.json"],
        "lockfile_path": "pnpm-lock.yaml",
        "toolchain_keys": ["node", "pnpm", "vitest"],
        "thresholds": { "score_min": 60, "survived_max": 50 }
      },
      {
        "id": "skills",
        "package": "@devai-nyx/skills",
        "task_node": "test:skills",
        "source_selectors": ["packages/skills/"],
        "test_selectors": ["packages/skills/tests/"],
        "manifest_path": "packages/skills/package.json",
        "config_paths": ["test-tasks.json", "tests/config/local.config.ts", "vitest.config.ts"],
        "sanitizer_paths": ["packages/cli/vendor/evidence-verification/src/mutation-v21.js"],
        "orchestration_paths": ["test-tasks.json"],
        "lockfile_path": "pnpm-lock.yaml",
        "toolchain_keys": ["node", "pnpm", "vitest"],
        "thresholds": { "score_min": 60, "survived_max": 50 }
      },
      {
        "id": "spec",
        "package": "@devai-nyx/spec",
        "task_node": "test:spec",
        "source_selectors": ["packages/spec/"],
        "test_selectors": ["packages/spec/tests/"],
        "manifest_path": "packages/spec/package.json",
        "config_paths": ["test-tasks.json", "tests/config/local.config.ts", "vitest.config.ts"],
        "sanitizer_paths": ["packages/cli/vendor/evidence-verification/src/mutation-v21.js"],
        "orchestration_paths": ["test-tasks.json"],
        "lockfile_path": "pnpm-lock.yaml",
        "toolchain_keys": ["node", "pnpm", "vitest"],
        "thresholds": { "score_min": 60, "survived_max": 50 }
      },
      {
        "id": "utils",
        "package": "@devai-nyx/utils",
        "task_node": "test:utils",
        "source_selectors": ["packages/utils/"],
        "test_selectors": ["packages/utils/tests/"],
        "manifest_path": "packages/utils/package.json",
        "config_paths": ["test-tasks.json", "tests/config/local.config.ts", "vitest.config.ts"],
        "sanitizer_paths": ["packages/cli/vendor/evidence-verification/src/mutation-v21.js"],
        "orchestration_paths": ["test-tasks.json"],
        "lockfile_path": "pnpm-lock.yaml",
        "toolchain_keys": ["node", "pnpm", "vitest"],
        "thresholds": { "score_min": 60, "survived_max": 50 }
      }
    ]
  }
}
