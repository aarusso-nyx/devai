  },
  "approvedSource": null,
  "activation": {
    "provenanceProof": null,
    "emissionPermitted": false,
    "verificationPermitted": false
  },
  "activationModel": {
    "currentState": "inactive",
    "futureActivationRequiresForwardAdrPolicyAndSchema": true,
    "approvedSourceRequirement": "non-null-exact-const-repository-commit-tree",
    "provenanceSourceEquality": "provenanceProof.source-equals-approvedSource",
    "vendorProofRequirement": "vendor-root-manifestPath-manifestDigest-sourceCommit-sourceTree-byteSetDigest-and-source-vendor-byte-equality",
