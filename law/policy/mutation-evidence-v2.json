    "schemaVersion": "2.1.0"
  },
  "artifactModel": {
    "authoritativePackageArtifacts": ["normalized-stryker-report", "package-result"],
    "canonicalization": "rfc8785-jcs-utf8",
    "cacheKey": "inputDigest",
    "contentAddress": "artifact-sha256",
    "storeLayout": ".devai/state/mutation/v2/store/inputs/<inputDigest>/objects/<artifactSha256>.<report|result>.json",
    "writeOnce": true,
    "candidateSpecificPackageBytes": false,
    "compositionWritesExecutionArtifacts": false,
    "nondeterministicDurationInImmutableEvidence": false,
    "refinalizationMutationProcessCount": 0,
    "refinalizationDeterministicAcross": [
      "time",
      "cwd",
      "unrelated-environment",
      "ambient-host-state"
    ],
    "verbatimRunnerOutputPermitted": false
  },
  "inputIdentity": {
    "digest": "digestModel.inputDigest",
    "bindings": [
      "source",
      "tests",
      "manifests",
      "mutationConfiguration",
      "runner",
      "roster",
      "thresholds",
      "sanitizer",
      "lockfile",
      "environment",
      "toolchain",
      "semanticRebind"
    ],
    "bindingFields": ["canonicalization", "memberCount", "populationDigest", "selectionRuleDigest"],
    "rawEnvironmentOrToolchainValuesPermitted": false,
    "wholeRosterBindingInEveryPackage": true,
    "equalityScope": "output-contract-equals-package-result-equals-evidence-reference-equals-composition-entry-equals-semantic-receipt",
    "errorPrecedence": [
      "missing-required-binding=>MUTATION_INPUT_IDENTITY_MISSING",
      "present-but-divergent-identity=>MUTATION_INPUT_DIGEST_MISMATCH"
    ],
    "missingBehavior": "deny-reuse",
    "mismatchBehavior": "deny-reuse",
    "additionalBehavior": "deny-reuse"
  },
  "thresholdModel": {
    "fields": ["break", "high", "low", "scoreMin", "survivedMax"],
    "ordering": "zero<=low<=high<=100-and-zero<=break<=100-and-zero<=scoreMin<=100",
    "effectiveScoreFloor": "max(break,scoreMin)",
    "survivorCondition": "Survived<=survivedMax",
    "passCondition": "score>=max(break,scoreMin)-and-Survived<=survivedMax",
    "weakeningPermitted": false
  },
  "measurementModel": {
    "requiredTotalMutants": "targetCensus.totalMutants>0",
    "requiredScoredMutants": "binary64-add(binary64-add(binary64-add(Killed,Timeout),Survived),NoCoverage)>0",
    "zeroRequiredPopulationDisposition": "incomplete",
    "zeroRequiredPopulationPassed": false,
    "zeroRequiredPopulationError": "MUTATION_INCOMPLETE",
    "genuineAbsenceRepresentation": "receipt-proven-not-required"
  },
  "dispositions": {
    "declared": ["executed", "reused", "not-required"],
    "provenanceCompatibility": {
      "executed": "fresh",
      "reused": "reused",
      "not-required": null
    },
    "origin": {
      "executed": "null",
      "reused": "producing-candidate-semantic-receipt-and-evidence-set",
      "not-required": "absent"
    },
    "notRequired": {
      "isPass": false,
      "artifactReferencePermitted": false,
      "permittedReasons": [
        "no-mutatable-production-surface",
        "package-excluded-by-approved-release-profile"
      ]
    },
    "aggregatePreservesCounts": true,
    "allNotRequiredVerdict": "not-applicable",
    "allNotRequiredPassed": false
  },
  "statusModel": {
    "rawStatuses": [
      "CompileError",
      "Ignored",
      "Killed",
      "NoCoverage",
      "Pending",
      "RuntimeError",
      "Survived",
      "Timeout"
    ],
    "detectedScored": ["Killed", "Timeout"],
    "undetectedScored": ["Survived", "NoCoverage"],
    "preservedNonScored": ["CompileError", "Ignored"],
    "completionBlocking": ["Pending"],
    "passBlocking": ["RuntimeError", "infrastructure-failure"],
    "compileErrorThresholdAdded": false,
    "ignoredRulesBoundBy": "mutationConfiguration"
  },
  "scoreModel": {
    "numericModel": "ieee-754-binary64-round-to-nearest-ties-to-even",
    "detected": "binary64-add(Killed,Timeout)",
    "scored": "binary64-add(binary64-add(detected,Survived),NoCoverage)",
    "score": "scored-binary64-equals-zero-question-100-colon-binary64-multiply(binary64-divide(detected,scored),100)",
    "reportedComparison": "samevalue-and-not-negative-zero"
  },
  "digestModel": {
    "framedDigestEquation": "SHA-256(ASCII(domain)||0x00||U64BE(byteLength(payloadBytes))||payloadBytes)",
    "domainEncoding": "ascii",
    "separatorHex": "00",
    "separatorOctetCount": 1,
    "lengthEncoding": "u64be-eight-octet-unsigned",
    "payloadEncoding": "rfc8785-jcs-utf8",
    "artifactByteDigest": {
      "algorithm": "sha256",
      "payload": "exact-rfc8785-jcs-utf8-document-bytes",
      "domainOrFramingPermitted": false
    },
    "domains": {
      "outputContractDigest": "devai:mutation-output-contract:v2.1",
      "packageResultSetDigest": "devai:mutation-package-result-set:v2.1",
      "compositionEntryDigest": "devai:mutation-composition-entry:v2.1",
      "evidenceRefDigest": "devai:mutation-evidence-ref:v2.1",
      "inputDigest": "devai:mutation-input:v2.1",
      "evidenceSetDigest": "devai:mutation-composition:v2.1",
      "semanticReceiptDigest": "devai:mutation-semantic-receipt:v2.1"
    },
    "payloads": {
      "outputContractDigest": {
        "type": "object",
        "source": "complete-output-contract-document",
        "excludedMembers": []
      },
      "packageResultSetDigest": {
        "type": "array",
        "source": "required-package-results",
        "order": "output-contract-required-package-order",
        "itemType": "object",
        "itemMembers": ["packageName", "resultDigest"],
        "additionalItemMembersPermitted": false
      },
      "compositionEntryDigest": {
        "type": "object",
        "source": "complete-composition-package-entry",
        "excludedMembers": []
      },
      "evidenceRefDigest": {
        "type": "object",
        "source": "complete-evidence-reference",
        "excludedMembers": []
      },
      "inputDigest": {
        "type": "object",
        "source": "complete-inputProjection",
        "excludedMembers": []
      },
      "evidenceSetDigest": {
        "type": "array",
        "source": "complete-composition-packages-array",
        "order": "output-contract-package-order",
        "includesNotRequiredEntries": true
      },
      "semanticReceiptDigest": {
        "type": "object",
        "source": "complete-semantic-receipt",
        "excludedMembers": ["receiptDigest"]
      }
    }
  },
  "composition": {
    "candidateSpecific": true,
    "exactRosterBijection": true,
    "packageOrder": "output-contract-order",
    "inputDigestEquality": "output-contract-equals-package-result-equals-evidence-reference-equals-composition-entry-equals-semantic-receipt",
    "evidenceSetDigest": "digestModel.evidenceSetDigest",
    "aggregateCounts": [
      "packageCount",
      "executedPackageCount",
      "reusedPackageCount",
      "notRequiredPackageCount"
    ],
    "pureFinalizer": true,
    "requiredPackagePopulation": "requirement-equals-required",
    "pooledStatusTotals": "checked-safe-integer-sum-of-required-package-statusTotals-only",
    "pooledDetected": "binary64-add(Killed,Timeout)",
    "pooledScored": "binary64-add(binary64-add(pooledDetected,Survived),NoCoverage)",
    "pooledScore": "pooledScored-binary64-equals-zero-question-null-colon-binary64-multiply(binary64-divide(pooledDetected,pooledScored),100)",
    "passCondition": "requiredPackageCount>=1-and-every-required-complete-and-passed",
    "unknownCondition": "any-required-incomplete",
    "failCondition": "requiredPackageCount>=1-and-every-required-complete-and-any-required-not-passed",
    "verdictPrecedence": ["unknown", "pass", "fail"],
    "notRequiredContributesStatusOrScore": false,
    "allNotRequired": {
      "complete": true,
      "score": null,
      "statusTotals": "all-zero",
      "verdict": "not-applicable",
      "passed": false
    }
  },
  "semanticReceiptModel": {
    "requiredForExportAndOfflineVerification": true,
