    "rawEnvironmentOrToolchainValuesPermitted": false,
    "missingBehavior": "deny-reuse",
    "mismatchBehavior": "deny-reuse",
    "additionalBehavior": "deny-reuse"
  },
  "dispositions": {
    "declared": ["executed", "reused", "not-required"],
    "provenanceCompatibility": {
      "executed": "fresh",
      "reused": "reused",
      "not-required": null
    },
    "notRequired": {
      "isPass": false,
      "artifactReferencePermitted": false,
      "permittedReasons": [
        "no-mutatable-production-surface",
        "package-excluded-by-approved-release-profile"
      ]
    },
    "aggregatePreservesCounts": true
  },
  "statusModel": {
    "rawStatuses": [
      "CompileError",
      "Ignored",
      "Killed",
      "NoCoverage",
      "Pending",
      "RuntimeError",
      "Survived",
      "Timeout"
    ],
    "detectedScored": ["Killed", "Timeout"],
    "undetectedScored": ["Survived", "NoCoverage"],
    "preservedNonScored": ["CompileError", "Ignored"],
    "completionBlocking": ["Pending"],
    "passBlocking": ["RuntimeError", "infrastructure-failure"],
    "compileErrorThresholdAdded": false,
    "ignoredRulesBoundBy": "mutationConfiguration"
  },
  "scoreModel": {
    "numericModel": "ieee-754-binary64-round-to-nearest-ties-to-even",
    "detected": "binary64-add(Killed,Timeout)",
    "scored": "binary64-add(binary64-add(detected,Survived),NoCoverage)",
    "score": "scored-binary64-equals-zero-question-100-colon-binary64-multiply(binary64-divide(detected,scored),100)",
    "reportedComparison": "samevalue-and-not-negative-zero",
    "thresholds": ["break", "high", "low"],
    "passThreshold": "score-greater-than-or-equal-to-break"
  },
  "composition": {
    "candidateSpecific": true,
    "exactRosterBijection": true,
    "packageOrder": "output-contract-order",
    "evidenceSetDigest": "sha256-domain-devai-mutation-composition-v2.1-nul-u64be-length-rfc8785-jcs-complete-ordered-package-entry-array",
    "aggregateCounts": [
      "packageCount",
      "executedPackageCount",
      "reusedPackageCount",
      "notRequiredPackageCount"
    ],
    "pureFinalizer": true
  },
  "compatibility": {
    "v1ReadOnly": true,
