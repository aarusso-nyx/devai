  },
  "artifactModel": {
    "authoritativeArtifacts": ["normalized-stryker-report", "package-result"],
    "canonicalization": "rfc8785-jcs-utf8",
    "contentAddress": "sha256-of-canonical-artifact-bytes",
    "storeLayout": ".devai/state/mutation/v2/store/sha256/<inputDigest>/{report.json,result.json}",
    "candidateSpecificPackageBytes": false,
