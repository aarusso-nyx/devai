    "publication-receipt-emitted-by-devai-action",
    "published-state-record-appended",
    "publish-produced-published-state",
    "derived-state-persisted",
    "read-action-persisted-state",
    "read-action-nondeterministic-output",
    "receipt-treated-as-authorization",
    "observation-treated-as-transition",
    "unknown-receipt-kind",
    "unknown-action-id",
    "unknown-state",
    "rlo-head-not-publication-dispatched",
    "rlo-head-verified-against-mismatch",
    "rlo-receipt-dispatched-state-mismatch",
    "rlo-derived-state-receipt-mismatch",
    "rlo-receipt-digest-mismatch",
    "rlo-candidate-identity-mismatch",
