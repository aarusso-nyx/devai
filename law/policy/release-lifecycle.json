{
  "$schema": "../schemas/release-lifecycle-policy.schema.json",
  "schemaVersion": "1.0.0",
  "id": "release-lifecycle",
  "status": "active",
  "authority": "Architect",
  "policy_version": "2.0.0",
  "state_record_schema": "law/schemas/release-lifecycle-state.schema.json",
  "authorization_event_schema": "law/schemas/effect-authorization-event.schema.json",
  "receipt_schemas": {
    "plan_receipt_schema": "law/schemas/release-plan-receipt.schema.json",
    "offline_verification_receipt_schema": "law/schemas/release-offline-verification-receipt.schema.json",
    "publication_receipt_schema": "law/schemas/release-publication-receipt.schema.json",
    "lifecycle_observation_schema": "law/schemas/release-lifecycle-observation.schema.json"
  },
  "plan_determination": {
    "kernel_id": "devai.kernel.release-plan-determination.v1",
    "required_inputs": [
      {"order": 1, "kind": "release-intent", "source": "invocation-provided-release-intent-document", "schema": "law/schemas/release-intent.schema.json", "canonical_bytes": "utf-8-rfc8785-jcs"},
      {"order": 2, "kind": "release-verification-profile", "source": "law/policy/release-verification.json", "schema": "law/schemas/release-verification-profile.schema.json", "canonical_bytes": "utf-8-rfc8785-jcs"},
      {"order": 3, "kind": "release-lifecycle-policy", "source": "law/policy/release-lifecycle.json", "schema": "law/schemas/release-lifecycle-policy.schema.json", "canonical_bytes": "utf-8-rfc8785-jcs"},
      {"order": 4, "kind": "action-registry-policy", "source": "law/policy/action-registry.json", "schema": "law/schemas/action-registry.schema.json", "canonical_bytes": "utf-8-rfc8785-jcs"}
    ],
    "semver": {
      "grammar": "semver-2.0.0",
      "transition_order": ["patch", "minor", "major", "prerelease", "support-promotion"],
      "block_conditions": ["invalid-semver", "downgrade", "same-version-without-support-promotion", "support-promotion-requires-lts"]
    },
    "support": {
      "source": "release-intent.support",
      "values": ["preview", "current", "lts"],
      "lts_requires_nonempty_mutation_roster": true
    },
    "impact": {
      "source": "release-intent.change_kind",
      "values": ["documentation", "metadata", "behavioral"],
      "missing_defaults_to": "behavioral"
    },
    "known_risks": ["authentication", "authorization", "tenancy", "rls", "cryptography", "secrets", "credentials", "database", "migration", "release-integrity", "evidence", "provenance", "publication", "ledger", "mutation-policy", "test-policy", "test-configuration", "sanitization", "public-api", "export-map", "package-boundary", "lockfile", "toolchain", "cross-package", "large-change", "protected-resource"],
    "unknown_risk_behavior": "block",
    "unconditional_floor": ["formatting-hygiene", "lint", "type-integrity", "schema-consistency", "secret-scan", "path-portability", "package-integrity", "exact-candidate"],
    "transition_capabilities": {
      "patch": ["affected-checks", "dependent-checks", "build-integrity"],
      "prerelease": ["affected-checks", "dependent-checks", "build-integrity"],
      "minor": ["unit", "integration", "e2e", "consumer", "api-compatibility", "adopter-materialization"],
      "major": ["unit", "integration", "e2e", "consumer", "api-compatibility", "migration", "rollback", "adopter-materialization", "security", "database", "tenancy", "provenance", "reproducibility"],
      "support-promotion": ["unit", "integration", "e2e", "consumer", "api-compatibility", "migration", "rollback", "adopter-materialization", "security", "database", "tenancy", "provenance", "reproducibility", "operational-matrix"]
    },
    "lts_capabilities": ["unit", "integration", "e2e", "consumer", "api-compatibility", "migration", "rollback", "adopter-materialization", "security", "database", "tenancy", "provenance", "reproducibility", "operational-matrix"],
    "risk_capability_rules": [
      {"when_any_risk": true, "add": ["security", "integration"]},
      {"risks": ["tenancy", "rls"], "add": ["tenancy"]},
      {"risks": ["database", "migration"], "add": ["database"]},
      {"risks": ["public-api", "export-map", "package-boundary"], "add": ["api-compatibility", "consumer"]},
      {"risks": ["release-integrity", "evidence", "provenance", "publication", "ledger"], "add": ["provenance", "reproducibility"]},
      {"risks": ["lockfile", "toolchain", "cross-package", "large-change"], "add": ["integration", "consumer"]}
    ],
    "capability_selection": "sorted-unique-union-of-unconditional-floor-transition-support-risk-profile-risk-and-owner-escalation-capabilities",
    "missing_capability_or_unknown_task_behavior": "block",
    "mutation_selection": [
      "lts-selects-full-roster",
      "otherwise-any-risk-or-major-or-minor-selects-targeted",
      "otherwise-behavioral-selects-affected",
      "otherwise-selects-none",
      "non-lts-empty-mutation-roster-remains-ready-with-mutation-none-and-not-required-reason-mutation-roster-empty-when-selected-mutation-is-not-none"
    ]
  },
