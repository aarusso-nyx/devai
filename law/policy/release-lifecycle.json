  "read_action_purity": {
    "actions": ["release plan", "release offline-verify", "release resume"],
    "persists_repository_state": false,
    "appends_state_record": false,
    "writes_receipt_file": false,
    "emits_to": "stdout",
    "deterministic": true,
    "grants_authority": false
  },
  "publication_separation": {
    "evidence_action": "release evidence-publish",
    "product_action": "release publish",
    "evidence_implies_product": false,
    "product_implies_evidence": false,
    "shared_authorization": false
  },
  "publication_dispatch": {
    "dispatch_action": "release publish",
    "dispatch_state": "publication_dispatched",
    "terminal_state": "published",
    "terminal_state_persisted": false,
    "terminal_state_appendable": false,
    "observed_by_action": "release resume",
    "observation_schema": "law/schemas/release-lifecycle-observation.schema.json",
    "receipt_kind": "release-publication-receipt",
    "receipt_schema": "law/schemas/release-publication-receipt.schema.json",
    "receipt_emitter": "protected-external-workflow",
    "receipt_emitted_by_devai_action": false,
    "receipt_grants_authority": false,
    "receipt_binds_identity": [
      "publication-dispatched-state",
      "candidate",
      "artifact",
      "trust"
    ]
  },
  "observation_kernel": {
    "kernel_id": "devai.kernel.release-lifecycle-observation.v1",
    "mandatory": true,
    "observation_schema": "law/schemas/release-lifecycle-observation.schema.json",
    "receipt_canonicalization_kernel_id": "devai.kernel.publication-receipt-canonicalization.v1",
    "schema_validation_alone_derives_published": false,
    "mismatch_behavior": "derive-no-published",
    "algorithm": [
      "load-the-recorded-persisted-head-for-the-exact-observed-candidate",
      "require-the-head-state-to-be-publication_dispatched",
      "require-published-verified_against-state_id-and-record_digest_sha256-to-equal-the-head-state_id-and-record_digest_sha256",
      "require-the-publication-receipt-dispatched_state-state_id-and-record_digest_sha256-to-equal-the-head-state_id-and-record_digest_sha256",
      "require-published-receipt-receipt_id-and-receipt_digest_sha256-to-equal-the-published-derived-state-entry-receipt_id-and-receipt_digest_sha256",
      "recompute-the-publication-receipt-signed-payload-digest-receipt-id-and-receipt-digest-under-the-receipt-canonicalization-kernel-and-compare",
      "require-the-receipt-candidate-release_unit-version-commit-and-tree-to-equal-the-observed-candidate",
      "require-the-receipt-artifact-set-to-equal-the-dispatched-artifact-set-by-kind-path-sha256-and-size_bytes",
      "require-the-receipt-workflow-repository-workflow_path-workflow_sha-run_id-run_attempt-and-protected-to-equal-the-recorded-dispatch-workflow-identity",
      "require-the-receipt-trust_root_id-key_id-and-signature_algorithm-to-be-declared-trusted-and-the-signature-to-verify-over-the-recomputed-signed-payload-digest",
      "derive-published-only-when-every-preceding-step-holds-and-otherwise-derive-no-published"
    ],
    "errors": [
      "rlo-head-not-publication-dispatched",
      "rlo-head-verified-against-mismatch",
      "rlo-receipt-dispatched-state-mismatch",
      "rlo-derived-state-receipt-mismatch",
      "rlo-receipt-digest-mismatch",
      "rlo-candidate-identity-mismatch",
      "rlo-artifact-identity-mismatch",
      "rlo-workflow-identity-mismatch",
      "rlo-trust-identity-mismatch",
      "rlo-signature-invalid",
      "rlo-semantic-verification-not-performed"
    ]
  },
  "fail_closed": [
    "missing-prior-state",
    "prior-state-digest-mismatch",
    "repository-identity-mismatch",
    "candidate-identity-mismatch",
    "input-digest-mismatch",
