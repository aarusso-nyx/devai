    {
      "state": "preflight_passed",
      "order": 2,
      "persisted": true,
      "appendable": true,
      "derivation": "state-record",
      "produced_by_action": "release preflight",
      "derived_by_action": null,
      "derived_from_receipt": null,
      "requires_state": null
    },
    {
      "state": "certified",
      "order": 3,
      "persisted": true,
      "appendable": true,
      "derivation": "state-record",
