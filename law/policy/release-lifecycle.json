      "state": "planned",
      "order": 1,
      "persisted": false,
      "appendable": false,
      "derivation": "plan-receipt",
      "produced_by_action": null,
      "derived_by_action": "release plan",
      "derived_from_receipt": "release-plan-receipt",
      "requires_state": null
