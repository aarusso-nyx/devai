  "actions": [
    {
      "action_id": "release certify",
      "effect": "harness-write",
      "initiator_roles": ["inspector"],
      "requires_prior_state": ["preflight_passed"],
      "requires_receipts": [],
      "produces_state": "certified",
      "appends_state_record": true,
      "persists_repository_state": true,
      "emits_receipt": null,
      "observational": false,
      "grants_publication_authority": false,
      "binds_identity": ["repository", "candidate", "input", "evidence", "prior-state"],
      "authorization": {
        "required": false,
        "authorized_by": null,
        "one_time": false,
        "wildcard_permitted": false
      }
    },
    {
      "action_id": "release evidence-publish",
      "effect": "remote-write",
      "initiator_roles": ["owner"],
      "requires_prior_state": ["exported"],
      "requires_receipts": ["release-offline-verification-receipt"],
      "produces_state": "evidence_published",
      "appends_state_record": true,
      "persists_repository_state": true,
      "emits_receipt": null,
      "observational": false,
      "grants_publication_authority": true,
      "binds_identity": [
        "repository",
        "candidate",
        "input",
        "evidence",
        "artifact",
        "prior-state",
        "offline-verification-receipt"
      ],
      "authorization": {
        "required": true,
        "authorized_by": "owner",
        "one_time": true,
        "wildcard_permitted": false
