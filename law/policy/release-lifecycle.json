      "grants_publication_authority": false,
      "binds_identity": [
        "repository",
        "candidate",
        "input",
        "evidence",
        "artifact",
        "prior-state"
      ],
      "authorization": {
        "required": false,
        "authorized_by": null,
        "one_time": false,
        "wildcard_permitted": false
      }
