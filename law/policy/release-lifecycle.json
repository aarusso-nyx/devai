    {
      "state": "offline_verified",
      "order": 6,
      "persisted": false,
      "appendable": false,
      "derivation": "offline-verification-receipt",
      "produced_by_action": null,
      "derived_by_action": "release offline-verify",
      "derived_from_receipt": "release-offline-verification-receipt",
      "requires_state": "exported"
