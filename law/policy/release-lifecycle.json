      "requires_receipts": [],
      "produces_state": null,
      "appends_state_record": false,
      "persists_repository_state": false,
      "emits_receipt": "release-offline-verification-receipt",
      "observational": true,
      "grants_publication_authority": false,
      "binds_identity": ["repository", "candidate", "evidence", "artifact", "prior-state", "verifier"],
      "authorization": {
        "required": false,
        "authorized_by": null,
        "one_time": false,
        "wildcard_permitted": false
