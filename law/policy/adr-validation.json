{
  "$schema": "../schemas/adr-validation-policy.schema.json",
  "schemaVersion": "1.0.0",
  "id": "adr-validation",
  "status": "active",
  "authority": "Architect",
  "policy_version": "2.5.0",
  "record_schema": "law/schemas/adr-v2.schema.json",
  "scan": {
    "root": "law/adr",
    "recursive": true,
    "include": ["*.md", "**/*.md"],
    "extension_match": "case-insensitive",
    "follow_symlinks": false,
    "unreadable_behavior": "fail",
    "unmatched_file_behavior": "fail",
    "empty_directory_behavior": "pass"
  },
  "identity": {
    "id_pattern": "^ADR-[A-Z][A-Z0-9]{1,15}(?:-[A-Z][A-Z0-9]{1,15})*-[0-9]{4}$",
    "id_required": true,
    "scope_source": "id-scope-segments",
    "filename_binding": "basename-starts-with-id-followed-by-hyphen",
    "uniqueness": "id-unique-across-recursive-scan"
  },
  "lifecycle": {
    "statuses": ["proposed", "accepted", "rejected", "superseded"],
    "binding_statuses": ["accepted"],
    "unknown_status_behavior": "fail"
  },
  "body": {
    "required_sections": [
      "Status",
      "Context",
      "Decision",
      "Consequences",
      "Alternatives Considered",
      "Affected Rules",
      "Inspector Adversarial Acceptance"
    ],
    "missing_section_behavior": "fail"
  },
  "supersession": {
    "recorded_on": "superseding-record-only",
    "edit_superseded_record": false,
    "unresolved_reference_behavior": "fail",
    "self_reference_behavior": "fail"
  },
  "semantic_resolver": {
    "kernel_id": "devai.kernel.adr-supersession-resolution.v3",
    "mandatory": true,
    "schema_validation_alone_establishes_effective_authority": false,
    "effective_authority_rule": "unique-effective-accepted-head-per-affected-rule-subject-lineage",
    "status_rewrite_permitted": false,
    "superseded_record_edit_permitted": false,
    "affected_rule_subject_contract": {
      "kind": "canonical-nfc-repository-relative-posix-governed-or-review-subject",
      "unicode_normalization": "NFC",
      "input_must_already_be_nfc": true,
      "forbidden": [
        "absolute-path",
        "windows-drive-absolute",
        "backslash",
        "empty-segment",
        "dot-segment",
        "dotdot-segment",
        "duplicate-separator",
        "nul",
        "glob",
        "trailing-separator",
        "non-nfc-alias"
      ],
      "comparison": "rfc8785-jcs-utf8-byte-lexicographic-ascending"
    },
    "output_contract": {
      "result_schema_pointer": "law/schemas/adr-validation-policy.schema.json#/$defs/adrValidationResult",
      "canonical_comparison": "rfc8785-jcs-utf8-byte-lexicographic-ascending",
      "validate_adrs_envelope": {
        "top_level_fields": [
          "ok",
          "kernel_id",
          "semantic_resolution_performed",
          "files_scanned",
          "errors",
          "adrs",
          "effective_authorities",
          "subject_authorities"
        ],
        "additional_properties": false,
        "error_entry": {
          "required_fields": ["file", "message"],
          "optional_fields": ["code", "pointer"],
          "additional_properties": false
        }
      },
      "adr_projection": {
        "array_field": "adrs",
        "adr_order": "rfc8785-jcs-utf8-byte-lexicographic-ascending",
        "adr_id_field": "adr_id",
        "format_values": ["v2", "legacy-catalog"],
        "public_fields": [
          "file",
          "adr_id",
          "title",
          "status",
          "date",
          "format",
          "supersedes",
          "affected_rules",
          "effective",
          "effective_affected_rules"
        ],
        "preserved_declared_fields": ["adr_id", "affected_rules"],
        "affected_rules_order": "declaration-order-preserved",
        "effective_affected_rules": {
          "field": "effective_affected_rules",
          "type": "array<affected-rule-subject>",
          "ordering": "rfc8785-jcs-utf8-byte-lexicographic-ascending",
          "unique": true,
          "definition": "declared subjects for which this record is the effective accepted head of at least one subject-lineage"
        },
        "effective": {
          "field": "effective",
          "type": "boolean",
          "definition": "true-if-and-only-if-effective_affected_rules-is-nonempty"
        }
      },
      "effective_authorities": {
        "field": "effective_authorities",
        "type": "array<adr-reference>",
        "ordering": "rfc8785-jcs-utf8-byte-lexicographic-ascending",
        "unique": true,
        "definition": "sorted-unique compatibility union of every subject_authorities effective_head"
      },
      "subject_authorities": {
        "field": "subject_authorities",
        "type": "array<subject-authority-entry>",
        "ordering": "subject-then-lineage_members-rfc8785-jcs-utf8-byte-lexicographic-ascending",
        "entry_fields": [
          {
            "name": "subject",
            "type": "affected-rule-subject",
            "ordering": "rfc8785-jcs-utf8-byte-lexicographic-ascending"
          },
          {
            "name": "lineage_members",
            "type": "array<adr-reference>",
            "ordering": "rfc8785-jcs-utf8-byte-lexicographic-ascending",
            "unique": true
          },
          { "name": "effective_head", "type": "adr-reference" }
        ],
        "definition": "one entry for every deterministic weakly connected accepted subject-lineage"
      },
      "downstream_coverage_subject_source": "adrs[].effective_affected_rules",
      "result_state": {
        "ok_true_iff": "semantic-resolution-performed-and-errors-empty",
        "semantic_resolution_false": "ok-false-and-at-least-one-adr-semantic-resolution-not-performed-error",
        "ok_false_authority": "all-adrs-non-effective-with-empty-effective-affected-rules-and-empty-top-level-authorities"
      },
      "semantic_rules": [
        "adrs-must-be-sorted-by-adr-id-rfc8785-jcs-utf8-byte-lexicographic-ascending-and-adr-id-must-be-unique",
        "each-effective-affected-rules-array-must-be-rfc8785-jcs-utf8-byte-lexicographic-sorted-unique-and-a-subset-of-that-adrs-declared-affected-rules",
        "each-effective-must-equal-whether-that-adrs-effective-affected-rules-array-is-nonempty",
        "subject-authorities-must-be-sorted-by-subject-then-lineage-members-rfc8785-jcs-utf8-byte-lexicographic-ascending-each-lineage-members-array-must-be-sorted-unique-and-contain-its-effective-head",
        "each-subject-authority-member-and-head-must-reference-a-known-adr-member-must-declare-the-subject-and-members-must-exactly-equal-that-subjects-weak-component",
        "each-subject-authority-head-must-be-the-unique-effective-adr-for-its-subject-lineage-and-biject-with-that-heads-effective-affected-rules-subject",
        "effective-authorities-must-equal-the-rfc8785-jcs-utf8-byte-lexicographic-sorted-unique-set-of-subject-authority-effective-heads-and-of-adr-ids-with-nonempty-effective-affected-rules",
        "result-state-must-enforce-ok-iff-semantic-resolution-performed-and-errors-empty-and-ok-false-must-grant-no-effective-authority"
      ]
    },
    "resolvable_legacy_references": [
      {
        "reference": "ADR-014",
        "path": "ADR-014-release-verification-profiles.md",
        "disposition": "preserved-pre-v2-record"
      }
    ],
    "algorithm": [
      "verify-the-exception-catalog-digest-over-the-rfc8785-jcs-canonical-entries-array-including-every-legacy-metadata-field",
      "materialize-each-preserved-pre-v2-record-from-catalog-metadata-only-after-its-path-and-file-byte-digest-match",
      "require-an-exact-bijection-between-materialized-legacy-record-reference-path-pairs-and-resolvable_legacy_references",
      "collect-every-v2-and-materialized-legacy-record-with-its-id-status-supersedes-list-and-affected-rule-subjects",
      "validate-every-affected-rule-subject-as-an-already-nfc-canonical-repository-relative-posix-governed-or-review-subject-without-filesystem-or-git-access-and-reject-an-accepted-record-with-an-empty-invalid-or-duplicate-subject-set",
      "reject-when-two-scanned-records-declare-the-same-id",
      "resolve-every-supersedes-entry-to-exactly-one-scanned-record-id-or-one-catalogued-legacy-reference",
      "reject-when-a-supersedes-entry-resolves-to-nothing",
      "reject-when-a-supersedes-entry-resolves-to-the-declaring-record-itself",
      "build-one-global-directed-supersession-edge-for-every-resolved-record-reference-before-subject-projection",
      "reject-when-the-global-supersession-graph-contains-any-cycle",
      "build-one-directed-edge-for-each-normalized-affected-rule-subject-in-the-intersection-of-an-accepted-superseding-record-and-its-resolved-target",
      "reject-when-an-affected-rule-subject-supersession-graph-contains-any-cycle",
      "partition-each-affected-rule-subject-supersession-graph-into-deterministic-weakly-connected-subject-lineages",
      "compute-the-transitive-closure-of-supersession-over-accepted-records-per-affected-rule-subject-lineage",
      "mark-an-accepted-record-non-effective-only-for-an-affected-rule-subject-lineage-superseded-directly-or-transitively-by-an-accepted-record",
      "define-the-effective-accepted-head-of-an-affected-rule-subject-lineage-as-an-accepted-record-for-that-subject-not-marked-non-effective",
      "reject-when-one-target-has-more-than-one-effective-accepted-direct-successor-for-the-same-affected-rule-subject",
      "reject-when-an-affected-rule-subject-lineage-has-more-than-one-effective-accepted-head",
      "emit-an-instance-validatable-adr-validation-result-with-sorted-adrs-that-preserve-affected-rules-and-add-sorted-effective-affected-rules-and-derived-effective",
      "emit-effective-authorities-as-the-sorted-unique-union-of-subject-authority-effective-heads",
      "emit-sorted-subject-authorities-with-subject-sorted-lineage-members-and-effective-head",
      "require-every-downstream-coverage-consumer-to-use-adrs-effective-affected-rules"
    ],
    "errors": [
      "adr-legacy-catalog-metadata-invalid",
      "adr-legacy-reference-allowlist-mismatch",
      "adr-affected-rule-subject-invalid",
      "adr-duplicate-id",
      "adr-unresolved-supersedes-reference",
      "adr-uncatalogued-legacy-reference",
      "adr-self-supersedes-reference",
      "adr-supersession-cycle",
      "adr-multiple-accepted-direct-successors",
      "adr-conflicting-supersession-branch",
      "adr-multiple-effective-accepted-heads",
      "adr-superseded-record-edited",
      "adr-semantic-resolution-not-performed"
    ]
  },
  "exception_catalog": {
    "digest_algorithm": "sha256",
    "canonical_form": "utf8-rfc8785-jcs-of-entries-array-in-utf8-path-order",
    "ordering": "utf8-bytes-ascending-by-path",
    "catalog_digest_sha256": "4108278443fa79d39db7f0f4b0237b385d5a0116b28e474d2b3500add63c9e6d",
    "entries": [
      {
        "path": "ADR-014-release-verification-profiles.md",
        "sha256": "1d644d0221dab66332d24366f12aeaf454444db1876e0c38a58247d6639ea440",
        "disposition": "preserved-pre-v2-record",
        "reason": "Pre-v2 record preserved byte-for-byte. Superseded forward by ADR-REL-0001; never edited, never revalidated against the v2 record schema.",
        "legacy_record": {
          "reference": "ADR-014",
          "title": "Capability-based release verification profiles",
          "status": "accepted",
          "date": "2026-08-29",
          "source_format": "numeric-id-frontmatter",
          "supersedes": [],
          "affected_rules": [
            "law/policy/release-verification.json",
            "law/schemas/release-verification-profile.schema.json"
          ]
        }
      },
      {
        "path": "README.md",
        "sha256": "3b1943af6a3024e6bdb6e1c1ec67683707cf3caac66ada69a26f2419ad80671f",
        "disposition": "non-record",
        "reason": "Directory prose describing how adopters add their own records. It is not a decision record and carries no identity."
      }
    ],
    "digest_mismatch_behavior": "fail",
    "content_mismatch_behavior": "fail"
  },
  "fail_closed": [
    "missing-id",
    "malformed-id",
    "duplicate-id",
    "filename-id-mismatch",
    "unknown-status",
    "unparseable-frontmatter",
    "missing-frontmatter",
    "missing-required-section",
    "unmatched-markdown-file",
    "unreadable-file",
    "symlinked-record",
    "uncatalogued-exception",
    "catalog-entry-content-mismatch",
    "catalog-digest-mismatch",
    "legacy-catalog-metadata-invalid",
    "legacy-reference-allowlist-mismatch",
    "affected-rule-subject-invalid",
    "unresolved-supersedes-reference",
    "self-supersedes-reference",
    "superseded-record-edited",
    "adr-duplicate-id",
    "adr-unresolved-supersedes-reference",
    "adr-uncatalogued-legacy-reference",
    "adr-self-supersedes-reference",
    "adr-supersession-cycle",
    "adr-multiple-accepted-direct-successors",
    "adr-conflicting-supersession-branch",
    "adr-multiple-effective-accepted-heads",
    "adr-superseded-record-edited",
    "adr-legacy-catalog-metadata-invalid",
    "adr-legacy-reference-allowlist-mismatch",
    "adr-affected-rule-subject-invalid",
    "adr-semantic-resolution-not-performed"
  ]
}
