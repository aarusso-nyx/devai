{
  "schemaVersion": "1.0.0",
  "id": "trusted-local-rc-verifier-package",
  "status": "active",
  "authority": "Architect",
  "package": {
    "name": "@aarusso-nyx/devai",
    "version": "1.5.4",
    "registry": "https://npm.pkg.github.com",
    "tarball": "https://npm.pkg.github.com/download/@aarusso-nyx/devai/1.5.4/e5c34a17bc27b47cc1dba711561e4f9c6394cac8",
    "shasum_sha1": "e5c34a17bc27b47cc1dba711561e4f9c6394cac8",
    "integrity_sri": "sha512-neGgDPkoCiaex2f6GzSVrZsCIxaQhml6D0EC+bpHb2bgSDb4nm78Evx+Lo49VmH81gTwSI1WQFWb48PWj0/arQ==",
    "release_source": {
      "repository": "aarusso-nyx/devai",
      "commit": "8b600ed16ebd101ff88ecfaac9cc04abcf0ce174",
      "tree": "d2f60e0602ffc849e9b5b1b52ca54731eca7c8b1"
    }
  },
  "authentication": {
    "secret": "PACKAGES_READ_TOKEN",
    "scope": "materialization-step-only",
    "github_token_fallback": false
  },
  "workflow_permissions": {
    "contents": "read",
    "packages": "read",
    "checks": "write"
  },
  "materialization": {
    "root": "runner-temporary-storage",
    "package_lifecycle_scripts": false,
    "candidate_product_execution": false,
    "validate_before_extraction": [
      "package-name",
      "package-version",
      "tarball-url",
      "tarball-sha1",
      "tarball-sri",
      "release-source-commit",
      "release-source-tree"
    ],
    "reject_archive_entries": [
      "absolute-path",
      "path-traversal",
      "symlink",
      "hardlink",
      "special-file"
    ]
  },
  "verifier": {
    "root": "dist/runtime/evidence-verification",
    "provenance_sha256": "1035c8aad52f4b2beb6a6f010106a4d1866c92dadf3fbae1c6e36e1a4d2ceddf",
    "source_commit": "8174749ebcfabab246031281a036032f636b8a39",
    "payload_file_count": 26,
    "binaries": {
      "devai-evidence-policy": "./dist/runtime/evidence-verification/src/build-policy-cli.js",
      "devai-evidence-verify": "./dist/runtime/evidence-verification/src/cli.js",
      "devai-evidence-bundle-verify": "./dist/runtime/evidence-verification/src/bundle-cli.js",
      "devai-evidence-export": "./dist/runtime/evidence-verification/src/export-cli.js",
      "devai-evidence-publish": "./dist/runtime/evidence-verification/src/publish-cli.js"
    },
    "reject_population": [
      "missing-file",
      "extra-file",
      "symlink",
      "special-file",
      "digest-drift",
      "binary-map-drift"
    ]
  },
  "descriptor": {
    "description": "The selector kinds the pinned verifier's task-descriptor schema admits; the committed test-tasks.json uses no other kind, and the descriptor check refuses one outside this set (ADR-CHK-0006).",
    "selector_kinds": ["exact", "prefix", "glob"]
  },
  "repin": {
    "description": "How this pin moves (ADR-REL-0031, ADR-CHK-0006). The verifier this policy trusts is the one inside the published release that package.release_source names; a verifier change lands first in the canonical source, is then vendored into the in-repository copy with a rewritten provenance manifest, ships in a release verified by the still-pinned verifier, and only then is pinned here. The pin trails the vendored copy by one published release.",
    "rule": "trusted-verifier-trails-vendored-copy-by-one-published-release",
    "vendored_copy": {
      "root": "packages/cli/vendor/evidence-verification",
      "provenance_manifest": "packages/cli/vendor/evidence-verification/provenance.json",
      "made_only_from": "canonical-source-commit",
      "hand_edit": false
    },
    "order": [
      "canonical-verifier-source-change-with-tests",
      "vendored-copy-rewritten-with-new-provenance-and-in-repository-restatements",
      "release-published-under-current-pin",
      "law-repin-from-published-release"
    ],
    "moves_together": [
      "package.version",
      "package.tarball",
      "package.shasum_sha1",
      "package.integrity_sri",
      "package.release_source.commit",
      "package.release_source.tree",
      "verifier.source_commit",
      "verifier.provenance_sha256",
      "verifier.payload_file_count",
      "descriptor.selector_kinds"
    ],
    "verifier_values_read_from": "the published release's vendored provenance.json at package.release_source.commit",
    "partial_repin": false,
    "owner_effect": "re-declare the repository variable named by external_duplicate.name to the new verifier.provenance_sha256, recorded separately"
  },
  "external_duplicate": {
    "name": "DEVAI_LEDGER_VERIFIER_PROVENANCE_SHA256",
    "required": true,
    "sole_trust_root": false
  },
  "adopter_fallbacks": []
}
