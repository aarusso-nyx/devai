{
  "name": "@devai-nyx/skills",
  "version": "1.0.0",
  "description": "Private DEVAI recipe, operation, model-bridge, bootstrap, and post-merge services.",
  "license": "Apache-2.0",
  "author": "Antonio Augusto Russo <aarusso@nyxk.com.br>",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./post-merge-auditor": {
      "types": "./dist/post-merge-auditor/index.d.ts",
      "development": "./src/post-merge-auditor/index.ts",
      "default": "./dist/post-merge-auditor/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "resources"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/copy-constitution.mjs && node scripts/copy-policy.mjs",
    "clean": "tsc -b --clean",
    "test": "pnpm --dir ../.. run test:skills"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@devai-nyx/authority": "workspace:*",
    "@devai-nyx/loop": "workspace:*",
    "@devai-nyx/schemas": "workspace:*",
    "@devai-nyx/sensors": "workspace:*",
    "@devai-nyx/spec": "workspace:*",
    "@devai-nyx/utils": "workspace:*",
    "minimatch": "^9.0.0",
    "openai": "^4.65.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarusso-nyx/devai.git",
    "directory": "packages/skills"
  },
  "private": true
}
