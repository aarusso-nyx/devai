{
  "name": "devai",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "description": "DEVAI 1.2 developer-acceleration CLI for focused automation and trustworthy evidence.",
  "license": "Apache-2.0",
  "author": "Antonio Augusto Russo <aarusso@nyxk.com.br>",
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.16": "1.1.18",
      "brace-expansion@2.1.2": "2.1.4",
      "brace-expansion@5.0.8": "5.0.9",
      "fast-uri@3.1.4": "3.1.5",
      "js-yaml@4.3.0": "4.3.1",
      "nanoid@3.3.16": "3.3.18",
      "postcss@8.5.22": "8.5.23"
    }
  },
  "scripts": {
    "devai:prepare": "node scripts/check-test-task-workspace-selectors.mjs && node scripts/generate-action-registry.mjs",
    "test-task-selectors:check": "node scripts/check-test-task-workspace-selectors.mjs --check",
    "action-registry:check": "node scripts/generate-action-registry.mjs --check",
    "release:closure": "node scripts/check-publishable-closure.mjs",
    "authority:materialize": "node packages/cli/dist/runtime/index/bin.js init bind --target . --as-role architect --write --format json",
    "build": "pnpm run devai:prepare && pnpm -r build",
    "lint": "eslint --format=json .",
    "typecheck": "tsc -b packages/cli --force && tsc --noEmit -p tsconfig.json",
    "test": "pnpm run test:local",
    "test:local": "vitest run --config tests/config/local.config.ts",
    "test:t1": "pnpm run test:local",
    "test:authority": "vitest run --config tests/config/local.config.ts packages/authority/tests",
    "test:cli": "vitest run --config tests/config/local.config.ts packages/cli/tests",
    "test:effects": "vitest run --config tests/config/local.config.ts packages/effects-check/tests",
    "test:evidence": "vitest run --config tests/config/local.config.ts packages/evidence/tests",
    "test:loop": "vitest run --config tests/config/local.config.ts packages/loop/tests",
    "test:sensors": "vitest run --config tests/config/local.config.ts packages/sensors/tests",
    "test:schemas": "vitest run --config tests/config/local.config.ts packages/schemas/tests",
    "test:skills": "vitest run --config tests/config/local.config.ts packages/skills/tests",
    "test:spec": "vitest run --config tests/config/local.config.ts packages/spec/tests",
    "test:utils": "vitest run --config tests/config/local.config.ts packages/utils/tests",
    "test:root": "vitest run --config tests/config/local.config.ts tests/contract tests/integration",
    "test:coverage:rc": "vitest run --config tests/config/rc.coverage.config.ts",
    "test:db:rc": "vitest run --config tests/config/rc.db.config.ts",
    "test:e2e:rc": "vitest run --config tests/config/rc.e2e.config.ts",
    "test:performance:rc": "vitest run --config tests/config/rc.performance.config.ts",
    "test:containment:rc": "vitest run --config tests/config/rc.containment.config.ts"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "globals": "^17.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
