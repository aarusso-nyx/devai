ARG SOURCE_DATE_EPOCH=1787529600
COPY install-toolchain.mjs /opt/devai-build/install-toolchain.mjs
RUN node /opt/devai-build/install-toolchain.mjs
ENTRYPOINT []
CMD ["/usr/local/bin/node", "--version"]
