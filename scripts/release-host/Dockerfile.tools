FROM --platform=linux/arm64 docker.io/library/node@sha256:b38e82994ef7f534b41ac5084760354038376be3a7e1af65645beb9bacea49ea
# Reproducible export requires --output type=image,rewrite-timestamp=true,unpack=false.
